<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:FinanceApp.Mobile.ViewModels"
             xmlns:converters="clr-namespace:FinanceApp.Mobile.Converters"
             xmlns:controls="clr-namespace:FinanceApp.Mobile.Views.Controls"
             x:Class="FinanceApp.Mobile.Views.AddAccountPage"
             x:DataType="viewmodels:AddAccountViewModel"
             Shell.NavBarIsVisible="False"
             Title="{Binding Title}">

    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:InverseBoolConverter x:Key="InverseBoolConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid>
    <ScrollView>
        <VerticalStackLayout Spacing="14" Padding="20,16,20,28">
            <Label Text="{Binding Title}" Style="{StaticResource TitleLabelStyle}" />

            <Label Text="{Binding ErrorMessage}"
                   Style="{StaticResource ErrorLabelStyle}"
                   IsVisible="{Binding HasError}" />

            <!-- Name -->
            <VerticalStackLayout Spacing="6">
                <Label Text="Account Name" Style="{StaticResource FormLabelStyle}" />
                <Border Style="{StaticResource FieldBorderStyle}">
                    <Entry Text="{Binding Name}"
                           Placeholder="e.g., Main Wallet"
                           BackgroundColor="Transparent"
                           TextColor="{AppThemeBinding Light={StaticResource OnSurface}, Dark={StaticResource OnSurfaceDark}}"
                           HeightRequest="48" />
                </Border>
            </VerticalStackLayout>

            <!-- Type -->
            <VerticalStackLayout Spacing="6">
                <Label Text="Account Type" Style="{StaticResource FormLabelStyle}" />
                <controls:ModernSelect ItemsSource="{Binding AccountTypes}"
                                       SelectedItem="{Binding Type}"
                                       Placeholder="Select Type" />
            </VerticalStackLayout>

            <!-- Initial Balance -->
            <VerticalStackLayout Spacing="6">
                <Label Text="Initial Balance" Style="{StaticResource FormLabelStyle}" />
                <Border Style="{StaticResource FieldBorderStyle}">
                    <Entry Text="{Binding InitialBalanceText}"
                           Keyboard="Numeric"
                           Placeholder="0.00"
                           BackgroundColor="Transparent"
                           TextColor="{AppThemeBinding Light={StaticResource OnSurface}, Dark={StaticResource OnSurfaceDark}}"
                           HeightRequest="48"
                           HorizontalTextAlignment="End" />
                </Border>
            </VerticalStackLayout>

            <!-- Description -->
            <VerticalStackLayout Spacing="6">
                <Label Text="Description (Optional)" Style="{StaticResource FormLabelStyle}" />
                <Border Style="{StaticResource FieldBorderStyle}">
                    <Entry Text="{Binding Description}"
                           Placeholder="Description..."
                           BackgroundColor="Transparent"
                           TextColor="{AppThemeBinding Light={StaticResource OnSurface}, Dark={StaticResource OnSurfaceDark}}"
                           HeightRequest="48" />
                </Border>
            </VerticalStackLayout>

            <!-- Icon picker -->
            <VerticalStackLayout Spacing="6">
                <Label Text="Icon" Style="{StaticResource FormLabelStyle}" />
                <Border Style="{StaticResource FieldBorderStyle}" Padding="12">
                    <VerticalStackLayout Spacing="10">
                        <HorizontalStackLayout Spacing="12" VerticalOptions="Center">
                            <Border WidthRequest="52" HeightRequest="52"
                                    Background="{Binding Color, Converter={StaticResource ColorConverter}}"
                                    StrokeThickness="0"
                                    VerticalOptions="Center">
                                <Border.StrokeShape>
                                    <Ellipse />
                                </Border.StrokeShape>
                                <Label Text="{Binding Icon, TargetNullValue=&#x1F4B0;}" FontSize="26" VerticalOptions="Center" HorizontalOptions="Center" />
                            </Border>
                            <Label Text="Tap an icon below"
                                   Style="{StaticResource MutedLabelStyle}"
                                   VerticalOptions="Center"
                                   HorizontalOptions="Fill" />
                        </HorizontalStackLayout>
                        <FlexLayout x:Name="EmojiContainer"
                                    Direction="Row"
                                    Wrap="Wrap" />
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>

            <!-- Color picker -->
            <VerticalStackLayout Spacing="6">
                <Label Text="Color" Style="{StaticResource FormLabelStyle}" />
                <Border Style="{StaticResource FieldBorderStyle}" Padding="12">
                    <VerticalStackLayout Spacing="10">
                        <HorizontalStackLayout Spacing="12" VerticalOptions="Center">
                            <Border WidthRequest="40" HeightRequest="40"
                                    Background="{Binding Color, Converter={StaticResource ColorConverter}}"
                                    StrokeThickness="0"
                                    VerticalOptions="Center">
                                <Border.StrokeShape>
                                    <Ellipse />
                                </Border.StrokeShape>
                            </Border>
                            <Label Text="{Binding Color}"
                                   Style="{StaticResource MutedLabelStyle}"
                                   VerticalOptions="Center"
                                   HorizontalOptions="Fill" />
                        </HorizontalStackLayout>
                        <FlexLayout x:Name="ColorContainer"
                                    Direction="Row"
                                    Wrap="Wrap" />
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>

            <!-- Default Account -->
            <Border Style="{StaticResource CardFrameStyle}" Padding="16">
                <HorizontalStackLayout Spacing="12" VerticalOptions="Center">
                    <VerticalStackLayout Spacing="2" VerticalOptions="Center" HorizontalOptions="Fill">
                        <Label Text="Default Account" Style="{StaticResource FormLabelStyle}" />
                        <Label Text="Used as default for new transactions" Style="{StaticResource MutedLabelStyle}" />
                    </VerticalStackLayout>
                    <Switch IsToggled="{Binding IsDefault}"
                            OnColor="{StaticResource Primary}"
                            VerticalOptions="Center" />
                </HorizontalStackLayout>
            </Border>

            <!-- Save Button -->
            <Button Text="{Binding IsEditing, Converter={StaticResource BoolToStringConverter}, ConverterParameter='Update|Save'}"
                    Command="{Binding SaveCommand}"
                    IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}"
                    Style="{StaticResource PrimaryButtonStyle}"
                    TextColor="White"
                    Margin="0,8,0,0" />

            <!-- Cancel Button -->
            <Button Text="Cancel"
                    Command="{Binding CancelCommand}"
                    Style="{StaticResource OutlineButtonStyle}" />
        </VerticalStackLayout>
    </ScrollView>

        <!-- Toasts -->
        <controls:ToastHost />
    </Grid>

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Cancel" Command="{Binding CancelCommand}" Priority="0" />
    </ContentPage.ToolbarItems>
</ContentPage>
