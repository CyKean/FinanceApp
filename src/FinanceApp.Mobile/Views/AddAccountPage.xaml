<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:FinanceApp.Mobile.ViewModels"
             xmlns:converters="clr-namespace:FinanceApp.Mobile.Converters"
             xmlns:controls="clr-namespace:FinanceApp.Mobile.Views.Controls"
             x:Class="FinanceApp.Mobile.Views.AddAccountPage"
             x:DataType="viewmodels:AddAccountViewModel"
             Shell.NavBarIsVisible="False"
             Title="{Binding Title}">

    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:InverseBoolConverter x:Key="InverseBoolConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid>
    <ScrollView>
        <VerticalStackLayout Spacing="14" Padding="18,14,18,28">
            <!-- Header -->
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" VerticalOptions="Center">
                <Border WidthRequest="46" HeightRequest="46"
                        Background="{DynamicResource FinoraCard}"
                        Stroke="{DynamicResource FinoraInk}" StrokeThickness="1.5"
                        VerticalOptions="Center">
                    <Border.StrokeShape><Ellipse /></Border.StrokeShape>
                    <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding CancelCommand}" /></Border.GestureRecognizers>
                    <Label Text="←" FontSize="20" FontAttributes="Bold" TextColor="{DynamicResource FinoraInk}"
                           HorizontalOptions="Center" VerticalOptions="Center" />
                </Border>
                <VerticalStackLayout Grid.Column="1" Spacing="0" VerticalOptions="Center">
                    <Label Text="{Binding Title}" FontSize="18" FontAttributes="Bold" FontFamily="SpaceGroteskBold" TextColor="{DynamicResource FinoraInk}" />
                    <Label Text="Wallets, banks and cash" FontSize="12" TextColor="{DynamicResource FinoraMuted}" />
                </VerticalStackLayout>
                <controls:FinoraIconView Grid.Column="2" IconKey="bank" Size="46" VerticalOptions="Center" />
            </Grid>

            <Label Text="{Binding ErrorMessage}"
                   Style="{StaticResource ErrorLabelStyle}"
                   IsVisible="{Binding HasError}" />

            <!-- Name -->
            <VerticalStackLayout Spacing="6">
                <Label Text="Account Name" Style="{StaticResource FormLabelStyle}" />
                <Border Style="{StaticResource FieldBorderStyle}">
                    <Entry Text="{Binding Name}"
                           Placeholder="e.g., Main Wallet"
                           BackgroundColor="Transparent"
                           TextColor="{AppThemeBinding Light={DynamicResource OnSurface}, Dark={DynamicResource OnSurfaceDark}}"
                           HeightRequest="48" />
                </Border>
            </VerticalStackLayout>

            <!-- Type -->
            <VerticalStackLayout Spacing="6">
                <Label Text="Account Type" Style="{StaticResource FormLabelStyle}" />
                <controls:ModernSelect ItemsSource="{Binding AccountTypes}"
                                       SelectedItem="{Binding Type}"
                                       Placeholder="Select Type" />
            </VerticalStackLayout>

            <!-- Initial Balance -->
            <VerticalStackLayout Spacing="6">
                <Label Text="Initial Balance" Style="{StaticResource FormLabelStyle}" />
                <Border Style="{StaticResource FieldBorderStyle}">
                    <Entry Text="{Binding InitialBalanceText}"
                           Keyboard="Numeric"
                           Placeholder="0.00"
                           BackgroundColor="Transparent"
                           TextColor="{AppThemeBinding Light={DynamicResource OnSurface}, Dark={DynamicResource OnSurfaceDark}}"
                           HeightRequest="48"
                           HorizontalTextAlignment="End" />
                </Border>
            </VerticalStackLayout>

            <!-- Description -->
            <VerticalStackLayout Spacing="6">
                <Label Text="Description (Optional)" Style="{StaticResource FormLabelStyle}" />
                <Border Style="{StaticResource FieldBorderStyle}">
                    <Entry Text="{Binding Description}"
                           Placeholder="Description..."
                           BackgroundColor="Transparent"
                           TextColor="{AppThemeBinding Light={DynamicResource OnSurface}, Dark={DynamicResource OnSurfaceDark}}"
                           HeightRequest="48" />
                </Border>
            </VerticalStackLayout>

            <!-- Icon picker -->
            <VerticalStackLayout Spacing="6">
                <Label Text="Icon" Style="{StaticResource FormLabelStyle}" />
                <Border Style="{StaticResource CardFrameStyle}" Padding="16">
                    <VerticalStackLayout Spacing="10">
                        <HorizontalStackLayout Spacing="12" VerticalOptions="Center">
                            <controls:FinoraIconView Icon="{Binding Icon}" Name="{Binding Name}" Size="52" VerticalOptions="Center" />
                            <Label Text="Tap an icon below"
                                   Style="{StaticResource MutedLabelStyle}"
                                   VerticalOptions="Center"
                                   HorizontalOptions="Fill" />
                        </HorizontalStackLayout>
                        <FlexLayout x:Name="EmojiContainer"
                                    Direction="Row"
                                    Wrap="Wrap" />
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>

            <!-- Default Account -->
            <Border Style="{StaticResource CardFrameStyle}" Padding="16">
                <HorizontalStackLayout Spacing="12" VerticalOptions="Center">
                    <VerticalStackLayout Spacing="2" VerticalOptions="Center" HorizontalOptions="Fill">
                        <Label Text="Default Account" Style="{StaticResource FormLabelStyle}" />
                        <Label Text="Used as default for new transactions" Style="{StaticResource MutedLabelStyle}" />
                    </VerticalStackLayout>
                    <Switch IsToggled="{Binding IsDefault}"
                            OnColor="{DynamicResource Primary}"
                            VerticalOptions="Center" />
                </HorizontalStackLayout>
            </Border>

            <!-- Save Button -->
            <Button Text="{Binding IsEditing, Converter={StaticResource BoolToStringConverter}, ConverterParameter='Update|Save'}"
                    Command="{Binding SaveCommand}"
                    IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}"
                    Style="{StaticResource PrimaryButtonStyle}"
                    TextColor="White"
                    Margin="0,8,0,0" />

            <!-- Cancel Button -->
            <Button Text="Cancel"
                    Command="{Binding CancelCommand}"
                    Style="{StaticResource OutlineButtonStyle}" />
        </VerticalStackLayout>
    </ScrollView>

        <!-- Toasts -->
        <controls:ToastHost />

        <!-- Create / edit animation -->
        <controls:SuccessOverlayHost />
    </Grid>

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Cancel" Command="{Binding CancelCommand}" Priority="0" />
    </ContentPage.ToolbarItems>
</ContentPage>
