<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FinanceApp.Mobile.Views.Controls.ModernSelect"
             x:Name="Root">
    <VerticalStackLayout Spacing="0" VerticalOptions="Start">
        <!-- Closed field -->
        <Border Style="{StaticResource FieldBorderStyle}" HeightRequest="52">
            <Border.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnFieldTapped" />
            </Border.GestureRecognizers>
            <Grid ColumnDefinitions="*,Auto"
                  ColumnSpacing="10"
                  Padding="2,0"
                  VerticalOptions="Center">
                <Label x:Name="DisplayLabel"
                       FontSize="15"
                       LineBreakMode="TailTruncation"
                       VerticalOptions="Center" />
                <Label x:Name="ChevronLabel"
                       Grid.Column="1"
                       Text="⌄"
                       FontSize="18"
                       VerticalOptions="Center"
                       TextColor="{AppThemeBinding Light={StaticResource OnSurfaceVariant}, Dark={StaticResource OnSurfaceVariantDark}}" />
            </Grid>
        </Border>

        <!-- Expanded options -->
        <Border x:Name="DropBorder"
                IsVisible="False"
                Style="{StaticResource CardFrameStyle}"
                Padding="6"
                Margin="0,6,0,0">
            <ScrollView MaximumHeightRequest="280">
                <VerticalStackLayout x:Name="OptionsContainer" Spacing="2" />
            </ScrollView>
        </Border>
    </VerticalStackLayout>
</ContentView>
