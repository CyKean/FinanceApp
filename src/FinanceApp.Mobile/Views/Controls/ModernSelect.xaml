<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FinanceApp.Mobile.Views.Controls.ModernSelect"
             x:Name="Root">
    <VerticalStackLayout Spacing="0" VerticalOptions="Start">
        <!-- Closed field -->
        <Border x:Name="FieldBorder" Style="{StaticResource FieldBorderStyle}" HeightRequest="52">
            <Border.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnFieldTapped" />
            </Border.GestureRecognizers>
            <Grid ColumnDefinitions="Auto,*,Auto"
                  ColumnSpacing="10"
                  Padding="14,0"
                  VerticalOptions="Center">
                <Border x:Name="FieldBadge" WidthRequest="30" HeightRequest="30"
                        Background="{StaticResource FinoraInk}"
                        StrokeThickness="0" VerticalOptions="Center">
                    <Border.StrokeShape><Ellipse /></Border.StrokeShape>
                    <Path x:Name="FieldBadgeGlyph"
                          Aspect="Uniform"
                          WidthRequest="17" HeightRequest="17"
                          Stroke="{StaticResource FinoraWhite}" StrokeThickness="1.9"
                          StrokeLineCap="Round" StrokeLineJoin="Round" Fill="Transparent"
                          HorizontalOptions="Center" VerticalOptions="Center" />
                </Border>
                <Label x:Name="DisplayLabel"
                       Grid.Column="1"
                       FontSize="15"
                       LineBreakMode="TailTruncation"
                       VerticalOptions="Center" />
                <Path x:Name="ChevronPath" Grid.Column="2"
                      Aspect="Uniform" WidthRequest="16" HeightRequest="16"
                      Data="M 5 8 L 11 14 L 17 8"
                      Stroke="{StaticResource FinoraInk}" StrokeThickness="2"
                      StrokeLineCap="Round" StrokeLineJoin="Round"
                      Fill="Transparent" VerticalOptions="Center" />
            </Grid>
        </Border>

        <!-- Expanded options -->
        <Border x:Name="DropBorder"
                IsVisible="False"
                Background="{StaticResource FinoraCard}"
                Stroke="{StaticResource FinoraInk}"
                StrokeThickness="1.5"
                Padding="6"
                Margin="0,6,0,0">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="22" />
            </Border.StrokeShape>
            <ScrollView MaximumHeightRequest="240">
                <VerticalStackLayout x:Name="OptionsContainer" Spacing="2" />
            </ScrollView>
        </Border>
    </VerticalStackLayout>
</ContentView>
