<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FinanceApp.Mobile.Views.Controls.ToastHost"
             x:Name="Root"
             IsVisible="False"
             InputTransparent="True"
             VerticalOptions="Fill"
             HorizontalOptions="Fill">
    <Grid x:Name="ToastRow"
          VerticalOptions="End"
          HorizontalOptions="Center"
          Margin="24,0,24,104"
          InputTransparent="True">
        <Border x:Name="Card"
                Background="{StaticResource PayCard}"
                Stroke="{StaticResource PayInk}"
                StrokeThickness="1.5"
                Padding="14,12">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="20" />
            </Border.StrokeShape>
            <Border.Shadow>
                <Shadow Brush="#161B16" Opacity="0.22" Radius="18" Offset="0,8" />
            </Border.Shadow>
            <HorizontalStackLayout Spacing="12" VerticalOptions="Center">
                <Border x:Name="IconBadge"
                        WidthRequest="34"
                        HeightRequest="34"
                        StrokeThickness="0"
                        VerticalOptions="Center">
                    <Border.StrokeShape>
                        <Ellipse />
                    </Border.StrokeShape>
                    <Path x:Name="Glyph"
                          Aspect="Uniform"
                          WidthRequest="18" HeightRequest="18"
                          StrokeThickness="2"
                          StrokeLineCap="Round" StrokeLineJoin="Round"
                          Fill="Transparent"
                          HorizontalOptions="Center" VerticalOptions="Center" />
                </Border>
                <Label x:Name="MessageLabel"
                       FontSize="14"
                       FontAttributes="Bold"
                       TextColor="{StaticResource PayInk}"
                       VerticalOptions="Center"
                       LineBreakMode="WordWrap"
                       MaxLines="3" />
            </HorizontalStackLayout>
        </Border>
    </Grid>
</ContentView>
