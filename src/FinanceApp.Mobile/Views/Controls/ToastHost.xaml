<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FinanceApp.Mobile.Views.Controls.ToastHost"
             x:Name="Root"
             IsVisible="False"
             InputTransparent="True"
             VerticalOptions="Fill"
             HorizontalOptions="Fill">
    <Grid VerticalOptions="End" HorizontalOptions="Center" Margin="24,0,24,96" InputTransparent="True">
        <Border Background="White"
                StrokeThickness="0"
                Padding="14,12">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="18" />
            </Border.StrokeShape>
            <Border.Shadow>
                <Shadow Brush="Black" Opacity="0.22" Radius="16" Offset="0,8" />
            </Border.Shadow>
            <HorizontalStackLayout Spacing="12" VerticalOptions="Center">
                <Border x:Name="IconBadge"
                        WidthRequest="36"
                        HeightRequest="36"
                        StrokeThickness="0"
                        VerticalOptions="Center">
                    <Border.StrokeShape>
                        <Ellipse />
                    </Border.StrokeShape>
                    <Label x:Name="IconLabel"
                           Text="✓"
                           FontSize="17"
                           FontAttributes="Bold"
                           TextColor="White"
                           HorizontalOptions="Center"
                           VerticalOptions="Center" />
                </Border>
                <Label x:Name="MessageLabel"
                       FontSize="14"
                       FontAttributes="Bold"
                       TextColor="#0F1F18"
                       VerticalOptions="Center"
                       LineBreakMode="WordWrap"
                       MaxLines="3" />
            </HorizontalStackLayout>
        </Border>
    </Grid>
</ContentView>
