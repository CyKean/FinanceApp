<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FinanceApp.Mobile.Views.Controls.FinoraIconView"
             x:Name="Root">
    <Border x:Name="Badge"
            StrokeThickness="0"
            Padding="0">
        <Border.StrokeShape>
            <Ellipse />
        </Border.StrokeShape>
        <Path x:Name="Glyph"
              Aspect="Uniform"
              StrokeThickness="1.8"
              StrokeLineCap="Round"
              StrokeLineJoin="Round"
              Fill="Transparent"
              HorizontalOptions="Center"
              VerticalOptions="Center" />
    </Border>
</ContentView>
