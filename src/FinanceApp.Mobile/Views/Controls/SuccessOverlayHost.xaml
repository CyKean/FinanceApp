<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FinanceApp.Mobile.Views.Controls.SuccessOverlayHost"
             x:Name="Root"
             IsVisible="False"
             VerticalOptions="Fill"
             HorizontalOptions="Fill">
    <Grid>
        <Grid x:Name="Scrim" BackgroundColor="#8C000000" Opacity="0" />

        <Border x:Name="Card"
                Background="{StaticResource FinoraCard}"
                Stroke="{StaticResource FinoraInk}"
                StrokeThickness="1.5"
                Padding="26,26,26,22"
                WidthRequest="244"
                VerticalOptions="Center"
                HorizontalOptions="Center"
                Opacity="0">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="28" />
            </Border.StrokeShape>
            <Border.Shadow>
                <Shadow Brush="#161B16" Opacity="0.30" Radius="28" Offset="0,12" />
            </Border.Shadow>
            <VerticalStackLayout Spacing="0">
                <Border x:Name="Badge"
                        WidthRequest="84"
                        HeightRequest="84"
                        StrokeThickness="0"
                        HorizontalOptions="Center"
                        Margin="0,0,0,16"
                        Opacity="0">
                    <Border.StrokeShape>
                        <Ellipse />
                    </Border.StrokeShape>
                    <Path x:Name="Glyph"
                          Aspect="Uniform"
                          WidthRequest="42" HeightRequest="42"
                          StrokeThickness="2.4"
                          StrokeLineCap="Round" StrokeLineJoin="Round"
                          Fill="Transparent"
                          HorizontalOptions="Center" VerticalOptions="Center"
                          Opacity="0" />
                </Border>

                <Label x:Name="MessageLabel"
                       FontSize="17"
                       FontAttributes="Bold"
                       HorizontalTextAlignment="Center"
                       LineBreakMode="WordWrap"
                       Opacity="0"
                       TextColor="{StaticResource FinoraInk}" />
            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentView>
