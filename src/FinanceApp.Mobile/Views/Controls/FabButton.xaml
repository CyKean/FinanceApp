<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FinanceApp.Mobile.Views.Controls.FabButton"
             x:Name="Root">
    <Border HeightRequest="62"
            WidthRequest="62"
            Background="{StaticResource Primary}"
            StrokeThickness="0"
            VerticalOptions="End"
            HorizontalOptions="End">
        <Border.StrokeShape>
            <Ellipse />
        </Border.StrokeShape>
        <Border.Shadow>
            <Shadow Brush="Black" Opacity="0.25" Radius="12" Offset="0,6" />
        </Border.Shadow>
        <Border.GestureRecognizers>
            <TapGestureRecognizer Command="{Binding Command, Source={x:Reference Root}}"
                                  CommandParameter="{Binding CommandParameter, Source={x:Reference Root}}" />
        </Border.GestureRecognizers>
        <Label Text="{Binding Text, Source={x:Reference Root}}"
               FontSize="32"
               TextColor="White"
               HorizontalOptions="Center"
               VerticalOptions="Center"
               Margin="0,-4,0,0" />
    </Border>
</ContentView>
