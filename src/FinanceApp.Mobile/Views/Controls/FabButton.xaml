<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FinanceApp.Mobile.Views.Controls.FabButton"
             x:Name="Root">
    <Border x:Name="FabBorder"
            HeightRequest="64"
            WidthRequest="64"
            Stroke="{DynamicResource FinoraInk}"
            StrokeThickness="1.5"
            Background="{DynamicResource FinoraInk}"
            VerticalOptions="End"
            HorizontalOptions="End">
        <Border.StrokeShape>
            <Ellipse />
        </Border.StrokeShape>
        <Border.Shadow>
            <Shadow Brush="Black" Opacity="0.35" Radius="20" Offset="0,10" />
        </Border.Shadow>
        <Border.GestureRecognizers>
            <TapGestureRecognizer Tapped="OnTapped"
                                  Command="{Binding Command, Source={x:Reference Root}}"
                                  CommandParameter="{Binding CommandParameter, Source={x:Reference Root}}" />
        </Border.GestureRecognizers>
        <Label Text="{Binding Text, Source={x:Reference Root}}"
               FontSize="32"
               FontFamily="SpaceGroteskBold"
               TextColor="{DynamicResource FinoraLime}"
               HorizontalOptions="Center"
               VerticalOptions="Center"
               Margin="0,-3,0,0" />
    </Border>
</ContentView>
