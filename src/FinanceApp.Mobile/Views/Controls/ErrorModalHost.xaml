<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FinanceApp.Mobile.Views.Controls.ErrorModalHost"
             x:Name="Root"
             IsVisible="False"
             VerticalOptions="Fill"
             HorizontalOptions="Fill">
    <Grid>
        <Grid x:Name="Scrim" BackgroundColor="#8C000000" Opacity="0">
            <Grid.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnCancelTapped" />
            </Grid.GestureRecognizers>
        </Grid>

        <Border x:Name="Card"
                Background="{DynamicResource FinoraCard}"
                Stroke="{DynamicResource FinoraInk}"
                StrokeThickness="1.5"
                Padding="24,24,24,20"
                WidthRequest="316"
                VerticalOptions="Center"
                HorizontalOptions="Center"
                Opacity="0">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="28" />
            </Border.StrokeShape>
            <Border.Shadow>
                <Shadow Brush="{DynamicResource FinoraInk}" Opacity="0.30" Radius="28" Offset="0,12" />
            </Border.Shadow>
            <VerticalStackLayout Spacing="0">
                <Border x:Name="IconBadge"
                        WidthRequest="62"
                        HeightRequest="62"
                        StrokeThickness="0"
                        HorizontalOptions="Center"
                        Margin="0,0,0,16">
                    <Border.StrokeShape>
                        <Ellipse />
                    </Border.StrokeShape>
                    <Path x:Name="Glyph"
                          Aspect="Uniform"
                          WidthRequest="30" HeightRequest="30"
                          StrokeThickness="2.2"
                          StrokeLineCap="Round" StrokeLineJoin="Round"
                          Fill="Transparent"
                          HorizontalOptions="Center" VerticalOptions="Center" />
                </Border>

                <Label x:Name="TitleLabel"
                       FontSize="19"
                       FontAttributes="Bold"
                       HorizontalTextAlignment="Center"
                       TextColor="{DynamicResource FinoraInk}" />

                <Label x:Name="MessageLabel"
                       FontSize="14"
                       HorizontalTextAlignment="Center"
                       LineBreakMode="WordWrap"
                       Margin="0,8,0,0"
                       TextColor="{DynamicResource FinoraMuted}" />

                <Button x:Name="OkButton"
                        Style="{StaticResource PrimaryButtonStyle}"
                        TextColor="{DynamicResource FinoraLime}"
                        HeightRequest="48"
                        Margin="0,22,0,0"
                        Text="OK"
                        Clicked="OnCancelTapped" />
            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentView>