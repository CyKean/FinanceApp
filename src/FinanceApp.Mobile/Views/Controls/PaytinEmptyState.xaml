<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:FinanceApp.Mobile.Views.Controls"
             x:Class="FinanceApp.Mobile.Views.Controls.PaytinEmptyState"
             x:Name="Root">
    <VerticalStackLayout Spacing="8"
                        Padding="20,18"
                        HorizontalOptions="Center"
                        VerticalOptions="Center">
        <controls:PaytinIconView IconKey="{Binding IconKey, Source={x:Reference Root}}"
                                Size="56"
                                HorizontalOptions="Center" />
        <Label Text="{Binding Title, Source={x:Reference Root}}"
               FontSize="15"
               FontAttributes="Bold"
               TextColor="{StaticResource PayInk}"
               HorizontalOptions="Center"
               HorizontalTextAlignment="Center" />
        <Label Text="{Binding Subtitle, Source={x:Reference Root}}"
               FontSize="12"
               TextColor="#6F7668"
               HorizontalOptions="Center"
               HorizontalTextAlignment="Center" />
    </VerticalStackLayout>
</ContentView>
