<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FinanceApp.Mobile.Views.Controls.ChoiceSheetHost"
             x:Name="Root"
             IsVisible="False"
             VerticalOptions="Fill"
             HorizontalOptions="Fill">
    <Grid>
        <Grid x:Name="Scrim" BackgroundColor="#A6000000" Opacity="0">
            <Grid.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnCancelTapped" />
            </Grid.GestureRecognizers>
        </Grid>

        <Border x:Name="Card"
                Background="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource SurfaceDark}}"
                Stroke="{AppThemeBinding Light={StaticResource OutlineVariant}, Dark={StaticResource OutlineVariantDark}}"
                StrokeThickness="1"
                Padding="20,18"
                WidthRequest="320"
                VerticalOptions="Center"
                HorizontalOptions="Center"
                Opacity="0">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="24" />
            </Border.StrokeShape>
            <Border.Shadow>
                <Shadow Brush="Black" Opacity="0.28" Radius="24" Offset="0,10" />
            </Border.Shadow>
            <VerticalStackLayout Spacing="14">
                <Label x:Name="TitleLabel"
                       Text="Add Transaction"
                       Style="{StaticResource TitleLabelStyle}"
                       HorizontalTextAlignment="Center" />
                <VerticalStackLayout x:Name="OptionsContainer" Spacing="10" />
                <Button x:Name="CancelButton"
                        Text="Cancel"
                        Style="{StaticResource OutlineButtonStyle}"
                        Clicked="OnCancelTapped" />
            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentView>
