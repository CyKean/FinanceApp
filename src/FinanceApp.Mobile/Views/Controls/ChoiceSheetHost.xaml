<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FinanceApp.Mobile.Views.Controls.ChoiceSheetHost"
             x:Name="Root"
             IsVisible="False"
             VerticalOptions="Fill"
             HorizontalOptions="Fill">
    <Grid>
        <Grid x:Name="Scrim" BackgroundColor="#8C000000" Opacity="0">
            <Grid.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnCancelTapped" />
            </Grid.GestureRecognizers>
        </Grid>

        <Border x:Name="Card"
                Background="{StaticResource PayCard}"
                Stroke="{StaticResource PayInk}"
                StrokeThickness="1.5"
                Padding="20,18,20,30"
                VerticalOptions="End"
                Opacity="0">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="30,30,0,0" />
            </Border.StrokeShape>
            <Border.Shadow>
                <Shadow Brush="#161B16" Opacity="0.30" Radius="24" Offset="0,-6" />
            </Border.Shadow>
            <VerticalStackLayout Spacing="14">
                <VerticalStackLayout Spacing="4">
                    <Label x:Name="TitleLabel"
                           Text="Add Transaction"
                           FontSize="18"
                           FontAttributes="Bold"
                           HorizontalTextAlignment="Center"
                           TextColor="{StaticResource PayInk}" />
                    <Label x:Name="SubtitleLabel"
                           Text="Select an option"
                           FontSize="13"
                           HorizontalTextAlignment="Center"
                           TextColor="{StaticResource PayMuted}" />
                </VerticalStackLayout>
                <VerticalStackLayout x:Name="OptionsContainer" Spacing="8" />
                <Button x:Name="CancelButton"
                        Text="Cancel"
                        Style="{StaticResource TextButtonStyle}"
                        HeightRequest="48"
                        Clicked="OnCancelTapped" />
            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentView>
