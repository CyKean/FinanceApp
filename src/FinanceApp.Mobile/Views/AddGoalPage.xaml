<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:FinanceApp.Mobile.ViewModels"
             xmlns:converters="clr-namespace:FinanceApp.Mobile.Converters"
             xmlns:sys="clr-namespace:System;assembly=netstandard"
             x:Class="FinanceApp.Mobile.Views.AddGoalPage"
             x:DataType="viewmodels:AddGoalViewModel"
             Title="{Binding Title}">

    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:MoneyToStringConverter x:Key="MoneyConverter" />
            <converters:ColorConverter x:Key="ColorConverter" />
            <converters:InverseBoolConverter x:Key="InverseBoolConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Spacing="16" Padding="16">
            <!-- Name -->
            <Border Style="{StaticResource CardFrameStyle}" Padding="16">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Goal Name" Style="{StaticResource FormLabelStyle}" />
                    <Entry Text="{Binding Name}" Placeholder="e.g., Emergency Fund" Style="{StaticResource EntryStyle}" />
                </VerticalStackLayout>
            </Border>

            <!-- Target Amount -->
            <Border Style="{StaticResource CardFrameStyle}" Padding="16">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Target Amount" Style="{StaticResource FormLabelStyle}" />
                    <Entry Text="{Binding TargetAmount.Amount, StringFormat='{0:N2}'}" 
                           Keyboard="Numeric" 
                           Placeholder="0.00"
                           Style="{StaticResource AmountEntryStyle}"
                           HorizontalTextAlignment="End" />
                </VerticalStackLayout>
            </Border>

            <!-- Target Date -->
            <Border Style="{StaticResource CardFrameStyle}" Padding="16">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Target Date" Style="{StaticResource FormLabelStyle}" />
                    <DatePicker Date="{Binding TargetDate}" 
                                Format="MMM dd, yyyy"
                                MinimumDate="{Binding Source={x:Static sys:DateTime.Today}, Path=Today.AddDays(1)}"
                                Style="{StaticResource DatePickerStyle}" />
                </VerticalStackLayout>
            </Border>

            <!-- Start Date -->
            <Border Style="{StaticResource CardFrameStyle}" Padding="16">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Start Date" Style="{StaticResource FormLabelStyle}" />
                    <DatePicker Date="{Binding StartDate}" 
                                Format="MMM dd, yyyy"
                                Style="{StaticResource DatePickerStyle}" />
                </VerticalStackLayout>
            </Border>

            <!-- Description -->
            <Border Style="{StaticResource CardFrameStyle}" Padding="16">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Description (Optional)" Style="{StaticResource FormLabelStyle}" />
                    <Editor Text="{Binding Description}" 
                            HeightRequest="80"
                            Placeholder="Describe your goal..."
                            Style="{StaticResource EditorStyle}" />
                </VerticalStackLayout>
            </Border>

            <!-- Icon -->
            <Border Style="{StaticResource CardFrameStyle}" Padding="16">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Icon (Emoji)" Style="{StaticResource FormLabelStyle}" />
                    <Entry Text="{Binding Icon}" Placeholder="🎯" Style="{StaticResource EntryStyle}" MaxLength="2" />
                </VerticalStackLayout>
            </Border>

            <!-- Color -->
            <Border Style="{StaticResource CardFrameStyle}" Padding="16">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Color (Hex)" Style="{StaticResource FormLabelStyle}" />
                    <Entry Text="{Binding Color}" Placeholder="#512BD4" Style="{StaticResource EntryStyle}" MaxLength="7" />
                </VerticalStackLayout>
            </Border>

            <!-- Linked Account -->
            <Border Style="{StaticResource CardFrameStyle}" Padding="16">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Linked Account (Optional)" Style="{StaticResource FormLabelStyle}" />
                    <Picker Title="Select Account" 
                            ItemsSource="{Binding Accounts}" 
                            ItemDisplayBinding="{Binding Name}"
                            SelectedItem="{Binding LinkedAccount}"
                            Style="{StaticResource PickerStyle}" />
                </VerticalStackLayout>
            </Border>

            <!-- Save Button -->
            <Button Text="{Binding IsEditing, Converter={StaticResource BoolToStringConverter}, ConverterParameter='Update|Create'}" 
                    Command="{Binding SaveCommand}"
                    IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Margin="16,24,16,16" />
        </VerticalStackLayout>
    </ScrollView>

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Cancel" Command="{Binding CancelCommand}" Priority="0" />
    </ContentPage.ToolbarItems>
</ContentPage>