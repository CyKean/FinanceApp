<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:FinanceApp.Mobile.ViewModels"
             xmlns:converters="clr-namespace:FinanceApp.Mobile.Converters"
             xmlns:controls="clr-namespace:FinanceApp.Mobile.Views.Controls"
             x:Class="FinanceApp.Mobile.Views.AddGoalPage"
             x:DataType="viewmodels:AddGoalViewModel"
             Shell.NavBarIsVisible="False"
             Title="{Binding Title}">

    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:InverseBoolConverter x:Key="InverseBoolConverter" />
            <converters:ColorConverter x:Key="ColorConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid>
        <ScrollView>
            <VerticalStackLayout Spacing="14" Padding="18,14,18,28">
            <!-- Header -->
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" VerticalOptions="Center">
                <Border WidthRequest="46" HeightRequest="46"
                        Background="{StaticResource FinoraCard}"
                        Stroke="{StaticResource FinoraInk}" StrokeThickness="1.5"
                        VerticalOptions="Center">
                    <Border.StrokeShape><Ellipse /></Border.StrokeShape>
                    <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding CancelCommand}" /></Border.GestureRecognizers>
                    <Label Text="←" FontSize="20" FontAttributes="Bold" TextColor="{StaticResource FinoraInk}"
                           HorizontalOptions="Center" VerticalOptions="Center" />
                </Border>
                <VerticalStackLayout Grid.Column="1" Spacing="0" VerticalOptions="Center">
                    <Label Text="{Binding Title}" FontSize="18" FontAttributes="Bold" FontFamily="SpaceGroteskBold" TextColor="{StaticResource FinoraInk}" />
                    <Label Text="Save toward something big" FontSize="12" TextColor="#6F7668" />
                </VerticalStackLayout>
                <controls:FinoraIconView Grid.Column="2" IconKey="target" Size="46" VerticalOptions="Center" />
            </Grid>

                <Label Text="{Binding ErrorMessage}"
                       Style="{StaticResource ErrorLabelStyle}"
                       IsVisible="{Binding HasError}" />

                <!-- Goal Name -->
                <VerticalStackLayout Spacing="6">
                    <Label Text="Goal Name" Style="{StaticResource FormLabelStyle}" />
                    <Border Style="{StaticResource FieldBorderStyle}">
                        <Entry Text="{Binding Name}"
                               Placeholder="e.g., Emergency Fund"
                               BackgroundColor="Transparent"
                               TextColor="{AppThemeBinding Light={StaticResource OnSurface}, Dark={StaticResource OnSurfaceDark}}"
                               HeightRequest="48" />
                    </Border>
                </VerticalStackLayout>

                <!-- Target Amount -->
                <VerticalStackLayout Spacing="6">
                    <Label Text="Target Amount" Style="{StaticResource FormLabelStyle}" />
                    <Border Style="{StaticResource FieldBorderStyle}">
                        <Entry Text="{Binding AmountText}"
                               Keyboard="Numeric"
                               Placeholder="0.00"
                               BackgroundColor="Transparent"
                               TextColor="{AppThemeBinding Light={StaticResource OnSurface}, Dark={StaticResource OnSurfaceDark}}"
                               HeightRequest="48"
                               HorizontalTextAlignment="End" />
                    </Border>
                </VerticalStackLayout>

                <!-- Dates -->
                <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Target Date" Style="{StaticResource FormLabelStyle}" />
                        <Border Style="{StaticResource FieldBorderStyle}" Padding="12,0">
                            <DatePicker Date="{Binding TargetDate}"
                                        Format="MMM dd, yyyy"
                                        HeightRequest="48" />
                        </Border>
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Column="1" Spacing="6">
                        <Label Text="Start Date" Style="{StaticResource FormLabelStyle}" />
                        <Border Style="{StaticResource FieldBorderStyle}" Padding="12,0">
                            <DatePicker Date="{Binding StartDate}"
                                        Format="MMM dd, yyyy"
                                        HeightRequest="48" />
                        </Border>
                    </VerticalStackLayout>
                </Grid>

                <!-- Description -->
                <VerticalStackLayout Spacing="6">
                    <Label Text="Description (Optional)" Style="{StaticResource FormLabelStyle}" />
                    <Border Style="{StaticResource CardFrameStyle}" Padding="16">
                        <Editor Text="{Binding Description}"
                                BackgroundColor="Transparent"
                                TextColor="{AppThemeBinding Light={StaticResource OnSurface}, Dark={StaticResource OnSurfaceDark}}"
                                Placeholder="Describe your goal..."
                                HeightRequest="88" />
                    </Border>
                </VerticalStackLayout>

                <!-- Icon picker -->
                <VerticalStackLayout Spacing="6">
                    <Label Text="Icon" Style="{StaticResource FormLabelStyle}" />
                    <Border Style="{StaticResource CardFrameStyle}" Padding="16">
                        <VerticalStackLayout Spacing="10">
                            <HorizontalStackLayout Spacing="12" VerticalOptions="Center">
                                <controls:FinoraIconView Icon="{Binding Icon}" Name="{Binding Name}" Size="52" VerticalOptions="Center" />
                                <Label Text="Tap an icon below"
                                       Style="{StaticResource MutedLabelStyle}"
                                       VerticalOptions="Center"
                                       HorizontalOptions="Fill" />
                            </HorizontalStackLayout>
                            <FlexLayout x:Name="EmojiContainer"
                                        Direction="Row"
                                        Wrap="Wrap" />
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <!-- Linked Account (Optional) -->
                <VerticalStackLayout Spacing="6">
                    <Label Text="Account (Optional)" Style="{StaticResource FormLabelStyle}" />
                    <controls:ModernSelect ItemsSource="{Binding Accounts}"
                                           SelectedItem="{Binding LinkedAccount}"
                                           Placeholder="All accounts"
                                           DisplayMemberPath="Name"
                                           IconMemberPath="Icon"
                                           ColorMemberPath="Color" />
                </VerticalStackLayout>

                <!-- Save Button -->
                <Button Text="{Binding IsEditing, Converter={StaticResource BoolToStringConverter}, ConverterParameter='Update|Create'}"
                        Command="{Binding SaveCommand}"
                        IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}"
                        Style="{StaticResource PrimaryButtonStyle}"
                        TextColor="White"
                        Margin="0,8,0,0" />

                <!-- Cancel Button -->
                <Button Text="Cancel"
                        Command="{Binding CancelCommand}"
                        Style="{StaticResource OutlineButtonStyle}" />
            </VerticalStackLayout>
        </ScrollView>

        <!-- Toasts -->
        <controls:ToastHost />

        <!-- Success animation -->
        <controls:SuccessOverlayHost />
    </Grid>
</ContentPage>
