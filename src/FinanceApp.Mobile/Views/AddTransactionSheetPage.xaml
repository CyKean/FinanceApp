<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:FinanceApp.Mobile.ViewModels"
             xmlns:converters="clr-namespace:FinanceApp.Mobile.Converters"
             xmlns:controls="clr-namespace:FinanceApp.Mobile.Views.Controls"
             x:Class="FinanceApp.Mobile.Views.AddTransactionSheetPage"
             x:DataType="viewmodels:AddTransactionViewModel"
             Title="{Binding Title}"
             Shell.NavBarIsVisible="False"
             BackgroundColor="Transparent">

    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:InverseBoolConverter x:Key="InverseBoolConverter" />
            <converters:TransactionTypeToPayColorConverter x:Key="TypeAccent" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid RowDefinitions="*,Auto" BackgroundColor="Transparent">

        <!-- Scrim: tap to cancel -->
        <Border x:Name="Scrim" Grid.Row="0" Grid.RowSpan="2"
                BackgroundColor="#99000000" Opacity="0" InputTransparent="False">
            <Border.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding CancelCommand}" />
            </Border.GestureRecognizers>
        </Border>

        <!-- Bottom sheet: TranslationY is the animation offset, set in code-behind -->
        <Border x:Name="Sheet" Grid.Row="1" TranslationY="900"
                Background="{StaticResource FinoraCard}"
                Stroke="{StaticResource FinoraInk}" StrokeThickness="1.5"
                Padding="18,10,18,20">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="30,30,0,0" />
            </Border.StrokeShape>
            <Border.Shadow>
                <Shadow Brush="#161B16" Opacity="0.30" Radius="24" Offset="0,-6" />
            </Border.Shadow>

            <ScrollView MaximumHeightRequest="600">
                <VerticalStackLayout Spacing="12">

                    <!-- Drag handle -->
                    <Border WidthRequest="44" HeightRequest="5" Background="#C8CDB4" StrokeThickness="0"
                            HorizontalOptions="Center">
                        <Border.StrokeShape><RoundRectangle CornerRadius="100" /></Border.StrokeShape>
                    </Border>

                    <!-- Header: title + close -->
                    <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                        <VerticalStackLayout Spacing="0" VerticalOptions="Center">
                            <Label Text="{Binding Title}" FontSize="20" FontAttributes="Bold"
                                   FontFamily="SpaceGroteskBold" TextColor="{StaticResource FinoraInk}" />
                            <Label Text="Log money moving in or out" FontSize="12" TextColor="{StaticResource FinoraMuted}" />
                        </VerticalStackLayout>
                        <Border Grid.Column="1" WidthRequest="40" HeightRequest="40"
                                Background="Transparent" Stroke="{StaticResource FinoraInk}" StrokeThickness="1.5">
                            <Border.StrokeShape><Ellipse /></Border.StrokeShape>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding CancelCommand}" />
                            </Border.GestureRecognizers>
                            <Label Text="✕" FontSize="14" FontAttributes="Bold" TextColor="{StaticResource FinoraInk}"
                                   HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                    </Grid>

                    <!-- Mode banner: lime for income, ink for expense (mirrors the dashboard cards) -->
                    <Border Padding="16,12"
                            Background="{Binding TransactionType, Converter={StaticResource TypeAccent}}"
                            Stroke="{StaticResource FinoraInk}" StrokeThickness="1.5">
                        <Border.StrokeShape><RoundRectangle CornerRadius="22" /></Border.StrokeShape>
<Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                            <Border WidthRequest="10" HeightRequest="10" VerticalOptions="Center"
                                    Background="{Binding TransactionType, Converter={StaticResource TypeAccent}, ConverterParameter=onAccent}}"
                                    StrokeThickness="0">
                                <Border.StrokeShape><Ellipse /></Border.StrokeShape>
                            </Border>
                            <Label Grid.Column="1" Text="{Binding TransactionType}" FontSize="13" FontAttributes="Bold"
                                   VerticalOptions="Center"
                                   TextColor="{Binding TransactionType, Converter={StaticResource TypeAccent}, ConverterParameter=onAccent}}" />
                        </Grid>
                    </Border>

                    <Label Text="{Binding ErrorMessage}"
                           Style="{StaticResource ErrorLabelStyle}"
                           IsVisible="{Binding HasError}" />

                    <!-- Amount -->
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Amount" Style="{StaticResource FormLabelStyle}" TextColor="{StaticResource FinoraInk}" />
                        <Border Style="{StaticResource FieldBorderStyle}"
                                Stroke="{Binding TransactionType, Converter={StaticResource TypeAccent}}">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6">
                                <Label Text="₱" FontSize="20" FontAttributes="Bold" FontFamily="SpaceGroteskBold"
                                       TextColor="{StaticResource FinoraMuted}" VerticalOptions="Center" Margin="14,0,0,0" />
                                <Entry Grid.Column="1" Text="{Binding AmountText}"
                                       Keyboard="Numeric"
                                       Placeholder="0.00"
                                       BackgroundColor="Transparent"
                                       TextColor="{StaticResource FinoraInk}"
                                       PlaceholderColor="{StaticResource FinoraMuted}"
                                       FontSize="22" FontAttributes="Bold" FontFamily="SpaceGroteskBold"
                                       HeightRequest="56"
                                       HorizontalTextAlignment="End" />
                            </Grid>
                        </Border>
                    </VerticalStackLayout>

                    <!-- Date -->
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Date" Style="{StaticResource FormLabelStyle}" TextColor="{StaticResource FinoraInk}" />
                        <Border Style="{StaticResource FieldBorderStyle}" Padding="14,0">
                            <DatePicker Date="{Binding Date}"
                                        Format="MMM dd, yyyy"
                                        HeightRequest="48"
                                        TextColor="{StaticResource FinoraInk}" />
                        </Border>
                    </VerticalStackLayout>

                    <!-- Account -->
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Account" Style="{StaticResource FormLabelStyle}" TextColor="{StaticResource FinoraInk}" />
                        <controls:ModernSelect ItemsSource="{Binding Accounts}"
                                               SelectedItem="{Binding SelectedAccount}"
                                               Placeholder="Select Account"
                                               DisplayMemberPath="Name"
                                               IconMemberPath="Icon"
                                               ColorMemberPath="Color" />
                        <Button Text="+ New account"
                                Command="{Binding ShowAddAccountCommand}"
                                IsVisible="{Binding IsAddingAccount, Converter={StaticResource InverseBoolConverter}}"
                                Style="{StaticResource TextButtonStyle}"
                                HorizontalOptions="Start"
                                Padding="0" />
                        <Border Style="{StaticResource FieldBorderStyle}"
                                IsVisible="{Binding IsAddingAccount}"
                                Padding="12">
                            <VerticalStackLayout Spacing="8">
                                <Entry Text="{Binding NewAccountName}"
                                       Placeholder="Account name"
                                       BackgroundColor="Transparent"
                                       TextColor="{StaticResource FinoraInk}"
                                       HeightRequest="44" />
                                <Picker Title="Account type"
                                        ItemsSource="{Binding AccountTypes}"
                                        SelectedItem="{Binding NewAccountType}"
                                        BackgroundColor="Transparent"
                                        TextColor="{StaticResource FinoraInk}"
                                        HeightRequest="44" />
                                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                    <Button Text="Add"
                                            Command="{Binding SaveNewAccountCommand}"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            TextColor="{StaticResource FinoraLime}"
                                            HeightRequest="44"
                                            HorizontalOptions="Fill" />
                                    <Button Grid.Column="1" Text="Cancel"
                                            Command="{Binding CancelAddAccountCommand}"
                                            Style="{StaticResource OutlineButtonStyle}"
                                            HeightRequest="44"
                                            HorizontalOptions="Fill" />
                                </Grid>
                            </VerticalStackLayout>
                        </Border>
                    </VerticalStackLayout>

                    <!-- Category -->
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Category" Style="{StaticResource FormLabelStyle}" TextColor="{StaticResource FinoraInk}" />
                        <controls:ModernSelect ItemsSource="{Binding Categories}"
                                               SelectedItem="{Binding SelectedCategory}"
                                               Placeholder="Select Category"
                                               DisplayMemberPath="Name"
                                               IconMemberPath="Icon"
                                               ColorMemberPath="Color" />
                        <Button Text="+ New category"
                                Command="{Binding ShowAddCategoryCommand}"
                                IsVisible="{Binding IsAddingCategory, Converter={StaticResource InverseBoolConverter}}"
                                Style="{StaticResource TextButtonStyle}"
                                HorizontalOptions="Start"
                                Padding="0" />
                        <Border Style="{StaticResource FieldBorderStyle}"
                                IsVisible="{Binding IsAddingCategory}"
                                Padding="12">
                            <VerticalStackLayout Spacing="8">
                                <Entry Text="{Binding NewCategoryName}"
                                       Placeholder="Category name"
                                       BackgroundColor="Transparent"
                                       TextColor="{StaticResource FinoraInk}"
                                       HeightRequest="44" />
                                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                    <Button Text="Add"
                                            Command="{Binding SaveNewCategoryCommand}"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            TextColor="{StaticResource FinoraLime}"
                                            HeightRequest="44"
                                            HorizontalOptions="Fill" />
                                    <Button Grid.Column="1" Text="Cancel"
                                            Command="{Binding CancelAddCategoryCommand}"
                                            Style="{StaticResource OutlineButtonStyle}"
                                            HeightRequest="44"
                                            HorizontalOptions="Fill" />
                                </Grid>
                            </VerticalStackLayout>
                        </Border>
                    </VerticalStackLayout>

                    <!-- Notes -->
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Notes (Optional)" Style="{StaticResource FormLabelStyle}" TextColor="{StaticResource FinoraInk}" />
                        <Border Style="{StaticResource FieldBorderStyle}">
                            <Editor Text="{Binding Notes}"
                                    HeightRequest="72"
                                    Placeholder="Add a note..."
                                    PlaceholderColor="{StaticResource FinoraMuted}"
                                    BackgroundColor="Transparent"
                                    TextColor="{StaticResource FinoraInk}" />
                        </Border>
                    </VerticalStackLayout>

                    <!-- Save / Cancel -->
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10" Margin="0,4,0,0">
                        <Button Grid.Column="0" Text="Save"
                                Command="{Binding SaveCommand}"
                                IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}"
                                Style="{StaticResource PrimaryButtonStyle}"
                                HeightRequest="52"
                                BackgroundColor="{Binding TransactionType, Converter={StaticResource TypeAccent}}"
                                TextColor="{Binding TransactionType, Converter={StaticResource TypeAccent}, ConverterParameter=onAccent}" />
                        <Button Grid.Column="1" Text="Cancel"
                                Command="{Binding CancelCommand}"
                                Style="{StaticResource OutlineButtonStyle}"
                                HeightRequest="52" />
                    </Grid>
                </VerticalStackLayout>
            </ScrollView>
        </Border>

        <!-- Toasts -->
        <controls:ToastHost />

        <!-- Create / edit animation -->
        <controls:SuccessOverlayHost />
    </Grid>
</ContentPage>
