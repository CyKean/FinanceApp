<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:FinanceApp.Mobile.ViewModels"
             xmlns:dtos="clr-namespace:FinanceApp.Application.DTOs;assembly=FinanceApp.Application"
             xmlns:converters="clr-namespace:FinanceApp.Mobile.Converters"
             xmlns:controls="clr-namespace:FinanceApp.Mobile.Views.Controls"
             x:Class="FinanceApp.Mobile.Views.BudgetSuggestionsPage"
             x:DataType="viewmodels:BudgetSuggestionsViewModel"
             Title="{Binding Title}"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource PayCream}"
             x:Name="BudgetSuggestionsPageView">

    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:ColorConverter x:Key="ColorConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid>
        <RefreshView Command="{Binding RefreshCommand}" IsRefreshing="{Binding IsBusy}">
            <VerticalStackLayout Spacing="16" Padding="20,16,20,28">

                <!-- Header -->
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                    <Border WidthRequest="46" HeightRequest="46"
                            Background="{StaticResource PayCard}"
                            Stroke="{StaticResource PayInk}" StrokeThickness="1.5"
                            VerticalOptions="Center">
                        <Border.StrokeShape>
                            <Ellipse />
                        </Border.StrokeShape>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnBackTapped" />
                        </Border.GestureRecognizers>
                        <Label Text="←"
                               FontSize="20"
                               FontAttributes="Bold"
                               TextColor="{StaticResource PayInk}"
                               VerticalOptions="Center"
                               HorizontalOptions="Center" />
                    </Border>

                    <VerticalStackLayout Grid.Column="1" Spacing="0" VerticalOptions="Center">
                        <Label Text="AI Suggestions" FontSize="18" FontAttributes="Bold" FontFamily="SpaceGroteskBold" TextColor="{StaticResource PayInk}" />
                        <Label Text="Budget ideas from your last 3 months" FontSize="12" TextColor="#6F7668" />
                    </VerticalStackLayout>

                    <controls:PaytinIconView Grid.Column="2" IconKey="bulb" Size="46" Light="True" VerticalOptions="Center" />
                </Grid>

                <!-- Suggestions -->
                <CollectionView ItemsSource="{Binding Suggestions}" SelectionMode="None">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="dtos:BudgetSuggestionDto">
                            <Border Style="{StaticResource CardFrameStyle}" Margin="0,4" Padding="16">
                                <VerticalStackLayout Spacing="10">
                                    <Grid ColumnDefinitions="48,*,Auto" ColumnSpacing="12">
                                        <controls:PaytinIconView Grid.Column="0" Icon="{Binding IconGlyph}" Name="{Binding CategoryName}" Size="48" VerticalOptions="Center" />

                                        <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
                                            <Label Text="{Binding CategoryName}"
                                                   Style="{StaticResource BudgetCategoryNameLabelStyle}" />
                                            <Label Text="{Binding KindLabel}"
                                                   FontSize="12"
                                                   FontAttributes="Bold"
                                                   TextColor="{StaticResource PayInk}" />
                                        </VerticalStackLayout>

                                        <Label Grid.Column="2"
                                               Text="{Binding KindIcon}"
                                               FontSize="24"
                                               VerticalOptions="Center" />
                                    </Grid>

                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                        <VerticalStackLayout Grid.Column="0" Spacing="2">
                                            <Label Text="Suggested" Style="{StaticResource BudgetDetailCaptionStyle}" />
                                            <Label Text="{Binding SuggestedText}"
                                                   FontSize="20"
                                                   FontAttributes="Bold"
                                                   FontFamily="SpaceGroteskBold"
                                                   TextColor="{StaticResource PayInk}" />
                                        </VerticalStackLayout>
                                        <Label Grid.Column="1"
                                               Text="{Binding CurrentText}"
                                               Style="{StaticResource BudgetDetailCaptionStyle}"
                                               VerticalOptions="End"
                                               HorizontalTextAlignment="End" />
                                    </Grid>

                                    <Label Text="{Binding Reason}"
                                           Style="{StaticResource MutedLabelStyle}"
                                           LineBreakMode="WordWrap" />

                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                        <Button Grid.Column="0"
                                                Text="Apply →"
                                                Command="{Binding Source={x:Reference BudgetSuggestionsPageView}, Path=BindingContext.ApplyCommand}"
                                                CommandParameter="{Binding .}"
                                                Style="{StaticResource PrimaryButtonStyle}"
                                                TextColor="White" />
                                        <Button Grid.Column="1"
                                                Text="Dismiss"
                                                Command="{Binding Source={x:Reference BudgetSuggestionsPageView}, Path=BindingContext.DismissCommand}"
                                                CommandParameter="{Binding .}"
                                                Style="{StaticResource OutlineButtonStyle}"
                                                WidthRequest="110" />
                                    </Grid>
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                    <CollectionView.EmptyView>
                        <controls:PaytinEmptyState Title="No suggestions right now"
                                                 Subtitle="Once you have a few weeks of spending recorded, tailored budget ideas will appear here"
                                                 IconKey="bulb" />
                    </CollectionView.EmptyView>
                </CollectionView>
            </VerticalStackLayout>
        </RefreshView>

        <!-- Toasts -->
        <controls:ToastHost />

        <!-- Success / failure animation -->
        <controls:SuccessOverlayHost />
    </Grid>
</ContentPage>
