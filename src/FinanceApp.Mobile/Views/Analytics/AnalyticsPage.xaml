<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:FinanceApp.Mobile.ViewModels"
             xmlns:converters="clr-namespace:FinanceApp.Mobile.Converters"
             xmlns:controls="clr-namespace:FinanceApp.Mobile.Views.Controls"
             x:Class="FinanceApp.Mobile.Views.Analytics.AnalyticsPage"
             x:DataType="viewmodels:AnalyticsViewModel"
             Title="{Binding Title}">

    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:NullToBoolConverter x:Key="NullToBoolConverter" />
            <converters:CountToBoolConverter x:Key="CountToBoolConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <RefreshView Command="{Binding RefreshCommand}" IsRefreshing="{Binding IsBusy}">
        <ScrollView>
            <VerticalStackLayout Spacing="16" Padding="16">

                <!-- Period Selector -->
                <Border Style="{StaticResource CardFrameStyle}" Padding="12">
                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">
                        <Button Grid.Column="0" Text="3M" HeightRequest="46"
                                Command="{Binding ChangePeriodCommand}" CommandParameter="3"
                                Style="{Binding SelectedMonths, Converter={StaticResource PeriodButtonStyleConverter}, ConverterParameter=3}" />
                        <Button Grid.Column="1" Text="6M" HeightRequest="46"
                                Command="{Binding ChangePeriodCommand}" CommandParameter="6"
                                Style="{Binding SelectedMonths, Converter={StaticResource PeriodButtonStyleConverter}, ConverterParameter=6}" />
                        <Button Grid.Column="2" Text="12M" HeightRequest="46"
                                Command="{Binding ChangePeriodCommand}" CommandParameter="12"
                                Style="{Binding SelectedMonths, Converter={StaticResource PeriodButtonStyleConverter}, ConverterParameter=12}" />
                    </Grid>
                </Border>

                <!-- Monthly Trends -->
                <Border Style="{StaticResource CardFrameStyle}" Padding="16"
                        IsVisible="{Binding Analytics.SpendingTrends.Count, Converter={StaticResource CountToBoolConverter}}">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="Monthly Trends" Style="{StaticResource SectionHeaderStyle}" />
                        <VerticalStackLayout Spacing="8">
                            <controls:MonthlyTrendChart Items="{Binding Analytics.SpendingTrends}" HeightRequest="200" />
                            <HorizontalStackLayout Spacing="16" HorizontalOptions="Center">
                                <HorizontalStackLayout Spacing="6">
                                    <Border WidthRequest="10" HeightRequest="10" StrokeThickness="0" Background="#15803D">
                                        <Border.StrokeShape>
                                            <Ellipse />
                                        </Border.StrokeShape>
                                    </Border>
                                    <Label Text="Income" Style="{StaticResource CaptionLabelStyle}" VerticalOptions="Center" />
                                </HorizontalStackLayout>
                                <HorizontalStackLayout Spacing="6">
                                    <Border WidthRequest="10" HeightRequest="10" StrokeThickness="0" Background="#DC2626">
                                        <Border.StrokeShape>
                                            <Ellipse />
                                        </Border.StrokeShape>
                                    </Border>
                                    <Label Text="Expense" Style="{StaticResource CaptionLabelStyle}" VerticalOptions="Center" />
                                </HorizontalStackLayout>
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <!-- Spending by Category -->
                <Border Style="{StaticResource CardFrameStyle}" Padding="16"
                        IsVisible="{Binding Analytics.CategoryBreakdown.Count, Converter={StaticResource CountToBoolConverter}}">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="Spending by Category" Style="{StaticResource SectionHeaderStyle}" />
                        <controls:CategoryDonutChart Items="{Binding Analytics.CategoryBreakdown}" HeightRequest="210" />
                    </VerticalStackLayout>
                </Border>

                <!-- Income vs Expenses -->
                <Border Style="{StaticResource CardFrameStyle}" Padding="16"
                        IsVisible="{Binding Analytics, Converter={StaticResource NullToBoolConverter}}">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="Income vs Expenses" Style="{StaticResource SectionHeaderStyle}" />
                        <controls:IncomeExpenseChart Income="{Binding Analytics.MonthlyIncome}"
                                                     Expense="{Binding Analytics.MonthlyExpense}"
                                                     Net="{Binding Analytics.IncomeVsExpense}"
                                                     HeightRequest="94" />
                    </VerticalStackLayout>
                </Border>

                <!-- Savings Rate -->
                <Border Style="{StaticResource CardFrameStyle}" Padding="16"
                        IsVisible="{Binding Analytics, Converter={StaticResource NullToBoolConverter}}">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="Savings Rate" Style="{StaticResource SectionHeaderStyle}" />
                        <controls:SavingsRateGauge Value="{Binding Analytics.SavingsRate}"
                                                   HeightRequest="180" />
                    </VerticalStackLayout>
                </Border>

                <!-- Spending Averages -->
                <Border Style="{StaticResource CardFrameStyle}" Padding="16"
                        IsVisible="{Binding Analytics, Converter={StaticResource NullToBoolConverter}}">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="Spending Averages" Style="{StaticResource SectionHeaderStyle}" />
                        <controls:AveragesChart Daily="{Binding Analytics.AverageDailySpending}"
                                                Monthly="{Binding Analytics.AverageMonthlySpending}"
                                                HeightRequest="64" />
                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>
    </RefreshView>
</ContentPage>
