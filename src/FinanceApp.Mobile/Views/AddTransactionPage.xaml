<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:FinanceApp.Mobile.ViewModels"
             xmlns:converters="clr-namespace:FinanceApp.Mobile.Converters"
             xmlns:sys="clr-namespace:System;assembly=netstandard"
             xmlns:controls="clr-namespace:FinanceApp.Mobile.Views.Controls"
             x:Class="FinanceApp.Mobile.Views.AddTransactionPage"
             x:DataType="viewmodels:AddTransactionViewModel"
             Title="{Binding Title}">

    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:MoneyToStringConverter x:Key="MoneyConverter" />
            <converters:InverseBoolConverter x:Key="InverseBoolConverter" />
            <converters:TransactionTypeToButtonStyleConverter x:Key="TransactionTypeToButtonStyleConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid>
    <ScrollView>
        <VerticalStackLayout Spacing="14" Padding="18,14,18,24">
            <!-- Header -->
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" VerticalOptions="Center">
                <Border WidthRequest="46" HeightRequest="46"
                        Background="{DynamicResource FinoraCard}"
                        Stroke="{DynamicResource FinoraInk}" StrokeThickness="1.5"
                        VerticalOptions="Center">
                    <Border.StrokeShape><Ellipse /></Border.StrokeShape>
                    <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding CancelCommand}" /></Border.GestureRecognizers>
                    <controls:FinoraIconView IconKey="arrowleft" Size="20" ShowBadge="False" Light="True" HorizontalOptions="Center" VerticalOptions="Center" />
                </Border>
                <VerticalStackLayout Grid.Column="1" Spacing="0" VerticalOptions="Center">
                    <Label Text="{Binding Title}" FontSize="18" FontAttributes="Bold" FontFamily="SpaceGroteskBold" TextColor="{DynamicResource FinoraInk}" />
                    <Label Text="Record money in or out" FontSize="12" TextColor="{DynamicResource FinoraMuted}" />
                </VerticalStackLayout>
                <controls:FinoraIconView Grid.Column="2" IconKey="pencil" Size="46" Light="True" VerticalOptions="Center" />
            </Grid>

            <!-- Type Selector (only for new transactions) -->
            <Border Style="{StaticResource CardFrameStyle}" IsVisible="{Binding IsEditing, Converter={StaticResource InverseBoolConverter}}" Padding="16">
                <HorizontalStackLayout Spacing="12">
                    <Button Text="Expense" 
                            Command="{Binding SetExpenseTypeCommand}"
                            Style="{Binding TransactionType, Converter={StaticResource TransactionTypeToButtonStyleConverter}, ConverterParameter=Expense}"
                            HorizontalOptions="Fill" />
                    <Button Text="Income" 
                            Command="{Binding SetIncomeTypeCommand}"
                            Style="{Binding TransactionType, Converter={StaticResource TransactionTypeToButtonStyleConverter}, ConverterParameter=Income}"
                            HorizontalOptions="Fill" />
                </HorizontalStackLayout>
            </Border>

            <!-- Amount -->
            <Border Style="{StaticResource CardFrameStyle}" Padding="16">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Amount" Style="{StaticResource FormLabelStyle}" />
                    <Entry Text="{Binding AmountText}" 
                           Keyboard="Numeric" 
                           Placeholder="0.00"
                           Style="{StaticResource AmountEntryStyle}"
                           HorizontalTextAlignment="End" />
                </VerticalStackLayout>
            </Border>

            <!-- Date -->
            <Border Style="{StaticResource CardFrameStyle}" Padding="16">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Date" Style="{StaticResource FormLabelStyle}" />
                    <DatePicker Date="{Binding Date}" 
                                Format="MMM dd, yyyy"
                                MaximumDate="{Binding Source={x:Static sys:DateTime.Today}, Path=Today}"
                                Style="{StaticResource DatePickerStyle}" />
                </VerticalStackLayout>
            </Border>

            <!-- Account -->
            <Border Style="{StaticResource CardFrameStyle}" Padding="16">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Account" Style="{StaticResource FormLabelStyle}" />
                    <controls:ModernSelect ItemsSource="{Binding Accounts}"
                                           SelectedItem="{Binding SelectedAccount}"
                                           Placeholder="Select Account"
                                           DisplayMemberPath="Name"
                                           IconMemberPath="Icon" />
                </VerticalStackLayout>
            </Border>

            <!-- Category -->
            <Border Style="{StaticResource CardFrameStyle}" Padding="16">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Category" Style="{StaticResource FormLabelStyle}" />
                    <controls:ModernSelect ItemsSource="{Binding Categories}"
                                           SelectedItem="{Binding SelectedCategory}"
                                           Placeholder="Select Category"
                                           DisplayMemberPath="Name"
                                           IconMemberPath="Icon" />
                </VerticalStackLayout>
            </Border>

            <!-- Notes -->
            <Border Style="{StaticResource CardFrameStyle}" Padding="16">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Notes (Optional)" Style="{StaticResource FormLabelStyle}" />
                    <Editor Text="{Binding Notes}" 
                            HeightRequest="100"
                            Placeholder="Add a note..."
                            Style="{StaticResource EditorStyle}" />
                </VerticalStackLayout>
            </Border>

            <!-- Save Button -->
            <Button Text="{Binding IsEditing, Converter={StaticResource BoolToStringConverter}, ConverterParameter='Update|Save'}" 
                    Command="{Binding SaveCommand}"
                    IsEnabled="{Binding IsSaveAvailable}"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Margin="16,24,16,16" />
        </VerticalStackLayout>
    </ScrollView>

        <!-- Toasts -->
        <controls:ToastHost />

        <!-- Create / edit animation -->
        <controls:SuccessOverlayHost />
    </Grid>

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Cancel" Command="{Binding CancelCommand}" Priority="0" />
    </ContentPage.ToolbarItems>
</ContentPage>