<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:FinanceApp.Mobile.ViewModels"
             xmlns:dtos="clr-namespace:FinanceApp.Application.DTOs;assembly=FinanceApp.Application"
             xmlns:converters="clr-namespace:FinanceApp.Mobile.Converters"
             xmlns:controls="clr-namespace:FinanceApp.Mobile.Views.Controls"
             x:Class="FinanceApp.Mobile.Views.Predictions.PredictionsPage"
             x:DataType="viewmodels:PredictionsViewModel"
             Title="{Binding Title}"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{DynamicResource FinoraCream}">

    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:MoneyToStringConverter x:Key="MoneyConverter" />
            <converters:PercentageConverter x:Key="PercentageConverter" />
            <converters:PercentageToColorConverter x:Key="PercentageColorConverter" />
            <converters:TransactionTypeToColorConverter x:Key="TransactionTypeColorConverter" />
            <converters:InverseBoolConverter x:Key="InverseBoolConverter" />
            <converters:ColorConverter x:Key="ColorConverter" />
            <converters:SavingsRateColorConverter x:Key="SavingsRateColorConverter" />
            <converters:GoalStatusVisibilityConverter x:Key="GoalStatusVisibilityConverter" />
            <converters:GoalStatusToStringConverter x:Key="GoalStatusToStringConverter" />
            <converters:SyncStatusToColorConverter x:Key="SyncStatusToColorConverter" />
            <converters:SyncStatusToIconConverter x:Key="SyncStatusToIconConverter" />

            <!-- Shared look for the "nothing in this section" hint, so every
                 section explains itself identically instead of dropping away. -->
            <Style x:Key="SectionEmptyLabelStyle" TargetType="Label">
                <Setter Property="FontSize" Value="13" />
                <Setter Property="TextColor" Value="{DynamicResource FinoraMuted}" />
                <Setter Property="HorizontalTextAlignment" Value="Center" />
            </Style>
        </ResourceDictionary>
    </ContentPage.Resources>

    <!-- One ScrollView drives the whole page. The sections use BindableLayout
         rather than nested CollectionViews: nested collections inside a
         ScrollView fight over the vertical drag gesture and each one needs a
         fixed HeightRequest, which is what clipped the lists. -->
    <controls:SkeletonForecasts IsVisible="{Binding IsInitialLoading}" />

    <RefreshView Command="{Binding RefreshCommand}" IsRefreshing="{Binding IsRefreshing, Mode=OneWay}"
                  IsVisible="{Binding IsInitialLoading, Converter={StaticResource InverseBoolConverter}}">
        <ScrollView>
            <VerticalStackLayout Spacing="14" Padding="18,14,18,24">

                <!-- Header -->
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" VerticalOptions="Center">
                    <Border WidthRequest="46" HeightRequest="46"
                            Background="{DynamicResource FinoraCard}"
                            Stroke="{DynamicResource FinoraInk}" StrokeThickness="1.5"
                            VerticalOptions="Center">
                        <Border.StrokeShape><Ellipse /></Border.StrokeShape>
                        <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnBackTapped" /></Border.GestureRecognizers>
                        <controls:FinoraIconView IconKey="arrowleft" Size="20" ShowBadge="False" Light="True" HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>
                    <VerticalStackLayout Grid.Column="1" Spacing="0" VerticalOptions="Center">
                        <Label Text="Forecasts" FontSize="18" FontAttributes="Bold" FontFamily="SpaceGroteskBold" TextColor="{DynamicResource FinoraInk}" />
                        <Label Text="What next month looks like" FontSize="12" TextColor="{DynamicResource FinoraMuted}" />
                    </VerticalStackLayout>
                    <controls:FinoraIconView Grid.Column="2" IconKey="forecast" Size="46" VerticalOptions="Center" />
                </Grid>

                <!-- Hero card.
                     The three headline figures used to sit in one
                     HorizontalStackLayout, which squeezed "Confidence" and
                     "Predicted Expenses" off the edge. The primary figure now
                     owns a row and the two secondary figures share another. -->
                <Border Style="{StaticResource HeroCardStyle}" IsVisible="{Binding HasAnyData}">
                    <VerticalStackLayout Spacing="12">
                        <HorizontalStackLayout Spacing="10" VerticalOptions="Center">
                            <controls:FinoraIconView IconKey="sparkle" Size="44" Light="True" VerticalOptions="Center" />
                            <VerticalStackLayout Spacing="0" VerticalOptions="Center" HorizontalOptions="Fill">
                                <Label Text="Next Month Prediction" FontSize="16" FontAttributes="Bold" FontFamily="SpaceGroteskBold" TextColor="White" />
                                <Label Text="{Binding ExpensePrediction.PredictionDate, StringFormat='Generated {0:MMM dd, yyyy}'}" FontSize="12" TextColor="White" Opacity="0.7" />
                            </VerticalStackLayout>
                        </HorizontalStackLayout>

                        <VerticalStackLayout Spacing="2">
                            <Label Text="Predicted Expenses" FontSize="12" FontAttributes="Bold" TextColor="{DynamicResource FinoraLime}" />
                            <Label Text="{Binding ExpensePrediction.TotalPredicted, Converter={StaticResource MoneyConverter}}"
                                   FontSize="28" FontAttributes="Bold" FontFamily="SpaceGroteskBold" TextColor="White" />
                        </VerticalStackLayout>

                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
                            <VerticalStackLayout Grid.Column="0" Spacing="2" VerticalOptions="Center">
                                <Label Text="Range" FontSize="12" FontAttributes="Bold" TextColor="White" Opacity="0.7" />
                                <HorizontalStackLayout Spacing="4" VerticalOptions="Center">
                                    <Label Text="{Binding ExpensePrediction.MinTotal, Converter={StaticResource MoneyConverter}}" FontSize="13" FontAttributes="Bold" TextColor="White" />
                                    <Label Text="-" FontSize="13" FontAttributes="Bold" TextColor="White" />
                                    <Label Text="{Binding ExpensePrediction.MaxTotal, Converter={StaticResource MoneyConverter}}" FontSize="13" FontAttributes="Bold" TextColor="White" />
                                </HorizontalStackLayout>
                            </VerticalStackLayout>

                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center" HorizontalOptions="End">
                                <Label Text="Confidence" FontSize="12" FontAttributes="Bold" TextColor="White" Opacity="0.7"
                                       HorizontalTextAlignment="End" />
                                <Border Background="{Binding ExpensePrediction.Confidence, Converter={StaticResource PredictionConfidenceColorConverter}}"
                                        Padding="10,4" HorizontalOptions="End">
                                    <Border.StrokeShape><RoundRectangle CornerRadius="12" /></Border.StrokeShape>
                                    <Label Text="{Binding ExpensePrediction.Confidence}" TextColor="White" FontSize="12" FontAttributes="Bold" />
                                </Border>
                            </VerticalStackLayout>
                        </Grid>

                        <Border Background="{Binding ExpensePrediction.Confidence, Converter={StaticResource PredictionConfidenceColorConverter}}"
                                Padding="12" IsVisible="{Binding ExpensePrediction.Confidence, Converter={StaticResource PredictionConfidenceToBoolConverter}, ConverterParameter=InsufficientData}">
                            <Border.StrokeShape><RoundRectangle CornerRadius="8" /></Border.StrokeShape>
                            <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                                    <controls:FinoraIconView IconKey="chart" Size="16" ShowBadge="False" StrokeColor="White" VerticalOptions="Center" />
                                    <Label Text="Insufficient data for reliable predictions. Add more transactions to improve accuracy."
                                           TextColor="White" FontSize="13" />
                                </HorizontalStackLayout>
                        </Border>
                    </VerticalStackLayout>
                </Border>

                <!-- Category Breakdown -->
                <Border Style="{StaticResource CardFrameStyle}" Padding="16" Margin="0,4,0,0" IsVisible="{Binding HasAnyData}">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="Category Breakdown" Style="{StaticResource SectionHeaderStyle}" />

                        <VerticalStackLayout Spacing="0"
                                             BindableLayout.ItemsSource="{Binding ExpensePrediction.CategoryPredictions}"
                                             IsVisible="{Binding HasCategories}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="dtos:CategoryPredictionDto">
                                    <Border Style="{StaticResource CategoryItemFrameStyle}" Margin="0,4">
                                        <HorizontalStackLayout Spacing="12">
                                            <controls:FinoraIconView Icon="{Binding CategoryIcon}" Name="{Binding CategoryName}" Size="44" VerticalOptions="Center" />
                                            <VerticalStackLayout Spacing="2" VerticalOptions="Center" HorizontalOptions="Fill">
                                                <Label Text="{Binding CategoryName}" Style="{StaticResource CategoryNameLabelStyle}" />
                                                <ProgressBar Progress="{Binding PredictedAmount.Amount, Converter={StaticResource PercentageConverter}, ConverterParameter=div1000}"
                                                             ProgressColor="{Binding PredictedAmount.Amount, Converter={StaticResource PercentageColorConverter}}" HeightRequest="6" />
                                            </VerticalStackLayout>
                                            <VerticalStackLayout Spacing="2" VerticalOptions="Center" HorizontalOptions="End">
                                                <Label Text="{Binding PredictedAmount, Converter={StaticResource MoneyConverter}}" Style="{StaticResource CategoryAmountLabelStyle}" />
                                                <HorizontalStackLayout Spacing="4" HorizontalOptions="End">
                                                    <Label Text="{Binding MinAmount, Converter={StaticResource MoneyConverter}}" Style="{StaticResource CategoryPercentLabelStyle}" />
                                                    <Label Text="-" Style="{StaticResource CategoryPercentLabelStyle}" />
                                                    <Label Text="{Binding MaxAmount, Converter={StaticResource MoneyConverter}}" Style="{StaticResource CategoryPercentLabelStyle}" />
                                                </HorizontalStackLayout>
                                            </VerticalStackLayout>
                                        </HorizontalStackLayout>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>

                        <Label Text="No category totals yet - they appear once a category has spending in the last month."
                               Style="{StaticResource SectionEmptyLabelStyle}"
                               IsVisible="{Binding HasCategories, Converter={StaticResource InverseBoolConverter}}" />
                    </VerticalStackLayout>
                </Border>

                <!-- Spending Trends -->
                <Border Style="{StaticResource CardFrameStyle}" Padding="16" Margin="0,4,0,0" IsVisible="{Binding HasAnyData}">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="Spending Trends (6 months)" Style="{StaticResource SectionHeaderStyle}" />

                        <VerticalStackLayout Spacing="0"
                                             BindableLayout.ItemsSource="{Binding SpendingTrends}"
                                             IsVisible="{Binding HasTrends}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="dtos:SpendingTrendDto">
                                    <Border Style="{StaticResource TrendItemFrameStyle}" Margin="0,4">
                                        <HorizontalStackLayout Spacing="12">
                                            <controls:FinoraIconView Icon="{Binding CategoryIcon}" Name="{Binding CategoryName}" Size="40" VerticalOptions="Center" />
                                            <VerticalStackLayout Spacing="2" VerticalOptions="Center" HorizontalOptions="Fill">
                                                <Label Text="{Binding CategoryName}" Style="{StaticResource CategoryNameLabelStyle}" />
                                                <controls:FinoraIconView IconKey="{Binding Trend, Converter={StaticResource TrendToIconConverter}}" Size="13" ShowBadge="False" HorizontalOptions="Start"
                                                                                StrokeColor="{Binding Trend, Converter={StaticResource TrendToColorConverter}}" />
                                            </VerticalStackLayout>
                                            <VerticalStackLayout Spacing="2" VerticalOptions="Center" HorizontalOptions="End">
                                                <Label Text="{Binding ChangePercentage, StringFormat='{0:+0.0;-0.0;0}%'}"
                                                       Style="{StaticResource TrendPercentLabelStyle}"
                                                       TextColor="{Binding Trend, Converter={StaticResource TrendToColorConverter}}" />
                                                <!-- "Current: {Binding ...}" rendered the binding as literal
                                                     text, because a MarkupExtension has to be the whole
                                                     attribute value. It was worked around with a
                                                     FormattedString of Spans, which then threw at runtime on
                                                     Android: "Property FormattedString is null or is not
                                                     IEnumerable". Debug builds skip XamlC, so that markup is
                                                     parsed by the runtime loader, which cannot resolve a
                                                     page-level converter referenced from inside a Span. A row
                                                     of plain Labels does the same job and parses. -->
                                                <HorizontalStackLayout Spacing="0">
                                                    <Label Text="Current: " Style="{StaticResource TrendCaptionLabelStyle}" />
                                                    <Label Text="{Binding CurrentAverage, Converter={StaticResource MoneyConverter}}" Style="{StaticResource TrendCaptionLabelStyle}" />
                                                </HorizontalStackLayout>
                                                <HorizontalStackLayout Spacing="0">
                                                    <Label Text="Previous: " Style="{StaticResource TrendCaptionLabelStyle}" />
                                                    <Label Text="{Binding PreviousAverage, Converter={StaticResource MoneyConverter}}" Style="{StaticResource TrendCaptionLabelStyle}" />
                                                </HorizontalStackLayout>
                                            </VerticalStackLayout>
                                        </HorizontalStackLayout>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>

                        <Label Text="Not enough history to spot a trend. A category needs spending in at least four months."
                               Style="{StaticResource SectionEmptyLabelStyle}"
                               IsVisible="{Binding HasTrends, Converter={StaticResource InverseBoolConverter}}" />
                    </VerticalStackLayout>
                </Border>

                <!-- Budget Forecasts -->
                <Border Style="{StaticResource CardFrameStyle}" Padding="16" Margin="0,4,0,0" IsVisible="{Binding HasAnyData}">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="Budget Forecasts" Style="{StaticResource SectionHeaderStyle}" />

                        <VerticalStackLayout Spacing="0"
                                             BindableLayout.ItemsSource="{Binding BudgetForecasts}"
                                             IsVisible="{Binding HasBudgetForecasts}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="dtos:BudgetForecastDto">
                                    <Border Style="{StaticResource BudgetCardFrameStyle}" Margin="0,4">
                                        <VerticalStackLayout Spacing="8">
                                            <HorizontalStackLayout Spacing="12">
                                                <Border WidthRequest="44" HeightRequest="44"
                                                        Background="{Binding CategoryColor, Converter={StaticResource ColorConverter}}"
                                                        Stroke="Transparent" StrokeThickness="0">
                                                    <Border.StrokeShape><Ellipse /></Border.StrokeShape>
                                                    <controls:FinoraIconView Icon="{Binding CategoryIcon}" Name="{Binding BudgetName}" Size="18" ShowBadge="False"
                                                                                Accent="{Binding CategoryColor, Converter={StaticResource ColorConverter}}"
                                                                                VerticalOptions="Center" HorizontalOptions="Center" />
                                                </Border>
                                                <VerticalStackLayout Spacing="4" VerticalOptions="Center" HorizontalOptions="Fill">
                                                    <Label Text="{Binding BudgetName}" Style="{StaticResource BudgetCategoryNameLabelStyle}" />
                                                    <ProgressBar Progress="{Binding PercentageUsed, Converter={StaticResource PercentageConverter}}"
                                                                 ProgressColor="{Binding PercentageUsed, Converter={StaticResource PercentageColorConverter}}" HeightRequest="8" />
                                                </VerticalStackLayout>
                                                <Label Text="{Binding WillExceedBudget, Converter={StaticResource BoolToStringConverter}, ConverterParameter='Will Exceed|On Track'}"
                                                       Style="{StaticResource BudgetPercentageLabelStyle}"
                                                       TextColor="{Binding WillExceedBudget, Converter={StaticResource BoolToColorConverter}, ConverterParameter=Red|Green}" />
                                            </HorizontalStackLayout>
                                            <Grid ColumnDefinitions="*,*,*">
                                                <VerticalStackLayout Grid.Column="0" Spacing="2">
                                                    <Label Text="Current" Style="{StaticResource BudgetDetailCaptionStyle}" />
                                                    <Label Text="{Binding CurrentSpent, Converter={StaticResource MoneyConverter}}" Style="{StaticResource BudgetDetailValueStyle}" TextColor="Red" />
                                                </VerticalStackLayout>
                                                <VerticalStackLayout Grid.Column="1" Spacing="2">
                                                    <Label Text="Predicted" Style="{StaticResource BudgetDetailCaptionStyle}" />
                                                    <Label Text="{Binding PredictedSpent, Converter={StaticResource MoneyConverter}}" Style="{StaticResource BudgetDetailValueStyle}" TextColor="Orange" />
                                                </VerticalStackLayout>
                                                <VerticalStackLayout Grid.Column="2" Spacing="2">
                                                    <Label Text="Budget" Style="{StaticResource BudgetDetailCaptionStyle}" />
                                                    <Label Text="{Binding BudgetAmount, Converter={StaticResource MoneyConverter}}" Style="{StaticResource BudgetDetailValueStyle}" />
                                                </VerticalStackLayout>
                                            </Grid>
                                            <Label Text="{Binding ExceedPercentage, StringFormat='Exceed by {0:F1}%'}"
                                                   Style="{StaticResource OverBudgetLabelStyle}"
                                                   IsVisible="{Binding WillExceedBudget}"
                                                   TextColor="Red" />
                                        </VerticalStackLayout>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>

                        <Label Text="No active budgets to project. Add a budget and it will be forecast here."
                               Style="{StaticResource SectionEmptyLabelStyle}"
                               IsVisible="{Binding HasBudgetForecasts, Converter={StaticResource InverseBoolConverter}}" />
                    </VerticalStackLayout>
                </Border>

                <!-- Smart Insights -->
                <Border Style="{StaticResource CardFrameStyle}" Padding="16" Margin="0,4,0,0" IsVisible="{Binding HasAnyData}">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="Smart Insights" FontSize="16" FontAttributes="Bold" FontFamily="SpaceGroteskBold" TextColor="{DynamicResource FinoraInk}" />

                        <VerticalStackLayout Spacing="0"
                                             BindableLayout.ItemsSource="{Binding Insights}"
                                             IsVisible="{Binding HasInsights}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="dtos:SmartInsightDto">
                                    <Border Style="{StaticResource InsightCardFrameStyle}" Margin="0,4">
                                        <VerticalStackLayout Spacing="8">
                                            <HorizontalStackLayout Spacing="12">
                                                <controls:FinoraIconView IconKey="{Binding Severity, Converter={StaticResource InsightSeverityToIconConverter}}"
                                                                        Size="38" VerticalOptions="Center" />
                                                <VerticalStackLayout Spacing="2" VerticalOptions="Center" HorizontalOptions="Fill">
                                                    <Label Text="{Binding Title}" Style="{StaticResource InsightTitleLabelStyle}" />
                                                    <Label Text="{Binding Message}" Style="{StaticResource InsightMessageLabelStyle}" />
                                                </VerticalStackLayout>
                                            </HorizontalStackLayout>
                                        </VerticalStackLayout>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>

                        <Label Text="No insights right now. They appear once there is enough activity to comment on."
                               Style="{StaticResource SectionEmptyLabelStyle}"
                               IsVisible="{Binding HasInsights, Converter={StaticResource InverseBoolConverter}}" />
                    </VerticalStackLayout>
                </Border>

                <!-- Anomalies -->
                <Border Style="{StaticResource CardFrameStyle}" Padding="16" Margin="0,4,0,0" IsVisible="{Binding HasAnyData}">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="Unusual Spending" FontSize="16" FontAttributes="Bold" FontFamily="SpaceGroteskBold" TextColor="{DynamicResource FinoraInk}" />

                        <VerticalStackLayout Spacing="0"
                                             BindableLayout.ItemsSource="{Binding Anomalies}"
                                             IsVisible="{Binding HasAnomalies}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="dtos:AnomalyDetectionDto">
                                    <Border Style="{StaticResource AnomalyCardFrameStyle}" Margin="0,4">
                                        <VerticalStackLayout Spacing="8">
                                            <HorizontalStackLayout Spacing="12">
                                                <controls:FinoraIconView IconKey="alertCircle" Size="34" VerticalOptions="Center" />
                                                <VerticalStackLayout Spacing="2" VerticalOptions="Center" HorizontalOptions="Fill">
                                                    <Label Text="{Binding CategoryName}" Style="{StaticResource AnomalyCategoryLabelStyle}" />
                                                    <Label Text="{Binding Message}" Style="{StaticResource AnomalyMessageLabelStyle}" />
                                                </VerticalStackLayout>
                                                <Label Text="{Binding DeviationPercentage, StringFormat='{0:+0;-0}%'}"
                                                       Style="{StaticResource AnomalyDeviationLabelStyle}" TextColor="Red" />
                                            </HorizontalStackLayout>
                                            <Grid ColumnDefinitions="*,*,*">
                                                <VerticalStackLayout Grid.Column="0" Spacing="2">
                                                    <Label Text="Amount" Style="{StaticResource AnomalyDetailCaptionStyle}" />
                                                    <Label Text="{Binding Amount, Converter={StaticResource MoneyConverter}}" Style="{StaticResource AnomalyDetailValueStyle}" TextColor="Red" />
                                                </VerticalStackLayout>
                                                <VerticalStackLayout Grid.Column="1" Spacing="2">
                                                    <Label Text="Typical Range" Style="{StaticResource AnomalyDetailCaptionStyle}" />
                                                    <HorizontalStackLayout Spacing="4">
                                                        <Label Text="{Binding TypicalMin, Converter={StaticResource MoneyConverter}}" Style="{StaticResource AnomalyDetailValueStyle}" />
                                                        <Label Text="-" Style="{StaticResource AnomalyDetailValueStyle}" />
                                                        <Label Text="{Binding TypicalMax, Converter={StaticResource MoneyConverter}}" Style="{StaticResource AnomalyDetailValueStyle}" />
                                                    </HorizontalStackLayout>
                                                </VerticalStackLayout>
                                                <VerticalStackLayout Grid.Column="2" Spacing="2">
                                                    <Label Text="Date" Style="{StaticResource AnomalyDetailCaptionStyle}" />
                                                    <Label Text="{Binding TransactionDate, StringFormat='{0:MMM dd}'}" Style="{StaticResource AnomalyDetailValueStyle}" />
                                                </VerticalStackLayout>
                                            </Grid>
                                        </VerticalStackLayout>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>

                        <Label Text="Nothing unusual - every transaction sits within its usual range."
                               Style="{StaticResource SectionEmptyLabelStyle}"
                               IsVisible="{Binding HasAnomalies, Converter={StaticResource InverseBoolConverter}}" />
                    </VerticalStackLayout>
                </Border>

                <!-- Empty state: nothing at all to forecast from. -->
                <VerticalStackLayout Spacing="14" IsVisible="{Binding HasNoData}">
                    <controls:FinoraEmptyState Title="Not enough history yet"
                                              Subtitle="Forecasts need expenses recorded across at least two months, with 10 or more transactions. Keep logging and they will appear here."
                                              IconKey="forecast" />

                    <Border Background="{DynamicResource FinoraCard}"
                            Stroke="{DynamicResource FinoraInk}" StrokeThickness="1.5"
                            Padding="16" IsVisible="{Binding HasError}">
                        <Border.StrokeShape><RoundRectangle CornerRadius="14" /></Border.StrokeShape>
                        <VerticalStackLayout Spacing="6">
                            <Label Text="Something went wrong" FontSize="14" FontAttributes="Bold" FontFamily="SpaceGroteskBold" TextColor="{DynamicResource FinoraInk}" />
                            <Label Text="{Binding ErrorMessage}" FontSize="13" TextColor="{DynamicResource FinoraMuted}" />
                            <Button Text="Try again"
                                    Command="{Binding RefreshCommand}"
                                    Style="{StaticResource OutlineButtonStyle}"
                                    HorizontalOptions="Start" />
                        </VerticalStackLayout>
                    </Border>

                    <Button Text="Load sample data"
                            Command="{Binding LoadSampleDataCommand}"
                            IsVisible="{Binding CanLoadSampleData}"
                            Style="{StaticResource OutlineButtonStyle}"
                            HorizontalOptions="Center" />

                    <ActivityIndicator IsRunning="{Binding IsPreparingSampleData}"
                                       IsVisible="{Binding IsPreparingSampleData}"
                                       Color="{DynamicResource FinoraLimeDark}" />
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>
    </RefreshView>
</ContentPage>