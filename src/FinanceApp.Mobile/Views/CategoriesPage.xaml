<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:FinanceApp.Mobile.ViewModels"
             xmlns:converters="clr-namespace:FinanceApp.Mobile.Converters"
             xmlns:controls="clr-namespace:FinanceApp.Mobile.Views.Controls"
             xmlns:enums="clr-namespace:FinanceApp.Domain.Enums;assembly=FinanceApp.Domain"
             x:Class="FinanceApp.Mobile.Views.CategoriesPage"
             Title="{Binding Title}"
             x:Name="CategoriesPageView">

    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:InverseBoolConverter x:Key="InverseBoolConverter" />
            <converters:NullToBoolConverter x:Key="NullToBoolConverter" />
            <converters:ColorConverter x:Key="ColorConverter" />
            <converters:BoolToStringConverter x:Key="BoolToStringConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid>
    <RefreshView Command="{Binding RefreshCommand}" IsRefreshing="{Binding IsBusy}">
        <VerticalStackLayout Spacing="16" Padding="16">
            <!-- Tab Selector -->
            <Border Style="{StaticResource CardFrameStyle}" Padding="4">
                <HorizontalStackLayout Spacing="4">
                    <Button Text="Expenses" 
                            Command="{Binding SetTabCommand}"
                            CommandParameter="{x:Static enums:CategoryType.Expense}"
                            Style="{Binding SelectedTab, Converter={StaticResource CategoryTabStyleConverter}, ConverterParameter=Expense}"
                            HorizontalOptions="Fill" />
                    <Button Text="Income" 
                            Command="{Binding SetTabCommand}"
                            CommandParameter="{x:Static enums:CategoryType.Income}"
                            Style="{Binding SelectedTab, Converter={StaticResource CategoryTabStyleConverter}, ConverterParameter=Income}"
                            HorizontalOptions="Fill" />
                </HorizontalStackLayout>
            </Border>

            <!-- Categories List -->
            <CollectionView ItemsSource="{Binding ExpenseCategories}" 
                            IsVisible="{Binding SelectedTab, Converter={StaticResource CategoryTabVisibilityConverter}, ConverterParameter=Expense}"
                            SelectionMode="None">
<CollectionView.ItemTemplate>
                        <DataTemplate>
                            <SwipeView>
                                <SwipeView.RightItems>
                                    <SwipeItems>
                                        <SwipeItem Text="Edit" 
                                                   Background="#0E6B4F"
                                                   Command="{Binding Source={x:Reference CategoriesPageView}, Path=BindingContext.EditCategoryCommand}"
                                                   CommandParameter="{Binding .}" />
                                        <SwipeItem Text="{Binding IsActive, Converter={StaticResource BoolToStringConverter}, ConverterParameter='Deactivate|Activate'}" 
                                                   Background="Orange"
                                                   Command="{Binding Source={x:Reference CategoriesPageView}, Path=BindingContext.ToggleActiveCommand}"
                                                   CommandParameter="{Binding .}"
                                                   IsVisible="{Binding IsSystem, Converter={StaticResource InverseBoolConverter}}" />
                                        <SwipeItem Text="Delete" 
                                                   Background="Red"
                                                   Command="{Binding Source={x:Reference CategoriesPageView}, Path=BindingContext.DeleteCategoryCommand}"
                                                   CommandParameter="{Binding .}"
                                                   IsVisible="{Binding IsSystem, Converter={StaticResource InverseBoolConverter}}" />
                                    </SwipeItems>
                                </SwipeView.RightItems>
                                <Border Style="{StaticResource CategoryItemFrameStyle}" Margin="0,8">
                                    <HorizontalStackLayout Spacing="16">
                                        <Border WidthRequest="48" HeightRequest="48"
                                               Background="{Binding CategoryColor, Converter={StaticResource ColorConverter}}"
                                               StrokeThickness="0"
                                               VerticalOptions="Center">
                                            <Border.StrokeShape>
                                                <Ellipse />
                                            </Border.StrokeShape>
                                            <Label Text="{Binding CategoryIcon}" VerticalOptions="Center" HorizontalOptions="Center" FontSize="20" />
                                        </Border>
                                        <VerticalStackLayout Spacing="4" VerticalOptions="Center" HorizontalOptions="Fill">
                                            <HorizontalStackLayout Spacing="8">
                                                <Label Text="{Binding Name}" Style="{StaticResource CategoryNameLabelStyle}" />
                                                <Label Text="🔒" IsVisible="{Binding IsSystem}" FontSize="12" />
                                                <Label Text="Inactive" Style="{StaticResource InactiveLabelStyle}" IsVisible="{Binding IsActive, Converter={StaticResource InverseBoolConverter}}" />
                                            </HorizontalStackLayout>
                                        </VerticalStackLayout>
                                    </HorizontalStackLayout>
                                </Border>
                            </SwipeView>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <CollectionView ItemsSource="{Binding IncomeCategories}"
                            IsVisible="{Binding SelectedTab, Converter={StaticResource CategoryTabVisibilityConverter}, ConverterParameter=Income}"
                            SelectionMode="None">
<CollectionView.ItemTemplate>
                        <DataTemplate>
                            <SwipeView>
                                <SwipeView.RightItems>
                                    <SwipeItems>
                                        <SwipeItem Text="Edit" 
                                                   Background="#0E6B4F"
                                                   Command="{Binding Source={x:Reference CategoriesPageView}, Path=BindingContext.EditCategoryCommand}"
                                                   CommandParameter="{Binding .}" />
                                        <SwipeItem Text="{Binding IsActive, Converter={StaticResource BoolToStringConverter}, ConverterParameter='Deactivate|Activate'}" 
                                                   Background="Orange"
                                                   Command="{Binding Source={x:Reference CategoriesPageView}, Path=BindingContext.ToggleActiveCommand}"
                                                   CommandParameter="{Binding .}"
                                                   IsVisible="{Binding IsSystem, Converter={StaticResource InverseBoolConverter}}" />
                                        <SwipeItem Text="Delete" 
                                                   Background="Red"
                                                   Command="{Binding Source={x:Reference CategoriesPageView}, Path=BindingContext.DeleteCategoryCommand}"
                                                   CommandParameter="{Binding .}"
                                                   IsVisible="{Binding IsSystem, Converter={StaticResource InverseBoolConverter}}" />
                                    </SwipeItems>
                                </SwipeView.RightItems>
                                <Border Style="{StaticResource CategoryItemFrameStyle}" Margin="0,8">
                                    <HorizontalStackLayout Spacing="16">
                                        <Border WidthRequest="48" HeightRequest="48"
                                               Background="{Binding CategoryColor, Converter={StaticResource ColorConverter}}"
                                               StrokeThickness="0"
                                               VerticalOptions="Center">
                                            <Border.StrokeShape>
                                                <Ellipse />
                                            </Border.StrokeShape>
                                            <Label Text="{Binding CategoryIcon}" VerticalOptions="Center" HorizontalOptions="Center" FontSize="20" />
                                        </Border>
                                        <VerticalStackLayout Spacing="4" VerticalOptions="Center" HorizontalOptions="Fill">
                                            <HorizontalStackLayout Spacing="8">
                                                <Label Text="{Binding Name}" Style="{StaticResource CategoryNameLabelStyle}" />
                                                <Label Text="🔒" IsVisible="{Binding IsSystem}" FontSize="12" />
                                                <Label Text="Inactive" Style="{StaticResource InactiveLabelStyle}" IsVisible="{Binding IsActive, Converter={StaticResource InverseBoolConverter}}" />
                                            </HorizontalStackLayout>
                                        </VerticalStackLayout>
                                    </HorizontalStackLayout>
                                </Border>
                            </SwipeView>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

            <!-- Add Category Button -->
            <Button Text="Add Category" Command="{Binding AddCategoryCommand}" Style="{StaticResource PrimaryButtonStyle}" Margin="16,0,16,16" />
        </VerticalStackLayout>
    </RefreshView>

        <!-- Toasts -->
        <controls:ToastHost />
    </Grid>

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Add" Command="{Binding AddCategoryCommand}" Priority="0">
            <ToolbarItem.IconImageSource>
                <FontImageSource Glyph="+" FontFamily="OpenSansRegular" Size="20" Color="White" />
            </ToolbarItem.IconImageSource>
        </ToolbarItem>
    </ContentPage.ToolbarItems>
</ContentPage>