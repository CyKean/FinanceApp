<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:FinanceApp.Mobile.ViewModels"
             xmlns:converters="clr-namespace:FinanceApp.Mobile.Converters"
             xmlns:controls="clr-namespace:FinanceApp.Mobile.Views.Controls"
             x:Class="FinanceApp.Mobile.Views.LoginPage"
             x:DataType="viewmodels:LoginViewModel"
             Title="{Binding Title}"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource FinoraLime}">

    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:InverseBoolConverter x:Key="InverseBoolConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*">
        <!-- Top bar: logo -->
        <HorizontalStackLayout Grid.Row="0" Padding="22,18,22,0" Spacing="8" VerticalOptions="Center">
            <Border WidthRequest="34" HeightRequest="34" Stroke="{StaticResource FinoraInk}" StrokeThickness="1.5" Background="Transparent" VerticalOptions="Center">
                <Border.StrokeShape><Ellipse /></Border.StrokeShape>
                <Label Text="◈" FontSize="18" FontAttributes="Bold" TextColor="{StaticResource FinoraInk}" HorizontalOptions="Center" VerticalOptions="Center" />
            </Border>
            <Label Text="Finora" FontSize="20" FontAttributes="Bold" TextColor="{StaticResource FinoraInk}" VerticalOptions="Center" />
            <Label Text="Finance Mobile App" FontSize="12" TextColor="{StaticResource FinoraInk}" Opacity="0.7" VerticalOptions="Center" />
            <Label Text="● ● ●" FontSize="10" TextColor="{StaticResource FinoraInk}" Opacity="0.5" VerticalOptions="Center" />
        </HorizontalStackLayout>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Spacing="0" Padding="22,8,22,28">
                <!-- Doodle hero. Laid out with real rows/columns: the previous
                     version absolutely positioned everything inside a fixed-height
                     Grid and the children were clipped out of existence. -->
                <Grid Margin="0,10,0,0" RowDefinitions="Auto,Auto" ColumnDefinitions="Auto,*,Auto" RowSpacing="14">
                    <Border Grid.Row="0" Grid.Column="0" Background="{StaticResource FinoraLime}" Stroke="{StaticResource FinoraInk}" StrokeThickness="1.5" Padding="12" HeightRequest="44" WidthRequest="44">
                        <Border.StrokeShape><Ellipse /></Border.StrokeShape>
                        <controls:FinoraIconView IconKey="trendup" Size="20" ShowBadge="False" Light="True" HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>

                    <Border Grid.Row="0" Grid.Column="1" Margin="12,0" Background="{StaticResource FinoraLime}" Stroke="{StaticResource FinoraInk}" StrokeThickness="1.5" Padding="16,10" HorizontalOptions="Center">
                        <Border.StrokeShape><RoundRectangle CornerRadius="12" /></Border.StrokeShape>
                        <controls:FinoraIconView IconKey="card" Size="18" ShowBadge="False" Light="True" HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>

                    <Border Grid.Row="0" Grid.Column="2" Background="{StaticResource FinoraLime}" Stroke="{StaticResource FinoraInk}" StrokeThickness="1.5" Padding="14,10" HorizontalOptions="End">
                        <Border.StrokeShape><RoundRectangle CornerRadius="10" /></Border.StrokeShape>
                        <VerticalStackLayout Spacing="5">
                            <BoxView HeightRequest="2" WidthRequest="22" Color="{StaticResource FinoraInk}" HorizontalOptions="End" />
                            <BoxView HeightRequest="2" WidthRequest="14" Color="{StaticResource FinoraInk}" HorizontalOptions="End" />
                        </VerticalStackLayout>
                    </Border>

                    <!-- wallet card, drawn with Lucide geometry rather than emoji
                         so it renders identically on every device -->
                    <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Background="#E7F49A" Stroke="{StaticResource FinoraInk}" StrokeThickness="2" Padding="20,16" HorizontalOptions="Center">
                        <Border.StrokeShape><RoundRectangle CornerRadius="20" /></Border.StrokeShape>
                        <Grid ColumnDefinitions="Auto,Auto" ColumnSpacing="16">
                            <VerticalStackLayout Spacing="10" VerticalOptions="Center">
                                <Border WidthRequest="24" HeightRequest="24" Background="{StaticResource FinoraInk}" StrokeThickness="0">
                                    <Border.StrokeShape><Ellipse /></Border.StrokeShape>
                                    <Label Text="○" TextColor="{StaticResource FinoraLime}" FontSize="12" HorizontalOptions="Center" VerticalOptions="Center" />
                                </Border>
                                <BoxView HeightRequest="2" WidthRequest="44" Color="{StaticResource FinoraInk}" />
                            </VerticalStackLayout>
                            <controls:FinoraIconView Grid.Column="1" IconKey="wallet" Size="58" ShowBadge="False" Light="True" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Grid>
                    </Border>
                </Grid>

                <!-- Headline -->
                <Label Text="Digital Banking" FontSize="38" FontAttributes="Bold" FontFamily="SpaceGroteskBold" TextColor="{StaticResource FinoraInk}" LineHeight="1.05" />
                <HorizontalStackLayout Spacing="10" VerticalOptions="Center">
                    <Label Text="Made for" FontSize="38" FontAttributes="Bold" FontFamily="SpaceGroteskBold" TextColor="{StaticResource FinoraInk}" VerticalOptions="Center" />
                    <Border Background="{StaticResource FinoraInk}" Stroke="{StaticResource FinoraInk}" StrokeThickness="1" Padding="16,8" VerticalOptions="Center">
                        <Border.StrokeShape><RoundRectangle CornerRadius="100" /></Border.StrokeShape>
                        <Label Text="→" FontSize="20" FontAttributes="Bold" TextColor="{StaticResource FinoraLime}" HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>
                </HorizontalStackLayout>
                <Label Text="Digital Users" FontSize="38" FontAttributes="Bold" FontFamily="SpaceGroteskBold" TextColor="{StaticResource FinoraInk}" />
                <Label Text="Spend, earn and track financial activity" FontSize="13" TextColor="{StaticResource FinoraInk}" Opacity="0.75" Margin="0,8,0,14" />

                <!-- Auth card -->
                <Border Background="{StaticResource FinoraCard}" Stroke="{StaticResource FinoraInk}" StrokeThickness="1.5" Padding="20" Margin="0,0,0,6">
                    <Border.StrokeShape><RoundRectangle CornerRadius="28" /></Border.StrokeShape>
                    <Border.Shadow><Shadow Brush="#161B16" Opacity="0.15" Radius="20" Offset="0,10" /></Border.Shadow>
                    <VerticalStackLayout Spacing="12">
                        <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                            <Label Text="Welcome back" IsVisible="{Binding IsRegisterMode, Converter={StaticResource InverseBoolConverter}}" FontSize="20" FontAttributes="Bold" TextColor="{StaticResource FinoraInk}" HorizontalOptions="Fill" VerticalOptions="Center" />
                            <Label Text="Create account" IsVisible="{Binding IsRegisterMode}" FontSize="20" FontAttributes="Bold" TextColor="{StaticResource FinoraInk}" HorizontalOptions="Fill" VerticalOptions="Center" />
                            <Border Background="{StaticResource FinoraLime}" Stroke="{StaticResource FinoraInk}" StrokeThickness="1.2" Padding="10,5" VerticalOptions="Center">
                                <Border.StrokeShape><RoundRectangle CornerRadius="100" /></Border.StrokeShape>
                                <Label Text="● Secure" FontSize="11" FontAttributes="Bold" TextColor="{StaticResource FinoraInk}" />
                            </Border>
                        </HorizontalStackLayout>
                        <Label Text="Login to continue" IsVisible="{Binding IsRegisterMode, Converter={StaticResource InverseBoolConverter}}" FontSize="13" TextColor="{StaticResource FinoraMuted}" />
                        <Label Text="Start tracking in seconds" IsVisible="{Binding IsRegisterMode}" FontSize="13" TextColor="{StaticResource FinoraMuted}" />
                        <Label Text="Accounts are kept on this device — register and sign in work with or without a connection." FontSize="12" TextColor="{StaticResource FinoraMuted}" Opacity="0.85" />

                        <VerticalStackLayout Spacing="6">
                            <Label Text="Email" Style="{StaticResource FormLabelStyle}" />
                            <Border Style="{StaticResource FieldBorderStyle}">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" VerticalOptions="Center">
                                    <controls:FinoraIconView IconKey="mail" Size="20" ShowBadge="False" Light="True" VerticalOptions="Center" />
                                    <Entry Grid.Column="1" Text="{Binding Email}" Keyboard="Email" Placeholder="you@example.com" BackgroundColor="Transparent" TextColor="{StaticResource FinoraInk}" HeightRequest="48" VerticalOptions="Center" ReturnType="Next" />
                                </Grid>
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="6">
                            <Label Text="Password" Style="{StaticResource FormLabelStyle}" />
                            <Border Style="{StaticResource FieldBorderStyle}">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" VerticalOptions="Center">
                                    <controls:FinoraIconView IconKey="lock" Size="20" ShowBadge="False" Light="True" VerticalOptions="Center" />
                                    <Entry Grid.Column="1" Text="{Binding Password}" IsPassword="True" Placeholder="Enter your password" BackgroundColor="Transparent" TextColor="{StaticResource FinoraInk}" HeightRequest="48" VerticalOptions="Center" ReturnType="Done" />
                                </Grid>
                            </Border>
                            <HorizontalStackLayout Spacing="8" VerticalOptions="Center" Margin="0,2,0,0">
                                <CheckBox IsChecked="{Binding IsRememberMe}" Color="{StaticResource FinoraInk}" VerticalOptions="Center" />
                                <Label Text="Remember me" FontSize="13" TextColor="{StaticResource FinoraInk}" VerticalOptions="Center" HorizontalOptions="Fill" />
                                <Label Text="Forgot Password?" FontSize="13" FontAttributes="Bold" TextColor="{StaticResource FinoraInk}" VerticalOptions="Center">
                                    <Label.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding ForgotPasswordCommand}" />
                                    </Label.GestureRecognizers>
                                </Label>
                            </HorizontalStackLayout>
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="6" IsVisible="{Binding IsRegisterMode}">
                            <Label Text="Confirm password" Style="{StaticResource FormLabelStyle}" />
                            <Border Style="{StaticResource FieldBorderStyle}">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" VerticalOptions="Center">
                                    <controls:FinoraIconView IconKey="lock" Size="20" ShowBadge="False" Light="True" VerticalOptions="Center" />
                                    <Entry Grid.Column="1" Text="{Binding ConfirmPassword}" IsPassword="True" Placeholder="Repeat your password" BackgroundColor="Transparent" TextColor="{StaticResource FinoraInk}" HeightRequest="48" VerticalOptions="Center" ReturnType="Done" />
                                </Grid>
                            </Border>
                        </VerticalStackLayout>

                        <Label Text="{Binding ErrorMessage}" Style="{StaticResource ErrorLabelStyle}" IsVisible="{Binding HasError}" />

                        <Button Text="Login →" Command="{Binding SubmitCommand}" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}" IsVisible="{Binding IsRegisterMode, Converter={StaticResource InverseBoolConverter}}" Style="{StaticResource PrimaryButtonStyle}" />
                        <Button Text="Create Account →" Command="{Binding SubmitCommand}" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}" IsVisible="{Binding IsRegisterMode}" Style="{StaticResource PrimaryButtonStyle}" />

                        <HorizontalStackLayout Spacing="12" VerticalOptions="Center" Margin="0,2">
                            <BoxView Style="{StaticResource DividerStyle}" VerticalOptions="Center" HorizontalOptions="Fill" />
                            <Label Text="or" Style="{StaticResource MutedLabelStyle}" VerticalOptions="Center" />
                            <BoxView Style="{StaticResource DividerStyle}" VerticalOptions="Center" HorizontalOptions="Fill" />
                        </HorizontalStackLayout>

                        <Button Text="Need an account? Register" Command="{Binding ToggleModeCommand}" IsVisible="{Binding IsRegisterMode, Converter={StaticResource InverseBoolConverter}}" Style="{StaticResource OutlineButtonStyle}" />
                        <Button Text="Have an account? Login" Command="{Binding ToggleModeCommand}" IsVisible="{Binding IsRegisterMode}" Style="{StaticResource OutlineButtonStyle}" />
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </ScrollView>

        <!-- The old footer bar is gone: its arrow FAB and its "Let's Start"
             label both ran SubmitCommand (duplicating the Login button) and
             its "New here? Register" label duplicated the in-card toggle. It
             also stole the height that made the auth card look truncated. -->

        <!-- Loading overlay -->
        <controls:LoadingOverlay Grid.Row="0" Grid.RowSpan="2" IsLoading="{Binding IsBusy}" Text="{Binding BusyMessage}" />
        <controls:ToastHost Grid.Row="0" Grid.RowSpan="2" />
    </Grid>
</ContentPage>
