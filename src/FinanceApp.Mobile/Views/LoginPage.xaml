<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:FinanceApp.Mobile.ViewModels"
             xmlns:converters="clr-namespace:FinanceApp.Mobile.Converters"
             xmlns:controls="clr-namespace:FinanceApp.Mobile.Views.Controls"
             x:Class="FinanceApp.Mobile.Views.LoginPage"
             x:DataType="viewmodels:LoginViewModel"
             Title="{Binding Title}"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource PayLime}">

    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:InverseBoolConverter x:Key="InverseBoolConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*,Auto">
        <!-- Top bar: logo -->
        <HorizontalStackLayout Grid.Row="0" Padding="22,18,22,0" Spacing="8" VerticalOptions="Center">
            <Border WidthRequest="34" HeightRequest="34" Stroke="{StaticResource PayInk}" StrokeThickness="1.5" Background="Transparent" VerticalOptions="Center">
                <Border.StrokeShape><Ellipse /></Border.StrokeShape>
                <Label Text="◈" FontSize="18" FontAttributes="Bold" TextColor="{StaticResource PayInk}" HorizontalOptions="Center" VerticalOptions="Center" />
            </Border>
            <Label Text="Paytin" FontSize="20" FontAttributes="Bold" TextColor="{StaticResource PayInk}" VerticalOptions="Center" />
            <Label Text="Finance Mobile App" FontSize="12" TextColor="{StaticResource PayInk}" Opacity="0.7" HorizontalOptions="Fill" HorizontalTextAlignment="Center" VerticalOptions="Center" />
            <Label Text="● ● ●" FontSize="10" TextColor="{StaticResource PayInk}" Opacity="0.5" VerticalOptions="Center" />
        </HorizontalStackLayout>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Spacing="0" Padding="22,8,22,12">
                <!-- Doodle hero -->
                <Grid HeightRequest="300" Margin="0,6,0,0">
                    <Border Background="#BFE33F" Opacity="0.45" HeightRequest="230" WidthRequest="230" HorizontalOptions="Center" VerticalOptions="Center" StrokeThickness="0">
                        <Border.StrokeShape><Ellipse /></Border.StrokeShape>
                    </Border>
                    <!-- floating chips -->
                    <Border HorizontalOptions="Start" VerticalOptions="Start" Margin="6,18,0,0" Background="{StaticResource PayLime}" Stroke="{StaticResource PayInk}" StrokeThickness="1.5" Padding="10" HeightRequest="44" WidthRequest="44">
                        <Border.StrokeShape><Ellipse /></Border.StrokeShape>
                        <Label Text="$" FontSize="20" FontAttributes="Bold" TextColor="{StaticResource PayInk}" HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>
                    <Border HorizontalOptions="Center" VerticalOptions="Start" Margin="0,8,0,0" Background="{StaticResource PayLime}" Stroke="{StaticResource PayInk}" StrokeThickness="1.5" Padding="8,6">
                        <Border.StrokeShape><RoundRectangle CornerRadius="10" /></Border.StrokeShape>
                        <Label Text="▦▦" FontSize="16" TextColor="{StaticResource PayInk}" HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>
                    <Border HorizontalOptions="End" VerticalOptions="Start" Margin="0,26,4,0" Background="{StaticResource PayLime}" Stroke="{StaticResource PayInk}" StrokeThickness="1.5" Padding="10,8" Rotation="-12">
                        <Border.StrokeShape><RoundRectangle CornerRadius="8" /></Border.StrokeShape>
                        <VerticalStackLayout Spacing="0">
                            <Label Text="━━" FontSize="10" TextColor="{StaticResource PayInk}" />
                            <Label Text="▭" FontSize="12" TextColor="{StaticResource PayInk}" />
                        </VerticalStackLayout>
                    </Border>
                    <!-- wallet guy (emoji composition, stands in for illustration) -->
                    <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="0">
                        <Label Text="👆" FontSize="44" HorizontalOptions="Start" Margin="10,0,0,0" />
                        <Border Background="#E7F49A" Stroke="{StaticResource PayInk}" StrokeThickness="2" Padding="22,16" WidthRequest="210">
                            <Border.StrokeShape><RoundRectangle CornerRadius="18" /></Border.StrokeShape>
                            <VerticalStackLayout Spacing="6">
                                <HorizontalStackLayout Spacing="8">
                                    <Border WidthRequest="22" HeightRequest="22" Background="{StaticResource PayInk}" StrokeThickness="0" VerticalOptions="Center">
                                        <Border.StrokeShape><Ellipse /></Border.StrokeShape>
                                        <Label Text="○" TextColor="{StaticResource PayLime}" FontSize="12" HorizontalOptions="Center" VerticalOptions="Center" />
                                    </Border>
                                    <BoxView HeightRequest="2" WidthRequest="90" Color="{StaticResource PayInk}" VerticalOptions="Center" />
                                </HorizontalStackLayout>
                                <Label Text="(( ))" FontSize="22" TextColor="{StaticResource PayInk}" HorizontalOptions="Center" />
                                <Label Text="👛" FontSize="64" HorizontalOptions="Center" />
                            </VerticalStackLayout>
                        </Border>
                        <Label Text="🧾" FontSize="30" HorizontalOptions="Start" Margin="0,-10,0,0" Rotation="-18" />
                    </VerticalStackLayout>
                    <Border HorizontalOptions="End" VerticalOptions="End" Margin="0,0,18,40" Background="{StaticResource PayLime}" Stroke="{StaticResource PayInk}" StrokeThickness="1.5" HeightRequest="34" WidthRequest="34">
                        <Border.StrokeShape><Ellipse /></Border.StrokeShape>
                        <Label Text="$" FontAttributes="Bold" TextColor="{StaticResource PayInk}" HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>
                </Grid>

                <!-- Headline -->
                <Label Text="Digital Banking" FontSize="38" FontAttributes="Bold" FontFamily="SpaceGroteskBold" TextColor="{StaticResource PayInk}" LineHeight="1.05" />
                <HorizontalStackLayout Spacing="10" VerticalOptions="Center">
                    <Label Text="Made for" FontSize="38" FontAttributes="Bold" FontFamily="SpaceGroteskBold" TextColor="{StaticResource PayInk}" VerticalOptions="Center" />
                    <Border Background="{StaticResource PayInk}" Stroke="{StaticResource PayInk}" StrokeThickness="1" Padding="16,8" VerticalOptions="Center">
                        <Border.StrokeShape><RoundRectangle CornerRadius="100" /></Border.StrokeShape>
                        <Label Text="→" FontSize="20" FontAttributes="Bold" TextColor="{StaticResource PayLime}" HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>
                </HorizontalStackLayout>
                <Label Text="Digital Users" FontSize="38" FontAttributes="Bold" FontFamily="SpaceGroteskBold" TextColor="{StaticResource PayInk}" />
                <Label Text="Spend, earn and track financial activity" FontSize="13" TextColor="{StaticResource PayInk}" Opacity="0.75" Margin="0,8,0,14" />

                <!-- Auth card -->
                <Border Background="{StaticResource PayCard}" Stroke="{StaticResource PayInk}" StrokeThickness="1.5" Padding="20" Margin="0,0,0,6">
                    <Border.StrokeShape><RoundRectangle CornerRadius="28" /></Border.StrokeShape>
                    <Border.Shadow><Shadow Brush="#161B16" Opacity="0.15" Radius="20" Offset="0,10" /></Border.Shadow>
                    <VerticalStackLayout Spacing="12">
                        <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                            <Label Text="Welcome back" IsVisible="{Binding IsRegisterMode, Converter={StaticResource InverseBoolConverter}}" FontSize="20" FontAttributes="Bold" TextColor="{StaticResource PayInk}" HorizontalOptions="Fill" VerticalOptions="Center" />
                            <Label Text="Create account" IsVisible="{Binding IsRegisterMode}" FontSize="20" FontAttributes="Bold" TextColor="{StaticResource PayInk}" HorizontalOptions="Fill" VerticalOptions="Center" />
                            <Border Background="{StaticResource PayLime}" Stroke="{StaticResource PayInk}" StrokeThickness="1.2" Padding="10,5" VerticalOptions="Center">
                                <Border.StrokeShape><RoundRectangle CornerRadius="100" /></Border.StrokeShape>
                                <Label Text="● Secure" FontSize="11" FontAttributes="Bold" TextColor="{StaticResource PayInk}" />
                            </Border>
                        </HorizontalStackLayout>
                        <Label Text="Login to continue" IsVisible="{Binding IsRegisterMode, Converter={StaticResource InverseBoolConverter}}" FontSize="13" TextColor="#6F7668" />
                        <Label Text="Start tracking in seconds" IsVisible="{Binding IsRegisterMode}" FontSize="13" TextColor="#6F7668" />

                        <VerticalStackLayout Spacing="6">
                            <Label Text="Email" Style="{StaticResource FormLabelStyle}" />
                            <Border Style="{StaticResource FieldBorderStyle}">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" VerticalOptions="Center">
                                    <controls:PaytinIconView IconKey="mail" Size="20" ShowBadge="False" Light="True" VerticalOptions="Center" />
                                    <Entry Grid.Column="1" Text="{Binding Email}" Keyboard="Email" Placeholder="you@example.com" BackgroundColor="Transparent" TextColor="{StaticResource PayInk}" HeightRequest="48" VerticalOptions="Center" ReturnType="Next" />
                                </Grid>
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="6">
                            <Label Text="Password" Style="{StaticResource FormLabelStyle}" />
                            <Border Style="{StaticResource FieldBorderStyle}">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" VerticalOptions="Center">
                                    <controls:PaytinIconView IconKey="lock" Size="20" ShowBadge="False" Light="True" VerticalOptions="Center" />
                                    <Entry Grid.Column="1" Text="{Binding Password}" IsPassword="True" Placeholder="Enter your password" BackgroundColor="Transparent" TextColor="{StaticResource PayInk}" HeightRequest="48" VerticalOptions="Center" ReturnType="Done" />
                                </Grid>
                            </Border>
                            <HorizontalStackLayout Spacing="8" VerticalOptions="Center" Margin="0,2,0,0">
                                <CheckBox IsChecked="{Binding IsRememberMe}" Color="{StaticResource PayInk}" VerticalOptions="Center" />
                                <Label Text="Remember me" FontSize="13" TextColor="{StaticResource PayInk}" VerticalOptions="Center" HorizontalOptions="Fill" />
                                <Label Text="Forgot Password?" FontSize="13" FontAttributes="Bold" TextColor="{StaticResource PayInk}" VerticalOptions="Center">
                                    <Label.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding ForgotPasswordCommand}" />
                                    </Label.GestureRecognizers>
                                </Label>
                            </HorizontalStackLayout>
                        </VerticalStackLayout>

                        <Label Text="{Binding ErrorMessage}" Style="{StaticResource ErrorLabelStyle}" IsVisible="{Binding HasError}" />

                        <Button Text="Login →" Command="{Binding SubmitCommand}" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}" IsVisible="{Binding IsRegisterMode, Converter={StaticResource InverseBoolConverter}}" Style="{StaticResource PrimaryButtonStyle}" />
                        <Button Text="Create Account →" Command="{Binding SubmitCommand}" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}" IsVisible="{Binding IsRegisterMode}" Style="{StaticResource PrimaryButtonStyle}" />

                        <HorizontalStackLayout Spacing="12" VerticalOptions="Center" Margin="0,2">
                            <BoxView Style="{StaticResource DividerStyle}" VerticalOptions="Center" HorizontalOptions="Fill" />
                            <Label Text="or" Style="{StaticResource MutedLabelStyle}" VerticalOptions="Center" />
                            <BoxView Style="{StaticResource DividerStyle}" VerticalOptions="Center" HorizontalOptions="Fill" />
                        </HorizontalStackLayout>

                        <Button Text="Need an account? Register" Command="{Binding ToggleModeCommand}" IsVisible="{Binding IsRegisterMode, Converter={StaticResource InverseBoolConverter}}" Style="{StaticResource OutlineButtonStyle}" />
                        <Button Text="Have an account? Login" Command="{Binding ToggleModeCommand}" IsVisible="{Binding IsRegisterMode}" Style="{StaticResource OutlineButtonStyle}" />
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </ScrollView>

        <!-- Bottom Skip / Let's Start -->
        <Grid Grid.Row="2" ColumnDefinitions="Auto,*,Auto" Padding="22,8,22,20" VerticalOptions="Center" BackgroundColor="{StaticResource PayLime}">
            <Label Grid.Column="0" Text="New here? Register" FontSize="14" FontAttributes="Bold" TextColor="{StaticResource PayInk}" VerticalOptions="Center"
                   IsVisible="{Binding IsRegisterMode, Converter={StaticResource InverseBoolConverter}}">
                <Label.GestureRecognizers><TapGestureRecognizer Command="{Binding ToggleModeCommand}" /></Label.GestureRecognizers>
            </Label>
            <Label Grid.Column="0" Text="Have an account? Login" FontSize="14" FontAttributes="Bold" TextColor="{StaticResource PayInk}" VerticalOptions="Center"
                   IsVisible="{Binding IsRegisterMode}">
                <Label.GestureRecognizers><TapGestureRecognizer Command="{Binding ToggleModeCommand}" /></Label.GestureRecognizers>
            </Label>
            <Label Grid.Column="1" Text="Let's Start" FontSize="14" FontAttributes="Bold" TextColor="{StaticResource PayInk}" HorizontalOptions="End" VerticalOptions="Center" Margin="0,0,10,0">
                <Label.GestureRecognizers><TapGestureRecognizer Command="{Binding SubmitCommand}" /></Label.GestureRecognizers>
            </Label>
            <Border Grid.Column="2" WidthRequest="56" HeightRequest="56" Background="{StaticResource PayInk}" Stroke="{StaticResource PayInk}" StrokeThickness="1" VerticalOptions="Center">
                <Border.StrokeShape><Ellipse /></Border.StrokeShape>
                <Label Text="↗" FontSize="24" TextColor="{StaticResource PayLime}" HorizontalOptions="Center" VerticalOptions="Center">
                    <Label.GestureRecognizers><TapGestureRecognizer Command="{Binding SubmitCommand}" /></Label.GestureRecognizers>
                </Label>
            </Border>
        </Grid>

        <!-- Loading overlay -->
        <controls:LoadingOverlay Grid.Row="0" Grid.RowSpan="3" IsLoading="{Binding IsBusy}" Text="{Binding BusyMessage}" />
        <controls:ToastHost Grid.Row="0" Grid.RowSpan="3" />
    </Grid>
</ContentPage>
