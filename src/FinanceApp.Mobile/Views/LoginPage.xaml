<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:FinanceApp.Mobile.ViewModels"
             xmlns:converters="clr-namespace:FinanceApp.Mobile.Converters"
             xmlns:controls="clr-namespace:FinanceApp.Mobile.Views.Controls"
             x:Class="FinanceApp.Mobile.Views.LoginPage"
             x:DataType="viewmodels:LoginViewModel"
             Title="{Binding Title}"
             Shell.NavBarIsVisible="False">

    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:InverseBoolConverter x:Key="InverseBoolConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <ContentPage.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" Offset="0.0" />
            <GradientStop Color="{AppThemeBinding Light={StaticResource PrimaryDark}, Dark={StaticResource BackgroundDark}}" Offset="1.0" />
        </LinearGradientBrush>
    </ContentPage.Background>

    <Grid>
        <ScrollView>
        <VerticalStackLayout Spacing="0" Padding="20,44,20,24" VerticalOptions="Fill">
            <!-- Logo mark on white tile for contrast -->
            <Border HorizontalOptions="Center"
                    HeightRequest="108"
                    WidthRequest="108"
                    Background="White"
                    Padding="14">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="30" />
                </Border.StrokeShape>
                <Border.Shadow>
                    <Shadow Brush="Black" Opacity="0.25" Radius="20" Offset="0,10" />
                </Border.Shadow>
                <Image Source="financelogo"
                       Aspect="AspectFit"
                       HorizontalOptions="Center"
                       VerticalOptions="Center" />
            </Border>

            <Label Text="Your Personal Finance Manager"
                   FontSize="15"
                   TextColor="White"
                   Opacity="0.9"
                   HorizontalOptions="Center"
                   Margin="0,16,0,24" />

            <!-- Auth card -->
            <Border Style="{StaticResource CardFrameStyle}" Padding="22">
                <VerticalStackLayout Spacing="14">
                    <Label Text="Welcome back"
                           IsVisible="{Binding IsRegisterMode, Converter={StaticResource InverseBoolConverter}}"
                           Style="{StaticResource TitleLabelStyle}" />
                    <Label Text="Create your account"
                           IsVisible="{Binding IsRegisterMode}"
                           Style="{StaticResource TitleLabelStyle}" />
                    <Label Text="Login to continue"
                           IsVisible="{Binding IsRegisterMode, Converter={StaticResource InverseBoolConverter}}"
                           Style="{StaticResource MutedLabelStyle}" />
                    <Label Text="Start tracking in seconds"
                           IsVisible="{Binding IsRegisterMode}"
                           Style="{StaticResource MutedLabelStyle}" />

                    <!-- Email -->
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Email" Style="{StaticResource FormLabelStyle}" />
                        <Border Style="{StaticResource FieldBorderStyle}">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" VerticalOptions="Center">
                                <Label Text="✉️"
                                       FontSize="18"
                                       VerticalOptions="Center" />
                                <Entry Grid.Column="1"
                                       Text="{Binding Email}"
                                       Keyboard="Email"
                                       Placeholder="you@example.com"
                                       BackgroundColor="Transparent"
                                       TextColor="{AppThemeBinding Light={StaticResource OnSurface}, Dark={StaticResource OnSurfaceDark}}"
                                       HeightRequest="48"
                                       VerticalOptions="Center"
                                       ReturnType="Next" />
                            </Grid>
                        </Border>
                    </VerticalStackLayout>

                    <!-- Password -->
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Password" Style="{StaticResource FormLabelStyle}" />
                        <Border Style="{StaticResource FieldBorderStyle}">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" VerticalOptions="Center">
                                <Label Text="🔒"
                                       FontSize="18"
                                       VerticalOptions="Center" />
                                <Entry Grid.Column="1"
                                       Text="{Binding Password}"
                                       IsPassword="True"
                                       Placeholder="Enter your password"
                                       BackgroundColor="Transparent"
                                       TextColor="{AppThemeBinding Light={StaticResource OnSurface}, Dark={StaticResource OnSurfaceDark}}"
                                       HeightRequest="48"
                                       VerticalOptions="Center"
                                       ReturnType="Done" />
                            </Grid>
                        </Border>

                        <HorizontalStackLayout Spacing="8" VerticalOptions="Center" Margin="0,4,0,0">
                            <CheckBox IsChecked="{Binding IsRememberMe}"
                                      Color="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryLight}}"
                                      VerticalOptions="Center" />
                            <Label Text="Remember me"
                                   Style="{StaticResource BodyLabelStyle}"
                                   VerticalOptions="Center"
                                   HorizontalOptions="Fill" />
                            <Label Text="Forgot Password?"
                                   Style="{StaticResource ForgotPasswordLabelStyle}"
                                   VerticalOptions="Center">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding ForgotPasswordCommand}" />
                                </Label.GestureRecognizers>
                            </Label>
                        </HorizontalStackLayout>
                    </VerticalStackLayout>

                    <!-- Error Message -->
                    <Label Text="{Binding ErrorMessage}"
                           Style="{StaticResource ErrorLabelStyle}"
                           IsVisible="{Binding HasError}" />

                    <!-- Login submit (visible in login mode) -->
                    <Button Text="Login"
                            Command="{Binding SubmitCommand}"
                            IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}"
                            IsVisible="{Binding IsRegisterMode, Converter={StaticResource InverseBoolConverter}}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            TextColor="White" />

                    <!-- Register submit (visible in register mode) -->
                    <Button Text="Create Account"
                            Command="{Binding SubmitCommand}"
                            IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}"
                            IsVisible="{Binding IsRegisterMode}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            TextColor="White" />

                    <!-- Divider -->
                    <HorizontalStackLayout Spacing="12" VerticalOptions="Center" Margin="0,4">
                        <BoxView Style="{StaticResource DividerStyle}" VerticalOptions="Center" HorizontalOptions="Fill" />
                        <Label Text="or" Style="{StaticResource MutedLabelStyle}" VerticalOptions="Center" />
                        <BoxView Style="{StaticResource DividerStyle}" VerticalOptions="Center" HorizontalOptions="Fill" />
                    </HorizontalStackLayout>

                    <!-- Switch to register -->
                    <Button Text="Need an account? Register"
                            Command="{Binding ToggleModeCommand}"
                            IsVisible="{Binding IsRegisterMode, Converter={StaticResource InverseBoolConverter}}"
                            Style="{StaticResource OutlineButtonStyle}" />

                    <!-- Switch back to login -->
                    <Button Text="Have an account? Login"
                            Command="{Binding ToggleModeCommand}"
                            IsVisible="{Binding IsRegisterMode}"
                            Style="{StaticResource OutlineButtonStyle}" />
                </VerticalStackLayout>
            </Border>

            <Label Text="Secure • Private • Yours • build 20260927d"
                   FontSize="12"
                   TextColor="White"
                   Opacity="0.7"
                   HorizontalOptions="Center"
                   Margin="0,20,0,0" />
        </VerticalStackLayout>
    </ScrollView>

        <!-- Loading overlay -->
        <controls:LoadingOverlay IsLoading="{Binding IsBusy}" Text="{Binding BusyMessage}" />

        <!-- Toasts -->
        <controls:ToastHost />
    </Grid>
</ContentPage>
