<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:FinanceApp.Mobile.ViewModels"
             xmlns:dtos="clr-namespace:FinanceApp.Application.DTOs;assembly=FinanceApp.Application"
             xmlns:converters="clr-namespace:FinanceApp.Mobile.Converters"
             xmlns:controls="clr-namespace:FinanceApp.Mobile.Views.Controls"
             x:Class="FinanceApp.Mobile.Views.ChatPage"
             x:DataType="viewmodels:ChatViewModel"
             Title="{Binding Title}"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource PayCream}"
             x:Name="ChatPageView">

    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:InverseBoolConverter x:Key="InverseBoolConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid>
        <Grid RowDefinitions="Auto,*,Auto,Auto,Auto,Auto">

            <!-- Header -->
            <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" Padding="18,14,18,8">
                <Border WidthRequest="46" HeightRequest="46"
                        Background="{StaticResource PayCard}"
                        Stroke="{StaticResource PayInk}" StrokeThickness="1.5"
                        VerticalOptions="Center">
                    <Border.StrokeShape>
                        <Ellipse />
                    </Border.StrokeShape>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnBackTapped" />
                    </Border.GestureRecognizers>
                    <Label Text="←"
                           FontSize="20"
                           FontAttributes="Bold"
                           TextColor="{StaticResource PayInk}"
                           VerticalOptions="Center"
                           HorizontalOptions="Center" />
                </Border>

                <VerticalStackLayout Grid.Column="1" Spacing="0" VerticalOptions="Center">
                    <Label Text="AI Assistant" FontSize="18" FontAttributes="Bold" FontFamily="SpaceGroteskBold" TextColor="{StaticResource PayInk}" />
                    <HorizontalStackLayout Spacing="5" VerticalOptions="Center">
                        <Label Text="●" FontSize="12" TextColor="{StaticResource PayLimeDark}" VerticalOptions="Center"
                               IsVisible="{Binding IsConfigured}" />
                        <Label Text="●" FontSize="12" TextColor="{StaticResource Error}" VerticalOptions="Center"
                               IsVisible="{Binding IsConfigured, Converter={StaticResource InverseBoolConverter}}" />
                        <Label Text="{Binding StatusLine}" FontSize="12" TextColor="#6F7668" VerticalOptions="Center" />
                    </HorizontalStackLayout>
                </VerticalStackLayout>

                <controls:PaytinIconView Grid.Column="2" IconKey="trash" Size="46" VerticalOptions="Center">
                    <controls:PaytinIconView.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ClearChatCommand}" />
                    </controls:PaytinIconView.GestureRecognizers>
                </controls:PaytinIconView>
            </Grid>

            <!-- Messages -->
            <CollectionView Grid.Row="1"
                            x:Name="MessagesCollectionView"
                            ItemsSource="{Binding Messages}"
                            SelectionMode="None"
                            Margin="16,4">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="dtos:ChatMessageDto">
                        <Grid Margin="0,4" ColumnDefinitions="*,*">
                            <Border Grid.Column="1"
                                    IsVisible="{Binding IsUser}"
                                    HorizontalOptions="End"
                                    MaximumWidthRequest="280"
                                    Background="{StaticResource PayInk}"
                                    Stroke="{StaticResource PayInk}" StrokeThickness="1.5"
                                    Padding="14,10">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="22,22,6,22" />
                                </Border.StrokeShape>
                                <VerticalStackLayout Spacing="3">
                                    <Label Text="{Binding Content}"
                                           TextColor="White"
                                           FontSize="15"
                                           LineBreakMode="WordWrap" />
                                    <Label Text="{Binding TimeLabel}"
                                           TextColor="{StaticResource PayLime}"
                                           Opacity="0.8"
                                           FontSize="11"
                                           HorizontalTextAlignment="End" />
                                </VerticalStackLayout>
                            </Border>

                            <Border Grid.Column="0"
                                    IsVisible="{Binding IsUser, Converter={StaticResource InverseBoolConverter}}"
                                    HorizontalOptions="Start"
                                    MaximumWidthRequest="300"
                                    Background="{StaticResource PayCard}"
                                    Stroke="{StaticResource PayInk}" StrokeThickness="1.5"
                                    Padding="14,10">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="22,22,22,6" />
                                </Border.StrokeShape>
                                <VerticalStackLayout Spacing="3">
                                    <Label Text="{Binding Content}"
                                           TextColor="{AppThemeBinding Light={StaticResource OnSurface}, Dark={StaticResource OnSurfaceDark}}"
                                           FontSize="15"
                                           LineBreakMode="WordWrap" />
                                    <Label Text="answered by cloud AI"
                                           IsVisible="{Binding UsedCloud}"
                                           TextColor="{StaticResource Warning}"
                                           FontSize="10"
                                           FontAttributes="Italic" />
                                    <Label Text="{Binding TimeLabel}"
                                           TextColor="{AppThemeBinding Light={StaticResource OnSurfaceVariant}, Dark={StaticResource OnSurfaceVariantDark}}"
                                           FontSize="11"
                                           HorizontalTextAlignment="End" />
                                </VerticalStackLayout>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
                <CollectionView.EmptyView>
                    <controls:PaytinEmptyState Title="Ask me anything"
                                             Subtitle="Questions about your budgets, spending and savings - plus general finance topics"
                                             IconKey="bot" />
                </CollectionView.EmptyView>
            </CollectionView>

            <!-- Typing indicator -->
            <Grid Grid.Row="2"
                  Padding="16,2"
                  ColumnDefinitions="Auto,Auto"
                  ColumnSpacing="8"
                  HorizontalOptions="Start"
                  IsVisible="{Binding IsTyping}">
                <ActivityIndicator IsRunning="{Binding IsTyping}"
                                   Color="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryLight}}"
                                   HeightRequest="18"
                                   WidthRequest="18"
                                   VerticalOptions="Center" />
                <Label Grid.Column="1"
                       Text="Thinking..."
                       Style="{StaticResource MutedLabelStyle}"
                       VerticalOptions="Center" />
            </Grid>

            <!-- Quick replies (shown before the first message) -->
            <CollectionView Grid.Row="3"
                            ItemsSource="{Binding QuickReplies}"
                            ItemsLayout="HorizontalList"
                            HeightRequest="52"
                            SelectionMode="None"
                            Margin="16,6"
                            IsVisible="{Binding HasMessages, Converter={StaticResource InverseBoolConverter}}">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                        <Border Padding="14,8"
                                Margin="0,0,8,0"
                                Background="{StaticResource PayLime}"
                                Stroke="{StaticResource PayInk}"
                                StrokeThickness="1.5">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="100" />
                            </Border.StrokeShape>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding Source={x:Reference ChatPageView}, Path=BindingContext.SendQuickReplyCommand}"
                                                      CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>
                            <Label Text="{Binding .}"
                                   FontSize="13"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource PayInk}" />
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <!-- Error banner -->
            <Border Grid.Row="4"
                    Margin="18,0,18,8"
                    Padding="12,8"
                    Background="{StaticResource ErrorContainer}"
                    Stroke="{StaticResource Error}"
                    StrokeThickness="1.2"
                    IsVisible="{Binding HasError}">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="16" />
                </Border.StrokeShape>
                <Label Text="{Binding ErrorMessage}"
                       FontSize="12"
                       TextColor="{StaticResource OnErrorContainer}" />
            </Border>

            <!-- Composer -->
            <Border Grid.Row="5"
                    Margin="18,6,18,18"
                    Padding="14,8,8,8"
                    Background="{StaticResource PayCard}"
                    Stroke="{StaticResource PayInk}"
                    StrokeThickness="1.5">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="28" />
                </Border.StrokeShape>
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <Editor x:Name="ComposerEditor"
                            Grid.Column="0"
                            Text="{Binding Draft}"
                            Placeholder="Ask about your money..."
                            AutoSize="TextChanges"
                            HeightRequest="44"
                            MinimumHeightRequest="44"
                            MaximumHeightRequest="110"
                            FontSize="15"
                            BackgroundColor="Transparent"
                            VerticalOptions="Center" />
                    <Button Grid.Column="1"
                            Text="&#x27A4;"
                            Command="{Binding SendDraftCommand}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            WidthRequest="52"
                            HeightRequest="44"
                            Padding="0"
                            IsEnabled="{Binding IsTyping, Converter={StaticResource InverseBoolConverter}}"
                            TextColor="White" />
                </Grid>
            </Border>
        </Grid>

        <!-- Toasts -->
        <controls:ToastHost />

        <!-- Custom confirmation modal -->
        <controls:ConfirmModalHost />
    </Grid>
</ContentPage>
