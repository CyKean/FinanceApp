<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:FinanceApp.Mobile.ViewModels"
             xmlns:dtos="clr-namespace:FinanceApp.Application.DTOs;assembly=FinanceApp.Application"
             xmlns:converters="clr-namespace:FinanceApp.Mobile.Converters"
             xmlns:controls="clr-namespace:FinanceApp.Mobile.Views.Controls"
             x:Class="FinanceApp.Mobile.Views.ChatPage"
             x:DataType="viewmodels:ChatViewModel"
             Title="{Binding Title}"
             Shell.NavBarIsVisible="False"
             x:Name="ChatPageView">

    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:InverseBoolConverter x:Key="InverseBoolConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid>
        <Grid RowDefinitions="Auto,*,Auto,Auto,Auto">

            <!-- Header -->
            <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" Padding="16,16,16,8">
                <Border Padding="14,9"
                        Background="{AppThemeBinding Light={StaticResource SurfaceContainerLow}, Dark={StaticResource SurfaceContainerLowDark}}"
                        StrokeThickness="0"
                        VerticalOptions="Center">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="14" />
                    </Border.StrokeShape>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnBackTapped" />
                    </Border.GestureRecognizers>
                    <HorizontalStackLayout Spacing="5" VerticalOptions="Center">
                        <Label Text="&#x2039;"
                               FontSize="22"
                               FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryLight}}"
                               VerticalOptions="Center" />
                        <Label Text="Back"
                               FontSize="14"
                               FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryLight}}"
                               VerticalOptions="Center" />
                    </HorizontalStackLayout>
                </Border>

                <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                    <Label Text="AI Assistant" Style="{StaticResource TitleLabelStyle}" />
                    <Label Text="Your money, and money basics" Style="{StaticResource MutedLabelStyle}" />
                </VerticalStackLayout>

                <Border Grid.Column="2"
                        Padding="11,9"
                        Background="{AppThemeBinding Light={StaticResource SurfaceContainerLow}, Dark={StaticResource SurfaceContainerLowDark}}"
                        StrokeThickness="0"
                        VerticalOptions="Center">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="14" />
                    </Border.StrokeShape>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ClearChatCommand}" />
                    </Border.GestureRecognizers>
                    <Label Text="&#x1F5D1;&#xFE0F;"
                           FontSize="18"
                           VerticalOptions="Center"
                           HorizontalOptions="Center" />
                </Border>
            </Grid>

            <!-- Messages -->
            <CollectionView Grid.Row="1"
                            x:Name="MessagesCollectionView"
                            ItemsSource="{Binding Messages}"
                            SelectionMode="None"
                            Margin="16,4">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="dtos:ChatMessageDto">
                        <Grid Margin="0,4" ColumnDefinitions="*,*">
                            <Border Grid.Column="1"
                                    IsVisible="{Binding IsUser}"
                                    HorizontalOptions="End"
                                    MaximumWidthRequest="280"
                                    BackgroundColor="#0E6B4F"
                                    Padding="12,8"
                                    StrokeThickness="0">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="16,16,4,16" />
                                </Border.StrokeShape>
                                <VerticalStackLayout Spacing="3">
                                    <Label Text="{Binding Content}"
                                           TextColor="White"
                                           FontSize="15"
                                           LineBreakMode="WordWrap" />
                                    <Label Text="{Binding TimeLabel}"
                                           TextColor="#CCFFFFFF"
                                           FontSize="11"
                                           HorizontalTextAlignment="End" />
                                </VerticalStackLayout>
                            </Border>

                            <Border Grid.Column="0"
                                    IsVisible="{Binding IsUser, Converter={StaticResource InverseBoolConverter}}"
                                    HorizontalOptions="Start"
                                    MaximumWidthRequest="300"
                                    Background="{AppThemeBinding Light={StaticResource SurfaceContainerHigh}, Dark={StaticResource SurfaceContainerHighDark}}"
                                    Padding="12,8"
                                    StrokeThickness="0">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="16,16,16,4" />
                                </Border.StrokeShape>
                                <VerticalStackLayout Spacing="3">
                                    <Label Text="{Binding Content}"
                                           TextColor="{AppThemeBinding Light={StaticResource OnSurface}, Dark={StaticResource OnSurfaceDark}}"
                                           FontSize="15"
                                           LineBreakMode="WordWrap" />
                                    <Label Text="{Binding TimeLabel}"
                                           TextColor="{AppThemeBinding Light={StaticResource OnSurfaceVariant}, Dark={StaticResource OnSurfaceVariantDark}}"
                                           FontSize="11"
                                           HorizontalTextAlignment="End" />
                                </VerticalStackLayout>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
                <CollectionView.EmptyView>
                    <VerticalStackLayout Spacing="8" Padding="24,40" HorizontalOptions="Center" VerticalOptions="Center">
                        <Label Text="&#x1F4AC;" FontSize="48" HorizontalOptions="Center" />
                        <Label Text="Ask me anything" Style="{StaticResource EmptyStateLabelStyle}" />
                        <Label Text="Questions about your budgets, spending and savings - plus general finance topics"
                               Style="{StaticResource EmptyStateSubLabelStyle}"
                               HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>
            </CollectionView>

            <!-- Typing indicator -->
            <Grid Grid.Row="2"
                  Padding="16,2"
                  ColumnDefinitions="Auto,Auto"
                  ColumnSpacing="8"
                  HorizontalOptions="Start"
                  IsVisible="{Binding IsTyping}">
                <ActivityIndicator IsRunning="{Binding IsTyping}"
                                   Color="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryLight}}"
                                   HeightRequest="18"
                                   WidthRequest="18"
                                   VerticalOptions="Center" />
                <Label Grid.Column="1"
                       Text="Thinking..."
                       Style="{StaticResource MutedLabelStyle}"
                       VerticalOptions="Center" />
            </Grid>

            <!-- Quick replies (shown before the first message) -->
            <CollectionView Grid.Row="3"
                            ItemsSource="{Binding QuickReplies}"
                            ItemsLayout="HorizontalList"
                            HeightRequest="52"
                            SelectionMode="None"
                            Margin="16,6"
                            IsVisible="{Binding HasMessages, Converter={StaticResource InverseBoolConverter}}">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                        <Border Padding="12,7"
                                Margin="0,0,8,0"
                                Background="{AppThemeBinding Light={StaticResource SurfaceContainerLow}, Dark={StaticResource SurfaceContainerLowDark}}"
                                Stroke="{AppThemeBinding Light={StaticResource OutlineVariant}, Dark={StaticResource OutlineVariantDark}}"
                                StrokeThickness="1">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="16" />
                            </Border.StrokeShape>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding Source={x:Reference ChatPageView}, Path=BindingContext.SendQuickReplyCommand}"
                                                      CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>
                            <Label Text="{Binding .}"
                                   FontSize="13"
                                   TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryLight}}" />
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <!-- Composer -->
            <Border Grid.Row="4"
                    Margin="16,6,16,16"
                    Padding="12,6,6,6"
                    Background="{AppThemeBinding Light={StaticResource SurfaceContainerLow}, Dark={StaticResource SurfaceContainerLowDark}}"
                    Stroke="{AppThemeBinding Light={StaticResource OutlineVariant}, Dark={StaticResource OutlineVariantDark}}"
                    StrokeThickness="1">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="24" />
                </Border.StrokeShape>
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <Editor x:Name="ComposerEditor"
                            Grid.Column="0"
                            Text="{Binding Draft}"
                            Placeholder="Ask about your money..."
                            AutoSize="TextChanges"
                            HeightRequest="44"
                            MinimumHeightRequest="44"
                            MaximumHeightRequest="110"
                            FontSize="15"
                            BackgroundColor="Transparent"
                            VerticalOptions="Center" />
                    <Button Grid.Column="1"
                            Text="&#x27A4;"
                            Command="{Binding SendDraftCommand}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            WidthRequest="52"
                            HeightRequest="44"
                            Padding="0"
                            TextColor="White" />
                </Grid>
            </Border>
        </Grid>

        <!-- Toasts -->
        <controls:ToastHost />

        <!-- Custom confirmation modal -->
        <controls:ConfirmModalHost />
    </Grid>
</ContentPage>
