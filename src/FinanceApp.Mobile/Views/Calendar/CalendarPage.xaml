<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:FinanceApp.Mobile.ViewModels"
             xmlns:converters="clr-namespace:FinanceApp.Mobile.Converters"
             xmlns:controls="clr-namespace:FinanceApp.Mobile.Views.Controls"
             x:Class="FinanceApp.Mobile.Views.Calendar.CalendarPage"
             x:DataType="viewmodels:CalendarViewModel"
             Title="{Binding Title}"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource PayCream}">

    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:MoneyToStringConverter x:Key="MoneyConverter" />
            <converters:TransactionTypeToColorConverter x:Key="TransactionTypeColorConverter" />
            <converters:NullToBoolConverter x:Key="NullToBoolConverter" />
            <converters:InverseBoolConverter x:Key="InverseBoolConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <RefreshView Command="{Binding RefreshCommand}" IsRefreshing="{Binding IsBusy}">
        <ScrollView>
        <VerticalStackLayout Spacing="14" Padding="18,14,18,24">
            <!-- Header -->
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" VerticalOptions="Center">
                <Border WidthRequest="46" HeightRequest="46"
                        Background="{StaticResource PayCard}"
                        Stroke="{StaticResource PayInk}" StrokeThickness="1.5"
                        VerticalOptions="Center">
                    <Border.StrokeShape><Ellipse /></Border.StrokeShape>
                    <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnBackTapped" /></Border.GestureRecognizers>
                    <Label Text="←" FontSize="20" FontAttributes="Bold" TextColor="{StaticResource PayInk}"
                           HorizontalOptions="Center" VerticalOptions="Center" />
                </Border>
                <VerticalStackLayout Grid.Column="1" Spacing="0" VerticalOptions="Center">
                    <Label Text="Calendar" FontSize="18" FontAttributes="Bold" FontFamily="SpaceGroteskBold" TextColor="{StaticResource PayInk}" />
                    <Label Text="Money day by day" FontSize="12" TextColor="#6F7668" />
                </VerticalStackLayout>
                <controls:PaytinIconView Grid.Column="2" IconKey="calendar" Size="46" Light="True" VerticalOptions="Center" />
            </Grid>

            <!-- Month Header -->
            <Border Background="{StaticResource PayCard}" Stroke="{StaticResource PayInk}" StrokeThickness="1.5" Padding="8">
                <Border.StrokeShape><RoundRectangle CornerRadius="100" /></Border.StrokeShape>
                <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                    <Border WidthRequest="42" HeightRequest="42" Background="{StaticResource PayCream}" Stroke="{StaticResource PayInk}" StrokeThickness="1.2" VerticalOptions="Center">
                        <Border.StrokeShape><Ellipse /></Border.StrokeShape>
                        <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding PreviousMonthCommand}" /></Border.GestureRecognizers>
                        <Label Text="←" FontAttributes="Bold" TextColor="{StaticResource PayInk}" HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>
                    <Label Text="{Binding SelectedMonth, StringFormat='{0:MMMM yyyy}'}" FontSize="16" FontAttributes="Bold" FontFamily="SpaceGroteskBold" TextColor="{StaticResource PayInk}" VerticalOptions="Center" HorizontalOptions="Fill" HorizontalTextAlignment="Center" />
                    <Border Background="{StaticResource PayCream}" Stroke="{StaticResource PayInk}" StrokeThickness="1.2" Padding="12,8" VerticalOptions="Center">
                        <Border.StrokeShape><RoundRectangle CornerRadius="100" /></Border.StrokeShape>
                        <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding CurrentMonthCommand}" /></Border.GestureRecognizers>
                        <Label Text="Today" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource PayInk}" />
                    </Border>
                    <Border WidthRequest="42" HeightRequest="42" Background="{StaticResource PayInk}" StrokeThickness="0" VerticalOptions="Center">
                        <Border.StrokeShape><Ellipse /></Border.StrokeShape>
                        <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding NextMonthCommand}" /></Border.GestureRecognizers>
                        <Label Text="→" FontAttributes="Bold" TextColor="{StaticResource PayLime}" HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>
                </HorizontalStackLayout>
            </Border>

            <!-- Calendar Grid -->
            <Border Style="{StaticResource CardFrameStyle}" Padding="12">
                <VerticalStackLayout Spacing="4">
                    <!-- Day Headers -->
                    <HorizontalStackLayout>
                        <Label Text="Sun" Style="{StaticResource CalendarDayHeaderStyle}" />
                        <Label Text="Mon" Style="{StaticResource CalendarDayHeaderStyle}" />
                        <Label Text="Tue" Style="{StaticResource CalendarDayHeaderStyle}" />
                        <Label Text="Wed" Style="{StaticResource CalendarDayHeaderStyle}" />
                        <Label Text="Thu" Style="{StaticResource CalendarDayHeaderStyle}" />
                        <Label Text="Fri" Style="{StaticResource CalendarDayHeaderStyle}" />
                        <Label Text="Sat" Style="{StaticResource CalendarDayHeaderStyle}" />
                    </HorizontalStackLayout>

                    <!-- Calendar Days -->
                    <Grid x:Name="CalendarGrid" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" ColumnDefinitions="*,*,*,*,*,*,*">
                        <!-- Days will be populated dynamically -->
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- Selected Day Events -->
            <Border Style="{StaticResource CardFrameStyle}" IsVisible="{Binding SelectedDayEvents.Count, Converter={StaticResource NullToBoolConverter}}">
                <VerticalStackLayout Spacing="12">
                    <Label Text="{Binding SelectedDate, StringFormat='{0:MMMM dd, yyyy}'}" Style="{StaticResource SectionHeaderStyle}" />
                    
                    <CollectionView ItemsSource="{Binding SelectedDayEvents}" SelectionMode="None">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource TransactionItemFrameStyle}" Margin="0,4">
                                    <HorizontalStackLayout Spacing="12">
                                        <controls:PaytinIconView Icon="{Binding CategoryIcon}" Name="{Binding CategoryName}" Size="40" VerticalOptions="Center" />
                                        <VerticalStackLayout Spacing="2" VerticalOptions="Center" HorizontalOptions="Fill">
                                            <Label Text="{Binding CategoryName}" Style="{StaticResource TransactionNameLabelStyle}" />
                                            <Label Text="{Binding Notes}" Style="{StaticResource TransactionNotesLabelStyle}" 
                                                   IsVisible="{Binding Notes, Converter={StaticResource NullToBoolConverter}}" />
                                        </VerticalStackLayout>
                                        <Label Text="{Binding Amount, Converter={StaticResource MoneyConverter}}" 
                                               Style="{StaticResource TransactionAmountLabelStyle}"
                                               TextColor="{Binding Type, Converter={StaticResource TransactionTypeColorConverter}}" />
                                    </HorizontalStackLayout>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </Border>

            <!-- Empty State for Selected Day -->
            <controls:PaytinEmptyState Title="No events on this day"
                                     Subtitle="Pick another day to see its activity"
                                     IconKey="calendar"
                                     IsVisible="{Binding SelectedDayEvents.Count, Converter={StaticResource InverseBoolConverter}, ConverterParameter=true}"
                                     IsEnabled="{Binding SelectedDate, Converter={StaticResource NullToBoolConverter}}" />
        </VerticalStackLayout>
        </ScrollView>
    </RefreshView>
</ContentPage>