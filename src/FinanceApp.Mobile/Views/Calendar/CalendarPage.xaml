<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:FinanceApp.Mobile.ViewModels"
             xmlns:dtos="clr-namespace:FinanceApp.Application.DTOs;assembly=FinanceApp.Application"
             xmlns:converters="clr-namespace:FinanceApp.Mobile.Converters"
             xmlns:controls="clr-namespace:FinanceApp.Mobile.Views.Controls"
             x:Class="FinanceApp.Mobile.Views.Calendar.CalendarPage"
             x:DataType="viewmodels:CalendarViewModel"
             Title="{Binding Title}"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{DynamicResource FinoraCream}">

    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:MoneyToStringConverter x:Key="MoneyConverter" />
            <converters:TransactionTypeToColorConverter x:Key="TransactionTypeColorConverter" />
            <converters:NullToBoolConverter x:Key="NullToBoolConverter" />
            <converters:InverseBoolConverter x:Key="InverseBoolConverter" />
            <converters:CountToBoolConverter x:Key="CountToBoolConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid>
        <controls:SkeletonCalendar IsVisible="{Binding IsInitialLoading}" />

        <RefreshView Command="{Binding RefreshCommand}" IsRefreshing="{Binding IsRefreshing, Mode=OneWay}"
                      IsVisible="{Binding IsInitialLoading, Converter={StaticResource InverseBoolConverter}}">
        <ScrollView>
        <VerticalStackLayout Spacing="14" Padding="18,14,18,24">
            <!-- Header -->
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" VerticalOptions="Center">
                <Border WidthRequest="46" HeightRequest="46"
                        Background="{DynamicResource FinoraCard}"
                        Stroke="{DynamicResource FinoraInk}" StrokeThickness="1.5"
                        VerticalOptions="Center">
                    <Border.StrokeShape><Ellipse /></Border.StrokeShape>
                    <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnBackTapped" /></Border.GestureRecognizers>
                    <controls:FinoraIconView IconKey="arrowleft" Size="20" ShowBadge="False" Light="True" HorizontalOptions="Center" VerticalOptions="Center" />
                </Border>
                <VerticalStackLayout Grid.Column="1" Spacing="0" VerticalOptions="Center">
                    <Label Text="Calendar" FontSize="18" FontAttributes="Bold" FontFamily="SpaceGroteskBold" TextColor="{DynamicResource FinoraInk}" />
                    <Label Text="Money day by day" FontSize="12" TextColor="{DynamicResource FinoraMuted}" />
                </VerticalStackLayout>
                <controls:FinoraIconView Grid.Column="2" IconKey="calendar" Size="46" Light="True" VerticalOptions="Center" />
            </Grid>

            <!-- Month Header -->
            <Border Background="{DynamicResource FinoraCard}" Stroke="{DynamicResource FinoraInk}" StrokeThickness="1.5" Padding="8">
                <Border.StrokeShape><RoundRectangle CornerRadius="100" /></Border.StrokeShape>
                <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8">
                    <Border Grid.Column="0" WidthRequest="42" HeightRequest="42" Background="{DynamicResource FinoraCream}" Stroke="{DynamicResource FinoraInk}" StrokeThickness="1.2" VerticalOptions="Center">
                        <Border.StrokeShape><Ellipse /></Border.StrokeShape>
                        <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding PreviousMonthCommand}" /></Border.GestureRecognizers>
                        <controls:FinoraIconView IconKey="arrowleft" Size="18" ShowBadge="False" Light="True" HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>
                    <Label Grid.Column="1" Text="{Binding SelectedMonth, StringFormat='{0:MMMM yyyy}'}" FontSize="16" FontAttributes="Bold" FontFamily="SpaceGroteskBold" TextColor="{DynamicResource FinoraInk}" VerticalOptions="Center" HorizontalTextAlignment="Center" />
                    <Border Grid.Column="2" Background="{DynamicResource FinoraCream}" Stroke="{DynamicResource FinoraInk}" StrokeThickness="1.2" Padding="12,8" VerticalOptions="Center">
                        <Border.StrokeShape><RoundRectangle CornerRadius="100" /></Border.StrokeShape>
                        <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding CurrentMonthCommand}" /></Border.GestureRecognizers>
                        <Label Text="Today" FontSize="12" FontAttributes="Bold" TextColor="{DynamicResource FinoraInk}" />
                    </Border>
                    <Border Grid.Column="3" WidthRequest="42" HeightRequest="42" Background="{DynamicResource FinoraInk}" StrokeThickness="0" VerticalOptions="Center">
                        <Border.StrokeShape><Ellipse /></Border.StrokeShape>
                        <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding NextMonthCommand}" /></Border.GestureRecognizers>
                        <controls:FinoraIconView IconKey="arrowright" Size="18" ShowBadge="False" Light="True" StrokeColor="{DynamicResource FinoraLime}" HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>
                </Grid>
            </Border>

            <!-- Calendar Grid -->
            <Border Style="{StaticResource CardFrameStyle}" Padding="12">
                <VerticalStackLayout Spacing="4">
                    <!-- Day Headers -->
                    <HorizontalStackLayout>
                        <Label Text="Sun" Style="{StaticResource CalendarDayHeaderStyle}" />
                        <Label Text="Mon" Style="{StaticResource CalendarDayHeaderStyle}" />
                        <Label Text="Tue" Style="{StaticResource CalendarDayHeaderStyle}" />
                        <Label Text="Wed" Style="{StaticResource CalendarDayHeaderStyle}" />
                        <Label Text="Thu" Style="{StaticResource CalendarDayHeaderStyle}" />
                        <Label Text="Fri" Style="{StaticResource CalendarDayHeaderStyle}" />
                        <Label Text="Sat" Style="{StaticResource CalendarDayHeaderStyle}" />
                    </HorizontalStackLayout>

                    <!-- Calendar Days -->
                    <Grid x:Name="CalendarGrid" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" ColumnDefinitions="*,*,*,*,*,*,*">
                        <!-- Days will be populated dynamically -->
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- Selected Day Events -->
            <Border Style="{StaticResource CardFrameStyle}"
                    IsVisible="{Binding SelectedDayEvents.Count, Converter={StaticResource CountToBoolConverter}}">
                <VerticalStackLayout Spacing="12">
                    <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                        <Label Grid.Column="0" Text="{Binding SelectedDate, StringFormat='{0:MMMM dd, yyyy}'}" FontSize="16" FontAttributes="Bold" FontFamily="SpaceGroteskBold" TextColor="{DynamicResource FinoraInk}" />
                        <Border Grid.Column="1" Background="{DynamicResource FinoraLime}" Stroke="{DynamicResource FinoraInk}" StrokeThickness="1.5" Padding="12,7">
                            <Border.StrokeShape><RoundRectangle CornerRadius="100" /></Border.StrokeShape>
                            <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnAddForDayTapped" /></Border.GestureRecognizers>
                            <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                                <Label Text="+" FontSize="13" FontAttributes="Bold" TextColor="{DynamicResource FinoraInk}" />
                                <Label Text="Add" FontSize="12" FontAttributes="Bold" TextColor="{DynamicResource FinoraInk}" />
                            </HorizontalStackLayout>
                        </Border>
                    </Grid>

                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding SelectedDayEvents}" Spacing="0">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="dtos:CalendarEventDto">
                                <Border Background="{DynamicResource FinoraCard}" Stroke="{DynamicResource OutlineVariant}" StrokeThickness="1" Padding="12" Margin="0,4">
                                    <Border.StrokeShape><RoundRectangle CornerRadius="20" /></Border.StrokeShape>
                                    <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnEditEventTapped" /></Border.GestureRecognizers>
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                        <controls:FinoraIconView Grid.Column="0" Icon="{Binding CategoryIcon}" Name="{Binding CategoryName}" Size="40" VerticalOptions="Center" />
                                        <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center" HorizontalOptions="Fill">
                                            <Label Text="{Binding CategoryName}" FontSize="14" FontAttributes="Bold" TextColor="{DynamicResource FinoraInk}" />
                                            <Label Text="{Binding Notes}" FontSize="12" TextColor="{DynamicResource FinoraMuted}" LineBreakMode="WordWrap"
                                                   IsVisible="{Binding Notes, Converter={StaticResource NullToBoolConverter}}" />
                                        </VerticalStackLayout>
                                        <Label Grid.Column="2" Text="{Binding Amount, Converter={StaticResource MoneyConverter}}"
                                               FontSize="14" FontAttributes="Bold" TextColor="{DynamicResource FinoraInk}"
                                               VerticalOptions="Center" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>

                    <Label Text="Tap an entry to edit it in Transactions." FontSize="11" TextColor="{DynamicResource MutedSoft}" />
                </VerticalStackLayout>
            </Border>

            <!-- Empty State for Selected Day -->
            <controls:FinoraEmptyState Title="No events on this day"
                                     Subtitle="Pick another day to see its activity"
                                     IconKey="calendar"
                                     IsVisible="{Binding SelectedDayEvents.Count, Converter={StaticResource InverseBoolConverter}, ConverterParameter=true}"
                                     IsEnabled="{Binding SelectedDate, Converter={StaticResource NullToBoolConverter}}" />
        </VerticalStackLayout>
        </ScrollView>
    </RefreshView>
    </Grid>
</ContentPage>