<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:FinanceApp.Mobile.ViewModels"
             xmlns:converters="clr-namespace:FinanceApp.Mobile.Converters"
             xmlns:controls="clr-namespace:FinanceApp.Mobile.Views.Controls"
             xmlns:dtos="clr-namespace:FinanceApp.Application.DTOs;assembly=FinanceApp.Application"
             xmlns:services="clr-namespace:FinanceApp.Mobile.Services"
             x:Class="FinanceApp.Mobile.Views.AccountsPage"
             x:DataType="viewmodels:AccountsViewModel"
             Title="{Binding Title}"
             x:Name="AccountsPageView">

    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:MoneyToStringConverter x:Key="MoneyConverter" />
            <converters:BoolToStringConverter x:Key="BoolConverter" />
            <converters:InverseBoolConverter x:Key="InverseBoolConverter" />
            <converters:ColorConverter x:Key="ColorConverter" />
            <converters:BoolToStyleConverter x:Key="BoolToStyleConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid>
        <RefreshView Command="{Binding RefreshCommand}" IsRefreshing="{Binding IsBusy}">
            <VerticalStackLayout Spacing="16" Padding="20,16,20,28">
                <!-- Header -->
                <VerticalStackLayout Spacing="2">
                    <Label Text="Accounts" Style="{StaticResource TitleLabelStyle}" />
                    <Label Text="Wallets, banks and cash in one place" Style="{StaticResource MutedLabelStyle}" />
                </VerticalStackLayout>

                <!-- Tabs -->
                <Border Style="{StaticResource CardFrameStyle}" Padding="8">
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                        <Button Grid.Column="0" Text="Accounts" HeightRequest="46"
                                Command="{Binding ShowAccountsTabCommand}"
                                Style="{Binding IsAccountsTab, Converter={StaticResource BoolToStyleConverter}}" />
                        <Button Grid.Column="1" Text="History" HeightRequest="46"
                                Command="{Binding ShowHistoryTabCommand}"
                                Style="{Binding ShowHistory, Converter={StaticResource BoolToStyleConverter}}" />
                    </Grid>
                </Border>

                <!-- Accounts Tab -->
                <VerticalStackLayout Spacing="16" IsVisible="{Binding IsAccountsTab}">
                    <!-- Total Balance -->
                    <Border Style="{StaticResource CardFrameStyle}" Padding="22">
                        <VerticalStackLayout Spacing="4" HorizontalOptions="Center">
                            <Label Text="Total Balance" Style="{StaticResource CaptionLabelStyle}" />
                            <HorizontalStackLayout Spacing="8" VerticalOptions="Center" HorizontalOptions="Center">
                                <Label Text="{Binding TotalBalance.Amount, StringFormat='{0:N2}'}"
                                       Style="{StaticResource BalanceLabelStyle}"
                                       VerticalOptions="End" />
                                <Label Text="{Binding TotalBalance.Currency}"
                                       FontSize="15"
                                       TextColor="{AppThemeBinding Light={StaticResource OnSurfaceVariant}, Dark={StaticResource OnSurfaceVariantDark}}"
                                       VerticalOptions="End"
                                       Margin="0,0,0,5" />
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                    </Border>

                    <!-- Accounts List -->
                    <CollectionView ItemsSource="{Binding Accounts}" SelectionMode="None">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="dtos:AccountDto">
                                <SwipeView>
                                    <SwipeView.RightItems>
                                        <SwipeItems>
                                            <SwipeItem Text="Edit"
                                                       BackgroundColor="#0E6B4F"
                                                       Command="{Binding Source={x:Reference AccountsPageView}, Path=BindingContext.EditAccountCommand}"
                                                       CommandParameter="{Binding .}" />
                                            <SwipeItem Text="Delete"
                                                       BackgroundColor="#DC2626"
                                                       Command="{Binding Source={x:Reference AccountsPageView}, Path=BindingContext.DeleteAccountCommand}"
                                                       CommandParameter="{Binding .}" />
                                            <SwipeItem Text="Set Default"
                                                       BackgroundColor="#2563EB"
                                                       Command="{Binding Source={x:Reference AccountsPageView}, Path=BindingContext.SetDefaultCommand}"
                                                       CommandParameter="{Binding .}"
                                                       IsVisible="{Binding IsDefault, Converter={StaticResource InverseBoolConverter}}" />
                                        </SwipeItems>
                                    </SwipeView.RightItems>
                                    <Border Style="{StaticResource AccountItemFrameStyle}" Margin="0,4">
                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                                            <Border Grid.Column="0"
                                                    WidthRequest="52"
                                                    HeightRequest="52"
                                                    Background="{Binding Color, Converter={StaticResource ColorConverter}}"
                                                    StrokeThickness="0"
                                                    VerticalOptions="Center">
                                                <Border.StrokeShape>
                                                    <Ellipse />
                                                </Border.StrokeShape>
                                                <Label Text="{Binding Icon, TargetNullValue=&#x1F4B0;}" VerticalOptions="Center" HorizontalOptions="Center" FontSize="24" />
                                            </Border>

                                            <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center" HorizontalOptions="Fill">
                                                <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                                                    <Label Text="{Binding Name}" Style="{StaticResource AccountNameLabelStyle}" VerticalOptions="Center" />
                                                    <Border Background="{AppThemeBinding Light={StaticResource PrimaryContainer}, Dark={StaticResource PrimaryContainerDark}}"
                                                            StrokeThickness="0"
                                                            Padding="8,2"
                                                            VerticalOptions="Center">
                                                        <Border.StrokeShape>
                                                            <RoundRectangle CornerRadius="10" />
                                                        </Border.StrokeShape>
                                                        <Label Text="{Binding Type}"
                                                               FontSize="11"
                                                               FontAttributes="Bold"
                                                               TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryLight}}" />
                                                    </Border>
                                                    <Label Text="&#x2713;" TextColor="{StaticResource Success}" IsVisible="{Binding IsDefault}" FontAttributes="Bold" FontSize="14" VerticalOptions="Center" />
                                                </HorizontalStackLayout>
                                                <Label Text="{Binding Balance, Converter={StaticResource MoneyConverter}}" Style="{StaticResource AccountBalanceLabelStyle}" />
                                            </VerticalStackLayout>

                                            <Border Grid.Column="2"
                                                    Padding="6,6"
                                                    BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceContainerHigh}, Dark={StaticResource SurfaceContainerHighDark}}"
                                                    StrokeThickness="0"
                                                    VerticalOptions="Center">
                                                <Border.StrokeShape>
                                                    <RoundRectangle CornerRadius="14" />
                                                </Border.StrokeShape>
                                                <Label Text="&#x22EE;"
                                                       FontSize="16"
                                                       FontAttributes="Bold"
                                                       TextColor="{AppThemeBinding Light={StaticResource OnSurfaceVariant}, Dark={StaticResource OnSurfaceVariantDark}}"
                                                       VerticalOptions="Center"
                                                       HorizontalOptions="Center">
                                                    <Label.GestureRecognizers>
                                                        <TapGestureRecognizer Command="{Binding Source={x:Reference AccountsPageView}, Path=BindingContext.AccountActionsCommand}"
                                                                              CommandParameter="{Binding .}" />
                                                    </Label.GestureRecognizers>
                                                </Label>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </SwipeView>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                        <CollectionView.EmptyView>
                            <VerticalStackLayout Spacing="8" HorizontalOptions="Center" VerticalOptions="Center" Padding="20">
                                <Label Text="&#x1F3E6;" FontSize="48" HorizontalOptions="Center" />
                                <Label Text="No accounts yet" Style="{StaticResource EmptyStateLabelStyle}" />
                                <Label Text="Add your first account to start tracking" Style="{StaticResource EmptyStateSubLabelStyle}" />
                            </VerticalStackLayout>
                        </CollectionView.EmptyView>
                    </CollectionView>

                    <!-- Add Account Button -->
                    <Button Text="Add Account"
                            Command="{Binding AddAccountCommand}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            TextColor="White" />
                </VerticalStackLayout>

                <!-- History Tab -->
                <VerticalStackLayout Spacing="8" IsVisible="{Binding ShowHistory}">
                    <CollectionView ItemsSource="{Binding History}" SelectionMode="None">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="services:AccountHistoryEntryDto">
                                <Border Style="{StaticResource AccountItemFrameStyle}" Margin="0,4">
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                        <Border Grid.Column="0"
                                                WidthRequest="42"
                                                HeightRequest="42"
                                                BackgroundColor="{Binding ActionColor, Converter={StaticResource ColorConverter}}"
                                                StrokeThickness="0"
                                                VerticalOptions="Center">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="14" />
                                            </Border.StrokeShape>
                                            <Label Text="{Binding ActionIcon}" FontSize="17" HorizontalOptions="Center" VerticalOptions="Center" />
                                        </Border>
                                        <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
                                            <Label Text="{Binding AccountName}" FontSize="15" FontAttributes="Bold"
                                                   TextColor="{AppThemeBinding Light={StaticResource OnSurface}, Dark={StaticResource OnSurfaceDark}}" />
                                            <Label Text="{Binding Action}" FontSize="12" FontAttributes="Bold"
                                                   TextColor="{Binding ActionColor, Converter={StaticResource ColorConverter}}" />
                                            <Label Text="{Binding Details}" FontSize="12" LineBreakMode="WordWrap"
                                                   TextColor="{AppThemeBinding Light={StaticResource OnSurfaceVariant}, Dark={StaticResource OnSurfaceVariantDark}}" />
                                        </VerticalStackLayout>
                                        <Label Grid.Column="2" Text="{Binding TimeLabel}" FontSize="11"
                                               TextColor="{AppThemeBinding Light={StaticResource OnSurfaceVariant}, Dark={StaticResource OnSurfaceVariantDark}}"
                                               VerticalOptions="Center" HorizontalTextAlignment="End" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                        <CollectionView.EmptyView>
                            <VerticalStackLayout Spacing="8" HorizontalOptions="Center" VerticalOptions="Center" Padding="20">
                                <Label Text="&#x1F5C2;&#xFE0F;" FontSize="48" HorizontalOptions="Center" />
                                <Label Text="No history yet" Style="{StaticResource EmptyStateLabelStyle}" />
                                <Label Text="Account changes will show up here" Style="{StaticResource EmptyStateSubLabelStyle}" />
                            </VerticalStackLayout>
                        </CollectionView.EmptyView>
                    </CollectionView>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </RefreshView>

        <!-- Toasts -->
        <controls:ToastHost />

        <!-- Custom confirmation modal -->
        <controls:ConfirmModalHost />

        <!-- Action sheet -->
        <controls:ChoiceSheetHost />

        <!-- Success / failure animation -->
        <controls:SuccessOverlayHost />
    </Grid>
</ContentPage>
