<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:FinanceApp.Mobile.ViewModels"
             xmlns:converters="clr-namespace:FinanceApp.Mobile.Converters"
             xmlns:controls="clr-namespace:FinanceApp.Mobile.Views.Controls"
             xmlns:dtos="clr-namespace:FinanceApp.Application.DTOs;assembly=FinanceApp.Application"
             xmlns:services="clr-namespace:FinanceApp.Mobile.Services"
             x:Class="FinanceApp.Mobile.Views.AccountsPage"
             x:DataType="viewmodels:AccountsViewModel"
             Title="{Binding Title}"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource PayCream}"
             x:Name="AccountsPageView">

    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:MoneyToStringConverter x:Key="MoneyConverter" />
            <converters:BoolToStringConverter x:Key="BoolConverter" />
            <converters:InverseBoolConverter x:Key="InverseBoolConverter" />
            <converters:ColorConverter x:Key="ColorConverter" />
            <converters:BoolToStyleConverter x:Key="BoolToStyleConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid>
        <RefreshView Command="{Binding RefreshCommand}" IsRefreshing="{Binding IsBusy}">
            <ScrollView>
            <VerticalStackLayout Spacing="14" Padding="18,14,18,100">
                <Grid ColumnDefinitions="Auto,*,Auto" VerticalOptions="Center">
                    <Border WidthRequest="46" HeightRequest="46" Background="{StaticResource PayCard}" Stroke="{StaticResource PayInk}" StrokeThickness="1.5">
                        <Border.StrokeShape><Ellipse /></Border.StrokeShape>
                        <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnHomeTapped" /></Border.GestureRecognizers>
                        <Label Text="←" FontSize="20" FontAttributes="Bold" TextColor="{StaticResource PayInk}" HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>
                    <VerticalStackLayout Grid.Column="1" Margin="10,0" VerticalOptions="Center">
                        <Label Text="Accounts" FontSize="18" FontAttributes="Bold" TextColor="{StaticResource PayInk}" />
                        <Label Text="Wallets, banks and cash in one place" FontSize="12" TextColor="#6F7668" />
                    </VerticalStackLayout>
                    <Border Grid.Column="2" Background="{StaticResource PayLime}" Stroke="{StaticResource PayInk}" StrokeThickness="1.5" Padding="12,8">
                        <Border.StrokeShape><RoundRectangle CornerRadius="100" /></Border.StrokeShape>
                        <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding AddAccountCommand}" /></Border.GestureRecognizers>
                        <Label Text="+ Add" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource PayInk}" />
                    </Border>
                </Grid>

                <!-- VISA-style hero (live total) -->
                <Border Style="{StaticResource HeroCardStyle}">
                    <VerticalStackLayout Spacing="4">
                        <HorizontalStackLayout Spacing="8">
                            <Label Text="VISA" FontSize="16" FontAttributes="Bold" TextColor="White" CharacterSpacing="2" />
                            <Border Background="{StaticResource PayLime}" StrokeThickness="0" Padding="10,4" HorizontalOptions="EndAndExpand">
                                <Border.StrokeShape><RoundRectangle CornerRadius="100" /></Border.StrokeShape>
                                <Label Text="{Binding Accounts.Count, StringFormat='{0} cards'}" FontSize="11" FontAttributes="Bold" TextColor="{StaticResource PayInk}" />
                            </Border>
                        </HorizontalStackLayout>
                        <Label Text="Total Balance" FontSize="12" TextColor="White" Opacity="0.7" Margin="0,8,0,0" />
                        <HorizontalStackLayout Spacing="6">
                            <Label Text="$" FontSize="20" FontAttributes="Bold" TextColor="White" VerticalOptions="End" Margin="0,0,0,4" />
                            <Label Text="{Binding TotalBalance.Amount, StringFormat='{0:N2}'}" FontSize="34" FontAttributes="Bold" TextColor="White" />
                        </HorizontalStackLayout>
                        <Label Text="●●●●  ●●●●  ●●●●  7281" FontSize="12" FontAttributes="Bold" TextColor="White" Opacity="0.8" />
                    </VerticalStackLayout>
                </Border>

                <!-- Tabs -->
                <Border Background="{StaticResource PayCard}" Stroke="{StaticResource PayInk}" StrokeThickness="1.5" Padding="6">
                    <Border.StrokeShape><RoundRectangle CornerRadius="100" /></Border.StrokeShape>
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="6">
                        <Border Grid.Column="0" Padding="0,12" Background="{StaticResource PayLime}" Stroke="{StaticResource PayInk}" StrokeThickness="1.5">
                            <Border.StrokeShape><RoundRectangle CornerRadius="100" /></Border.StrokeShape>
                            <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding ShowAccountsTabCommand}" /></Border.GestureRecognizers>
                            <Border.Triggers><DataTrigger TargetType="Border" Binding="{Binding IsAccountsTab}" Value="False"><Setter Property="Background" Value="Transparent" /><Setter Property="StrokeThickness" Value="0" /></DataTrigger></Border.Triggers>
                            <Label Text="Accounts" FontSize="13" FontAttributes="Bold" TextColor="{StaticResource PayInk}" HorizontalOptions="Center" />
                        </Border>
                        <Border Grid.Column="1" Padding="0,12" Background="Transparent" StrokeThickness="0">
                            <Border.StrokeShape><RoundRectangle CornerRadius="100" /></Border.StrokeShape>
                            <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding ShowHistoryTabCommand}" /></Border.GestureRecognizers>
                            <Border.Triggers><DataTrigger TargetType="Border" Binding="{Binding ShowHistory}" Value="True"><Setter Property="Background" Value="{StaticResource PayLime}" /><Setter Property="Stroke" Value="{StaticResource PayInk}" /><Setter Property="StrokeThickness" Value="1.5" /></DataTrigger></Border.Triggers>
                            <Label Text="History" FontSize="13" FontAttributes="Bold" TextColor="{StaticResource PayInk}" HorizontalOptions="Center" />
                        </Border>
                    </Grid>
                </Border>

                <!-- Accounts Tab -->
                <VerticalStackLayout Spacing="10" IsVisible="{Binding IsAccountsTab}">
                    <CollectionView ItemsSource="{Binding Accounts}" SelectionMode="None">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="dtos:AccountDto">
                                <SwipeView>
                                    <SwipeView.RightItems>
                                        <SwipeItems>
                                            <SwipeItem Text="Edit" BackgroundColor="#161B16"
                                                       Command="{Binding Source={x:Reference AccountsPageView}, Path=BindingContext.EditAccountCommand}"
                                                       CommandParameter="{Binding .}" />
                                            <SwipeItem Text="Delete" BackgroundColor="#DC2626"
                                                       Command="{Binding Source={x:Reference AccountsPageView}, Path=BindingContext.DeleteAccountCommand}"
                                                       CommandParameter="{Binding .}" />
                                        </SwipeItems>
                                    </SwipeView.RightItems>
                                    <Border Background="{StaticResource PayCard}" Stroke="{StaticResource PayInk}" StrokeThickness="1.5" Padding="14" Margin="0,4">
                                        <Border.StrokeShape><RoundRectangle CornerRadius="24" /></Border.StrokeShape>
                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                            <controls:PaytinIconView Grid.Column="0" Icon="{Binding Icon}" Name="{Binding Name}" Size="52" VerticalOptions="Center" />
                                            <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
                                                <HorizontalStackLayout Spacing="6">
                                                    <Label Text="{Binding Name}" FontSize="15" FontAttributes="Bold" TextColor="{StaticResource PayInk}" />
                                                    <Border Background="{StaticResource PayLime}" Stroke="{StaticResource PayInk}" StrokeThickness="1" Padding="8,2" VerticalOptions="Center" IsVisible="{Binding IsDefault}">
                                                        <Border.StrokeShape><RoundRectangle CornerRadius="100" /></Border.StrokeShape>
                                                        <Label Text="✓ Default" FontSize="10" FontAttributes="Bold" TextColor="{StaticResource PayInk}" />
                                                    </Border>
                                                </HorizontalStackLayout>
                                                <Label Text="{Binding Type}" FontSize="11" FontAttributes="Bold" TextColor="#6F7668" />
                                                <Label Text="{Binding Balance, Converter={StaticResource MoneyConverter}}" FontSize="16" FontAttributes="Bold" TextColor="{StaticResource PayInk}" />
                                            </VerticalStackLayout>
                                            <Border Grid.Column="2" WidthRequest="38" HeightRequest="38" Background="{StaticResource PayCream}" Stroke="{StaticResource PayInk}" StrokeThickness="1.2" VerticalOptions="Center">
                                                <Border.StrokeShape><Ellipse /></Border.StrokeShape>
                                                <Label Text="⋮" FontSize="16" FontAttributes="Bold" TextColor="{StaticResource PayInk}" HorizontalOptions="Center" VerticalOptions="Center">
                                                    <Label.GestureRecognizers>
                                                        <TapGestureRecognizer Command="{Binding Source={x:Reference AccountsPageView}, Path=BindingContext.AccountActionsCommand}" CommandParameter="{Binding .}" />
                                                    </Label.GestureRecognizers>
                                                </Label>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </SwipeView>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                        <CollectionView.EmptyView>
                            <controls:PaytinEmptyState Title="No accounts yet"
                                                     Subtitle="Add your first account to start tracking"
                                                     IconKey="wallet" />
                        </CollectionView.EmptyView>
                    </CollectionView>
                    <Button Text="+ Add Account" Command="{Binding AddAccountCommand}" Style="{StaticResource PrimaryButtonStyle}" />
                </VerticalStackLayout>

                <!-- History Tab -->
                <VerticalStackLayout Spacing="8" IsVisible="{Binding ShowHistory}">
                    <CollectionView ItemsSource="{Binding History}" SelectionMode="None">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="services:AccountHistoryEntryDto">
                                <Border Background="{StaticResource PayCard}" Stroke="#D3D9BE" StrokeThickness="1" Padding="12" Margin="0,4">
                                    <Border.StrokeShape><RoundRectangle CornerRadius="20" /></Border.StrokeShape>
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                        <Border Grid.Column="0" WidthRequest="42" HeightRequest="42" BackgroundColor="{Binding ActionColor, Converter={StaticResource ColorConverter}}" Stroke="{StaticResource PayInk}" StrokeThickness="1" VerticalOptions="Center">
                                            <Border.StrokeShape><RoundRectangle CornerRadius="14" /></Border.StrokeShape>
                                            <Label Text="{Binding ActionIcon}" FontSize="17" HorizontalOptions="Center" VerticalOptions="Center" />
                                        </Border>
                                        <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                            <Label Text="{Binding AccountName}" FontSize="14" FontAttributes="Bold" TextColor="{StaticResource PayInk}" />
                                            <Label Text="{Binding Details}" FontSize="12" TextColor="#6F7668" LineBreakMode="WordWrap" />
                                        </VerticalStackLayout>
                                        <Label Grid.Column="2" Text="{Binding TimeLabel}" FontSize="11" TextColor="#6F7668" VerticalOptions="Center" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                        <CollectionView.EmptyView>
                            <controls:PaytinEmptyState Title="No history yet"
                                                     Subtitle="Account changes will show up here"
                                                     IconKey="sync" />
                        </CollectionView.EmptyView>
                    </CollectionView>
                </VerticalStackLayout>
            </VerticalStackLayout>
            </ScrollView>
        </RefreshView>

        <controls:PaytinTabBar VerticalOptions="End" ActiveTab="Accounts" />

        <controls:ToastHost />
        <controls:ConfirmModalHost />
        <controls:ChoiceSheetHost />
        <controls:SuccessOverlayHost />
    </Grid>
</ContentPage>
