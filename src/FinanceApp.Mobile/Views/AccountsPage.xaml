<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:FinanceApp.Mobile.ViewModels"
             xmlns:converters="clr-namespace:FinanceApp.Mobile.Converters"
             xmlns:controls="clr-namespace:FinanceApp.Mobile.Views.Controls"
             xmlns:dtos="clr-namespace:FinanceApp.Application.DTOs;assembly=FinanceApp.Application"
             xmlns:services="clr-namespace:FinanceApp.Mobile.Services"
             x:Class="FinanceApp.Mobile.Views.AccountsPage"
             x:DataType="viewmodels:AccountsViewModel"
             Title="{Binding Title}"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource FinoraCream}"
             x:Name="AccountsPageView">

    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:MoneyToStringConverter x:Key="MoneyConverter" />
            <converters:BoolToStringConverter x:Key="BoolConverter" />
            <converters:InverseBoolConverter x:Key="InverseBoolConverter" />
            <converters:ColorConverter x:Key="ColorConverter" />
            <converters:BoolToStyleConverter x:Key="BoolToStyleConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid>
        <!-- Account rows carry a trailing balance. -->
        <controls:SkeletonWallet IsVisible="{Binding IsInitialLoading}" />

        <RefreshView Command="{Binding RefreshCommand}" IsRefreshing="{Binding IsBusy}"
                      IsVisible="{Binding IsInitialLoading, Converter={StaticResource InverseBoolConverter}}">
            <ScrollView>
            <VerticalStackLayout Spacing="14" Padding="18,14,18,100">
                <Grid ColumnDefinitions="Auto,*" VerticalOptions="Center">
                    <Border WidthRequest="46" HeightRequest="46" Background="{StaticResource FinoraCard}" Stroke="{StaticResource FinoraInk}" StrokeThickness="1.5">
                        <Border.StrokeShape><Ellipse /></Border.StrokeShape>
                        <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnHomeTapped" /></Border.GestureRecognizers>
                        <Label Text="←" FontSize="20" FontAttributes="Bold" TextColor="{StaticResource FinoraInk}" HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>
                    <VerticalStackLayout Grid.Column="1" Margin="10,0" VerticalOptions="Center">
                        <Label Text="Accounts" FontSize="18" FontAttributes="Bold" TextColor="{StaticResource FinoraInk}" />
                        <Label Text="Wallets, banks and cash in one place" FontSize="12" TextColor="#6F7668" />
                    </VerticalStackLayout>
                    <!-- Adding an account moved onto the balance card's pill,
                         mirroring where the dashboard puts its action. -->
                </Grid>

                <!-- Balance card: the same one the dashboard shows, so the two
                     screens do not disagree about how the money is presented. -->
                <Grid>
                    <Border Style="{StaticResource HeroCardStyle}" Padding="0" Margin="0,15,0,0">
                        <Border.StrokeShape><RoundRectangle CornerRadius="34" /></Border.StrokeShape>
                        <Grid ColumnDefinitions="*,54" Padding="20,20,8,20">
                            <!-- diagonal line texture: single scaled path, so the rotation is never layout-dependent -->
                            <Path Grid.ColumnSpan="2" Aspect="Fill" Fill="Transparent"
                                  Stroke="White" StrokeThickness="0.5" Opacity="0.06"
                                  HorizontalOptions="Fill" VerticalOptions="Fill"
                                  InputTransparent="True"
                                  Data="M -60,100 L -2.3,0 M -48.3,100 L 9.4,0 M -36.6,100 L 21.1,0 M -24.9,100 L 32.8,0 M -13.2,100 L 44.5,0 M -1.5,100 L 56.2,0 M 10.2,100 L 67.9,0 M 21.9,100 L 79.6,0 M 33.6,100 L 91.3,0 M 45.3,100 L 103,0 M 57,100 L 114.7,0 M 68.7,100 L 126.4,0 M 80.4,100 L 138.1,0 M 92.1,100 L 149.8,0 M 103.8,100 L 161.5,0" />
                            <Grid Grid.Column="0">
                                <VerticalStackLayout Spacing="2">
                                    <Label Text="VISA" FontSize="13" FontAttributes="Bold" TextColor="White" Opacity="0.85" CharacterSpacing="3" VerticalOptions="Center" />
                                    <Label Text="Total Balance" FontSize="12" TextColor="White" Opacity="0.65" Margin="0,10,0,0" />
                                    <HorizontalStackLayout Spacing="5" VerticalOptions="Center">
                                        <Label Text="₱" FontSize="16" FontAttributes="Bold" FontFamily="SpaceGroteskBold" TextColor="White" Opacity="0.9" VerticalOptions="End" Margin="0,0,0,3" />
                                        <Label Text="{Binding TotalBalance.Amount, StringFormat='{0:N2}'}" FontSize="26" FontAttributes="Bold" FontFamily="SpaceGroteskBold" TextColor="White" LineBreakMode="NoWrap" VerticalOptions="End" />
                                    </HorizontalStackLayout>
                                    <Label Text="**** **** ****  7281" FontSize="13" FontAttributes="Bold" TextColor="White" Opacity="0.9" CharacterSpacing="1" Margin="0,10,0,0" />
                                    <Grid ColumnDefinitions="*,Auto" Margin="0,10,0,0">
                                        <Label Grid.Column="0" Text="{Binding UserName}" FontSize="11" TextColor="White" Opacity="0.65" LineBreakMode="TailTruncation" VerticalOptions="Center" />
                                        <Label Grid.Column="1" Text="{Binding AccountCount, StringFormat='{0} accounts'}" FontSize="11" TextColor="{StaticResource FinoraLime}" Opacity="0.9" VerticalOptions="Center" />
                                    </Grid>
                                </VerticalStackLayout>
                                <!-- lime sparkle accents -->
                                <Polygon Points="10,0 12,8 20,10 12,12 10,20 8,12 0,10 8,8"
                                         Fill="{StaticResource FinoraLime}"
                                         WidthRequest="26" HeightRequest="26"
                                         HorizontalOptions="End" VerticalOptions="Start" Margin="0,26,96,0" />
                                <Border WidthRequest="7" HeightRequest="7" Background="{StaticResource FinoraLime}" StrokeThickness="0" Opacity="0.8"
                                        HorizontalOptions="End" VerticalOptions="Start" Margin="0,74,62,0">
                                    <Border.StrokeShape><Ellipse /></Border.StrokeShape>
                                </Border>
                            </Grid>
                            <!-- lime contactless bar -->
                            <Border Grid.Column="1" Background="{StaticResource FinoraLime}" Stroke="{StaticResource FinoraLime}" StrokeThickness="0" WidthRequest="38" VerticalOptions="Fill" Margin="10,20,4,20">
                                <Border.StrokeShape><RoundRectangle CornerRadius="100" /></Border.StrokeShape>
                                <Path Aspect="Uniform" WidthRequest="20" HeightRequest="20" Data="M 3,4 A 6,6 0 0 1 3,16 M 8,2 A 11,11 0 0 1 8,18 M 13,0 A 16,16 0 0 1 13,20"
                                      Stroke="{StaticResource FinoraInk}" StrokeThickness="1.6" StrokeLineCap="Round" Fill="Transparent"
                                      HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                        </Grid>
                    </Border>
                    <!-- Add account pill straddling the top edge -->
                    <Border VerticalOptions="Start" HorizontalOptions="End" Margin="0,0,18,0"
                            Background="{StaticResource FinoraLime}" Stroke="{StaticResource FinoraInk}" StrokeThickness="1.5" Padding="12,7">
                        <Border.StrokeShape><RoundRectangle CornerRadius="100" /></Border.StrokeShape>
                        <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding AddAccountCommand}" /></Border.GestureRecognizers>
                        <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                            <Border WidthRequest="20" HeightRequest="20" Background="{StaticResource FinoraInk}" StrokeThickness="0" VerticalOptions="Center">
                                <Border.StrokeShape><Ellipse /></Border.StrokeShape>
                                <Label Text="+" FontSize="13" FontAttributes="Bold" TextColor="{StaticResource FinoraLime}" HorizontalOptions="Center" VerticalOptions="Center" Margin="0,-2,0,0" />
                            </Border>
                            <Label Text="Account" FontSize="11" FontAttributes="Bold" TextColor="{StaticResource FinoraInk}" VerticalOptions="Center" />
                        </HorizontalStackLayout>
                    </Border>
                </Grid>

                <!-- Tabs -->
                <Border Background="{StaticResource FinoraCard}" Stroke="{StaticResource FinoraInk}" StrokeThickness="1.5" Padding="6">
                    <Border.StrokeShape><RoundRectangle CornerRadius="100" /></Border.StrokeShape>
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="6">
                        <Border Grid.Column="0" Padding="0,12" Background="{StaticResource FinoraLime}" Stroke="{StaticResource FinoraInk}" StrokeThickness="1.5">
                            <Border.StrokeShape><RoundRectangle CornerRadius="100" /></Border.StrokeShape>
                            <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding ShowAccountsTabCommand}" /></Border.GestureRecognizers>
                            <Border.Triggers><DataTrigger TargetType="Border" Binding="{Binding IsAccountsTab}" Value="False"><Setter Property="Background" Value="Transparent" /><Setter Property="StrokeThickness" Value="0" /></DataTrigger></Border.Triggers>
                            <Label Text="Accounts" FontSize="13" FontAttributes="Bold" TextColor="{StaticResource FinoraInk}" HorizontalOptions="Center" />
                        </Border>
                        <Border Grid.Column="1" Padding="0,12" Background="Transparent" StrokeThickness="0">
                            <Border.StrokeShape><RoundRectangle CornerRadius="100" /></Border.StrokeShape>
                            <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding ShowHistoryTabCommand}" /></Border.GestureRecognizers>
                            <Border.Triggers><DataTrigger TargetType="Border" Binding="{Binding ShowHistory}" Value="True"><Setter Property="Background" Value="{StaticResource FinoraLime}" /><Setter Property="Stroke" Value="{StaticResource FinoraInk}" /><Setter Property="StrokeThickness" Value="1.5" /></DataTrigger></Border.Triggers>
                            <Label Text="History" FontSize="13" FontAttributes="Bold" TextColor="{StaticResource FinoraInk}" HorizontalOptions="Center" />
                        </Border>
                    </Grid>
                </Border>

                <!-- Accounts Tab -->
                <VerticalStackLayout Spacing="10" IsVisible="{Binding IsAccountsTab}">
                    <CollectionView ItemsSource="{Binding Accounts}" SelectionMode="None">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="dtos:AccountDto">
                                <SwipeView>
                                    <SwipeView.RightItems>
                                        <SwipeItems>
                                            <SwipeItem Text="Edit" BackgroundColor="#161B16"
                                                       Command="{Binding Source={x:Reference AccountsPageView}, Path=BindingContext.EditAccountCommand}"
                                                       CommandParameter="{Binding .}" />
                                            <SwipeItem Text="Delete" BackgroundColor="#DC2626"
                                                       Command="{Binding Source={x:Reference AccountsPageView}, Path=BindingContext.DeleteAccountCommand}"
                                                       CommandParameter="{Binding .}" />
                                        </SwipeItems>
                                    </SwipeView.RightItems>
                                    <Border Background="{StaticResource FinoraCard}" Stroke="{StaticResource FinoraInk}" StrokeThickness="1.5" Padding="14" Margin="0,4">
                                        <Border.StrokeShape><RoundRectangle CornerRadius="24" /></Border.StrokeShape>
                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                            <controls:FinoraIconView Grid.Column="0" Icon="{Binding Icon}" Name="{Binding Name}" Size="52" VerticalOptions="Center" />
                                            <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
                                                <HorizontalStackLayout Spacing="6">
                                                    <Label Text="{Binding Name}" FontSize="15" FontAttributes="Bold" TextColor="{StaticResource FinoraInk}" />
                                                    <Border Background="{StaticResource FinoraLime}" Stroke="{StaticResource FinoraInk}" StrokeThickness="1" Padding="8,2" VerticalOptions="Center" IsVisible="{Binding IsDefault}">
                                                        <Border.StrokeShape><RoundRectangle CornerRadius="100" /></Border.StrokeShape>
                                                        <Label Text="✓ Default" FontSize="10" FontAttributes="Bold" TextColor="{StaticResource FinoraInk}" />
                                                    </Border>
                                                </HorizontalStackLayout>
                                                <Label Text="{Binding Type}" FontSize="11" FontAttributes="Bold" TextColor="#6F7668" />
                                                <Label Text="{Binding Balance, Converter={StaticResource MoneyConverter}}" FontSize="16" FontAttributes="Bold" TextColor="{StaticResource FinoraInk}" />
                                            </VerticalStackLayout>
                                            <Border Grid.Column="2" WidthRequest="38" HeightRequest="38" Background="{StaticResource FinoraCream}" Stroke="{StaticResource FinoraInk}" StrokeThickness="1.2" VerticalOptions="Center">
                                                <Border.StrokeShape><Ellipse /></Border.StrokeShape>
                                                <Border.GestureRecognizers>
                                                    <TapGestureRecognizer Command="{Binding Source={x:Reference AccountsPageView}, Path=BindingContext.AccountActionsCommand}" CommandParameter="{Binding .}" />
                                                </Border.GestureRecognizers>
                                                <Label Text="⋮" FontSize="16" FontAttributes="Bold" TextColor="{StaticResource FinoraInk}" HorizontalOptions="Center" VerticalOptions="Center" />
                                            </Border>
                                        </Grid>
                                    </Border>
                                </SwipeView>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                        <CollectionView.EmptyView>
                            <controls:FinoraEmptyState Title="No accounts yet"
                                                     Subtitle="Add your first account to start tracking"
                                                     IconKey="wallet" />
                        </CollectionView.EmptyView>
                    </CollectionView>
                    <Button Text="+ Add Account" Command="{Binding AddAccountCommand}" Style="{StaticResource PrimaryButtonStyle}" />
                </VerticalStackLayout>

                <!-- History Tab -->
                <VerticalStackLayout Spacing="8" IsVisible="{Binding ShowHistory}">
                    <CollectionView ItemsSource="{Binding History}" SelectionMode="None">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="services:AccountHistoryEntryDto">
                                <Border Background="{StaticResource FinoraCard}" Stroke="#D3D9BE" StrokeThickness="1" Padding="12" Margin="0,4">
                                    <Border.StrokeShape><RoundRectangle CornerRadius="20" /></Border.StrokeShape>
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                        <Border Grid.Column="0" WidthRequest="42" HeightRequest="42" BackgroundColor="{Binding ActionColor, Converter={StaticResource ColorConverter}}" Stroke="{StaticResource FinoraInk}" StrokeThickness="1" VerticalOptions="Center">
                                            <Border.StrokeShape><RoundRectangle CornerRadius="14" /></Border.StrokeShape>
                                            <Label Text="{Binding ActionIcon}" FontSize="17" HorizontalOptions="Center" VerticalOptions="Center" />
                                        </Border>
                                        <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                            <Label Text="{Binding AccountName}" FontSize="14" FontAttributes="Bold" TextColor="{StaticResource FinoraInk}" />
                                            <Label Text="{Binding Details}" FontSize="12" TextColor="#6F7668" LineBreakMode="WordWrap" />
                                        </VerticalStackLayout>
                                        <Label Grid.Column="2" Text="{Binding TimeLabel}" FontSize="11" TextColor="#6F7668" VerticalOptions="Center" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                        <CollectionView.EmptyView>
                            <controls:FinoraEmptyState Title="No history yet"
                                                     Subtitle="Account changes will show up here"
                                                     IconKey="sync" />
                        </CollectionView.EmptyView>
                    </CollectionView>
                </VerticalStackLayout>
            </VerticalStackLayout>
            </ScrollView>
        </RefreshView>

        <controls:FinoraTabBar VerticalOptions="End" ActiveTab="Accounts" />

        <controls:ToastHost />
        <controls:ConfirmModalHost />
        <controls:ChoiceSheetHost />
        <controls:SuccessOverlayHost />
    </Grid>
</ContentPage>
