<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:FinanceApp.Mobile.Views.Controls"
             x:Class="FinanceApp.Mobile.Views.MorePage"
             Title="More"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource PayCream}">

    <Grid>
        <ScrollView>
            <VerticalStackLayout Spacing="14" Padding="18,14,18,100">
                <Grid ColumnDefinitions="Auto,*,Auto" VerticalOptions="Center">
                    <Border WidthRequest="48" HeightRequest="48" Background="#D9C6A5" Stroke="{StaticResource PayInk}" StrokeThickness="1.5">
                        <Border.StrokeShape><Ellipse /></Border.StrokeShape>
                        <Label x:Name="AvatarInitial" Text="G" FontSize="20" FontAttributes="Bold" TextColor="{StaticResource PayInk}" HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>
                    <VerticalStackLayout Grid.Column="1" Margin="10,0" VerticalOptions="Center">
                        <Label x:Name="ProfileName" Text="Guest" FontSize="12" TextColor="#6F7668" LineBreakMode="TailTruncation" />
                        <Label Text="More" FontSize="20" FontAttributes="Bold" TextColor="{StaticResource PayInk}" />
                    </VerticalStackLayout>
                    <Border Grid.Column="2" WidthRequest="46" HeightRequest="46" Background="{StaticResource PayCard}" Stroke="{StaticResource PayInk}" StrokeThickness="1.5">
                        <Border.StrokeShape><Ellipse /></Border.StrokeShape>
                        <controls:PaytinIconView IconKey="bell" ShowBadge="False" Light="True" Size="22" HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>
                </Grid>

                <Border Style="{StaticResource HeroCardStyle}" Padding="18">
                    <Grid ColumnDefinitions="*,Auto">
                        <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                            <Label Text="Paytin Pro" FontSize="16" FontAttributes="Bold" TextColor="White" />
                            <Label Text="Insights, AI budgets and forecasts" FontSize="12" TextColor="White" Opacity="0.7" />
                        </VerticalStackLayout>
                        <Border Grid.Column="1" Background="{StaticResource PayLime}" StrokeThickness="0" Padding="14,10" VerticalOptions="Center">
                            <Border.StrokeShape><RoundRectangle CornerRadius="100" /></Border.StrokeShape>
                            <Label Text="Explore →" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource PayInk}" />
                        </Border>
                    </Grid>
                </Border>

                <Border Background="{StaticResource PayCard}" Stroke="{StaticResource PayInk}" StrokeThickness="1.5" Padding="8">
                    <Border.StrokeShape><RoundRectangle CornerRadius="28" /></Border.StrokeShape>
                    <VerticalStackLayout Spacing="0">
                        <HorizontalStackLayout Spacing="14" Padding="10,12">
                            <controls:PaytinIconView IconKey="target" Size="46" Light="True" VerticalOptions="Center" />
                            <VerticalStackLayout Spacing="2" VerticalOptions="Center" HorizontalOptions="Fill">
                                <Label Text="Goals" FontSize="15" FontAttributes="Bold" TextColor="{StaticResource PayInk}" />
                                <Label Text="Track your savings targets" FontSize="12" TextColor="#6F7668" />
                            </VerticalStackLayout>
                            <Label Text="›" FontSize="24" TextColor="{StaticResource PayInk}" VerticalOptions="Center" />
                            <HorizontalStackLayout.GestureRecognizers><TapGestureRecognizer Tapped="OnGoalsTapped" /></HorizontalStackLayout.GestureRecognizers>
                        </HorizontalStackLayout>
                        <BoxView Style="{StaticResource DividerStyle}" Margin="14,0" />
                        <HorizontalStackLayout Spacing="14" Padding="10,12">
                            <controls:PaytinIconView IconKey="grid" Size="46" Light="True" VerticalOptions="Center" />
                            <VerticalStackLayout Spacing="2" VerticalOptions="Center" HorizontalOptions="Fill">
                                <Label Text="Categories" FontSize="15" FontAttributes="Bold" TextColor="{StaticResource PayInk}" />
                                <Label Text="Organize expenses and income" FontSize="12" TextColor="#6F7668" />
                            </VerticalStackLayout>
                            <Label Text="›" FontSize="24" TextColor="{StaticResource PayInk}" VerticalOptions="Center" />
                            <HorizontalStackLayout.GestureRecognizers><TapGestureRecognizer Tapped="OnCategoriesTapped" /></HorizontalStackLayout.GestureRecognizers>
                        </HorizontalStackLayout>
                        <BoxView Style="{StaticResource DividerStyle}" Margin="14,0" />
                        <HorizontalStackLayout Spacing="14" Padding="10,12">
                            <controls:PaytinIconView IconKey="chart" Size="46" VerticalOptions="Center" />
                            <VerticalStackLayout Spacing="2" VerticalOptions="Center" HorizontalOptions="Fill">
                                <Label Text="Analytics" FontSize="15" FontAttributes="Bold" TextColor="{StaticResource PayInk}" />
                                <Label Text="Charts and spending insights" FontSize="12" TextColor="#6F7668" />
                            </VerticalStackLayout>
                            <Label Text="›" FontSize="24" TextColor="{StaticResource PayInk}" VerticalOptions="Center" />
                            <HorizontalStackLayout.GestureRecognizers><TapGestureRecognizer Tapped="OnAnalyticsTapped" /></HorizontalStackLayout.GestureRecognizers>
                        </HorizontalStackLayout>
                        <BoxView Style="{StaticResource DividerStyle}" Margin="14,0" />
                        <HorizontalStackLayout Spacing="14" Padding="10,12">
                            <controls:PaytinIconView IconKey="bot" Size="46" Light="True" VerticalOptions="Center" />
                            <VerticalStackLayout Spacing="2" VerticalOptions="Center" HorizontalOptions="Fill">
                                <Label Text="AI Assistant" FontSize="15" FontAttributes="Bold" TextColor="{StaticResource PayInk}" />
                                <Label Text="Chat about your money" FontSize="12" TextColor="#6F7668" />
                            </VerticalStackLayout>
                            <Label Text="›" FontSize="24" TextColor="{StaticResource PayInk}" VerticalOptions="Center" />
                            <HorizontalStackLayout.GestureRecognizers><TapGestureRecognizer Tapped="OnChatTapped" /></HorizontalStackLayout.GestureRecognizers>
                        </HorizontalStackLayout>
                        <BoxView Style="{StaticResource DividerStyle}" Margin="14,0" />
                        <HorizontalStackLayout Spacing="14" Padding="10,12">
                            <controls:PaytinIconView IconKey="bulb" Size="46" Light="True" VerticalOptions="Center" />
                            <VerticalStackLayout Spacing="2" VerticalOptions="Center" HorizontalOptions="Fill">
                                <Label Text="Budget Ideas" FontSize="15" FontAttributes="Bold" TextColor="{StaticResource PayInk}" />
                                <Label Text="AI suggestions for smarter budgets" FontSize="12" TextColor="#6F7668" />
                            </VerticalStackLayout>
                            <Label Text="›" FontSize="24" TextColor="{StaticResource PayInk}" VerticalOptions="Center" />
                            <HorizontalStackLayout.GestureRecognizers><TapGestureRecognizer Tapped="OnBudgetSuggestionsTapped" /></HorizontalStackLayout.GestureRecognizers>
                        </HorizontalStackLayout>
                        <BoxView Style="{StaticResource DividerStyle}" Margin="14,0" />
                        <HorizontalStackLayout Spacing="14" Padding="10,12">
                            <controls:PaytinIconView IconKey="calendar" Size="46" Light="True" VerticalOptions="Center" />
                            <VerticalStackLayout Spacing="2" VerticalOptions="Center" HorizontalOptions="Fill">
                                <Label Text="Calendar" FontSize="15" FontAttributes="Bold" TextColor="{StaticResource PayInk}" />
                                <Label Text="Money day by day" FontSize="12" TextColor="#6F7668" />
                            </VerticalStackLayout>
                            <Label Text="›" FontSize="24" TextColor="{StaticResource PayInk}" VerticalOptions="Center" />
                            <HorizontalStackLayout.GestureRecognizers><TapGestureRecognizer Tapped="OnCalendarTapped" /></HorizontalStackLayout.GestureRecognizers>
                        </HorizontalStackLayout>
                        <BoxView Style="{StaticResource DividerStyle}" Margin="14,0" />
                        <HorizontalStackLayout Spacing="14" Padding="10,12">
                            <controls:PaytinIconView IconKey="forecast" Size="46" VerticalOptions="Center" />
                            <VerticalStackLayout Spacing="2" VerticalOptions="Center" HorizontalOptions="Fill">
                                <Label Text="Forecasts" FontSize="15" FontAttributes="Bold" TextColor="{StaticResource PayInk}" />
                                <Label Text="Predictions and smart insights" FontSize="12" TextColor="#6F7668" />
                            </VerticalStackLayout>
                            <Label Text="›" FontSize="24" TextColor="{StaticResource PayInk}" VerticalOptions="Center" />
                            <HorizontalStackLayout.GestureRecognizers><TapGestureRecognizer Tapped="OnPredictionsTapped" /></HorizontalStackLayout.GestureRecognizers>
                        </HorizontalStackLayout>
                        <BoxView Style="{StaticResource DividerStyle}" Margin="14,0" />
                        <HorizontalStackLayout Spacing="14" Padding="10,12">
                            <controls:PaytinIconView IconKey="settings" Size="46" Light="True" VerticalOptions="Center" />
                            <VerticalStackLayout Spacing="2" VerticalOptions="Center" HorizontalOptions="Fill">
                                <Label Text="Profile &amp; Settings" FontSize="15" FontAttributes="Bold" TextColor="{StaticResource PayInk}" />
                                <Label Text="Account, sync and preferences" FontSize="12" TextColor="#6F7668" />
                            </VerticalStackLayout>
                            <Label Text="›" FontSize="24" TextColor="{StaticResource PayInk}" VerticalOptions="Center" />
                            <HorizontalStackLayout.GestureRecognizers><TapGestureRecognizer Tapped="OnProfileTapped" /></HorizontalStackLayout.GestureRecognizers>
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </ScrollView>

        <controls:PaytinTabBar VerticalOptions="End" ActiveTab="More" />
    </Grid>
</ContentPage>
