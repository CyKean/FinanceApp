<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:FinanceApp.Mobile.ViewModels"
             xmlns:converters="clr-namespace:FinanceApp.Mobile.Converters"
             xmlns:controls="clr-namespace:FinanceApp.Mobile.Views.Controls"
             x:Class="FinanceApp.Mobile.Views.SettingsPage"
             x:DataType="viewmodels:SettingsViewModel"
             Title="{Binding Title}"
             Shell.NavBarIsVisible="False">

    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:InverseBoolConverter x:Key="InverseBoolConverter" />
            <converters:NullToBoolConverter x:Key="NullToBoolConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid>
    <RefreshView Command="{Binding RefreshCommand}" IsRefreshing="{Binding IsBusy}">
        <ScrollView>
            <VerticalStackLayout Spacing="16" Padding="16">
                <!-- Back to More -->
                <HorizontalStackLayout Spacing="4" VerticalOptions="Center">
                    <HorizontalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnBackTapped" />
                    </HorizontalStackLayout.GestureRecognizers>
                    <Label Text="‹" FontSize="24" FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryLight}}" VerticalOptions="Center" />
                    <Label Text="Back" FontSize="15" FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryLight}}" VerticalOptions="Center" />
                </HorizontalStackLayout>
                <!-- User Info -->
                <Border Style="{StaticResource CardFrameStyle}" Padding="16">
                    <VerticalStackLayout Spacing="8">
                        <HorizontalStackLayout Spacing="12">
                            <Border WidthRequest="64" HeightRequest="64" Background="#512BD4" StrokeThickness="0">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="32" />
                                </Border.StrokeShape>
                                <Label Text="👤" VerticalOptions="Center" HorizontalOptions="Center" FontSize="28" />
                            </Border>
                            <VerticalStackLayout Spacing="4" VerticalOptions="Center">
                                <Label Text="Signed in as" Style="{StaticResource CaptionLabelStyle}" />
                                <Label Text="{Binding UserEmail}" Style="{StaticResource UserEmailLabelStyle}" />
                            </VerticalStackLayout>
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <!-- Sync Section -->
                <Border Style="{StaticResource CardFrameStyle}" Padding="16">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="Synchronization" Style="{StaticResource SectionHeaderStyle}" />
                        
                        <HorizontalStackLayout Spacing="12">
                            <VerticalStackLayout Spacing="4" HorizontalOptions="Fill">
                                <Label Text="Pending" Style="{StaticResource SyncDetailCaptionStyle}" />
                                <Label Text="{Binding SyncStatus.PendingCount}" Style="{StaticResource SyncDetailValueStyle}" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Spacing="4" HorizontalOptions="Fill">
                                <Label Text="Failed" Style="{StaticResource SyncDetailCaptionStyle}" />
                                <Label Text="{Binding SyncStatus.FailedCount}" Style="{StaticResource SyncDetailValueStyle}" TextColor="Red" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Spacing="4" HorizontalOptions="Fill">
                                <Label Text="Last Sync" Style="{StaticResource SyncDetailCaptionStyle}" />
                                <Label Text="{Binding SyncStatus.LastSyncAt, Converter={StaticResource ManilaTimeConverter}, StringFormat='{0:MMM dd, HH:mm}'}" Style="{StaticResource SyncDetailValueStyle}" />
                            </VerticalStackLayout>
                        </HorizontalStackLayout>

                        <Button Text="Sync Now" 
                                Command="{Binding SyncNowCommand}"
                                IsEnabled="{Binding IsSyncing, Converter={StaticResource InverseBoolConverter}}"
                                Style="{StaticResource PrimaryButtonStyle}">
                            <Button.Triggers>
                                <DataTrigger TargetType="{x:Type Button}" Binding="{Binding IsSyncing}" Value="True">
                                    <Setter Property="Text" Value="Syncing..." />
                                </DataTrigger>
                            </Button.Triggers>
                        </Button>

                        <Label Text="{Binding SyncStatus.LastError}" 
                               Style="{StaticResource SyncErrorLabelStyle}"
                               IsVisible="{Binding SyncStatus.LastError, Converter={StaticResource NullToBoolConverter}}"
                               TextColor="Red" />
                    </VerticalStackLayout>
                </Border>

                <!-- Sync History -->
                <Border Style="{StaticResource CardFrameStyle}" Padding="16">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="Sync History" Style="{StaticResource SectionHeaderStyle}" />
                        <CollectionView ItemsSource="{Binding RecentSyncOperations}" HeightRequest="240">
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <VerticalStackLayout Spacing="2" Padding="0,6">
                                        <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                                            <Label Text="{Binding EntityType}"
                                                   FontSize="14"
                                                   FontAttributes="Bold"
                                                   TextColor="{AppThemeBinding Light={StaticResource OnSurface}, Dark={StaticResource OnSurfaceDark}}"
                                                   VerticalOptions="Center"
                                                   HorizontalOptions="Fill" />
                                            <Label Text="{Binding OperationType}"
                                                   FontSize="12"
                                                   TextColor="{AppThemeBinding Light={StaticResource OnSurfaceVariant}, Dark={StaticResource OnSurfaceVariantDark}}"
                                                   VerticalOptions="Center" />
                                            <Label Text="{Binding Status}"
                                                   FontSize="12"
                                                   FontAttributes="Bold"
                                                   TextColor="{Binding Status, Converter={StaticResource SyncStatusToColorConverter}}"
                                                   VerticalOptions="Center" />
                                        </HorizontalStackLayout>
                                        <Label Text="{Binding LastAttemptAt, Converter={StaticResource ManilaTimeConverter}, StringFormat='{0:MMM dd, HH:mm}'}"
                                               FontSize="12"
                                               TextColor="{AppThemeBinding Light={StaticResource OnSurfaceVariant}, Dark={StaticResource OnSurfaceVariantDark}}" />
                                        <Label Text="{Binding ErrorMessage}"
                                               Style="{StaticResource SyncErrorLabelStyle}"
                                               IsVisible="{Binding ErrorMessage, Converter={StaticResource NullToBoolConverter}}"
                                               TextColor="{StaticResource Error}" />
                                    </VerticalStackLayout>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                            <CollectionView.EmptyView>
                                <Label Text="No sync activity yet"
                                       Style="{StaticResource MutedLabelStyle}"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center" />
                            </CollectionView.EmptyView>
                        </CollectionView>
                    </VerticalStackLayout>
                </Border>

                <!-- AI Assistant -->
                <Border Style="{StaticResource CardFrameStyle}" Padding="16">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="AI Assistant" Style="{StaticResource SectionHeaderStyle}" />
                        <HorizontalStackLayout Spacing="14" Padding="4,4">
                            <Label Text="&#x1F4AC;" FontSize="24" WidthRequest="28" HorizontalOptions="Center" VerticalOptions="Center" />
                            <VerticalStackLayout Spacing="2" VerticalOptions="Center" HorizontalOptions="Fill">
                                <Label Text="Chat &amp; budget ideas" Style="{StaticResource BodyLabelStyle}" FontAttributes="Bold" />
                                <Label Text="Manage the AI provider and API key" Style="{StaticResource MutedLabelStyle}" />
                            </VerticalStackLayout>
                            <Label Text="&#x203A;" FontSize="24" TextColor="{AppThemeBinding Light={StaticResource OnSurfaceVariant}, Dark={StaticResource OnSurfaceVariantDark}}" VerticalOptions="Center" />
                            <HorizontalStackLayout.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnAiAssistantTapped" />
                            </HorizontalStackLayout.GestureRecognizers>
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <!-- App Info -->
                <Border Style="{StaticResource CardFrameStyle}" Padding="16">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="App Information" Style="{StaticResource SectionHeaderStyle}" />
                        <HorizontalStackLayout Spacing="12">
                            <Label Text="Version" Style="{StaticResource InfoLabelStyle}" />
                            <Label Text="{Binding AppVersion}" Style="{StaticResource InfoValueLabelStyle}" HorizontalOptions="EndAndExpand" />
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <!-- Danger Zone -->
                <Border Style="{StaticResource CardFrameStyle}" Padding="16" Background="#FFF5F5">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="Danger Zone" Style="{StaticResource SectionHeaderStyle}" TextColor="Red" />
                        <Button Text="Logout" 
                                Command="{Binding LogoutCommand}"
                                Style="{StaticResource DangerButtonStyle}" />
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </ScrollView>
    </RefreshView>

        <!-- Toasts -->
        <controls:ToastHost />

        <!-- Custom confirmation modal -->
        <controls:ConfirmModalHost />
    </Grid>
</ContentPage>