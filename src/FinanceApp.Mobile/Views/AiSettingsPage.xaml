<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:FinanceApp.Mobile.ViewModels"
             xmlns:converters="clr-namespace:FinanceApp.Mobile.Converters"
             xmlns:controls="clr-namespace:FinanceApp.Mobile.Views.Controls"
             x:Class="FinanceApp.Mobile.Views.AiSettingsPage"
             x:DataType="viewmodels:AiSettingsViewModel"
             Title="{Binding Title}"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{DynamicResource FinoraCream}"
             x:Name="AiSettingsPageView">

    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:BoolToStringConverter x:Key="AiStatusConverter"
                                              TrueValue="Cloud AI enabled"
                                              FalseValue="On-device answers only" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid>
        <ScrollView>
            <VerticalStackLayout Spacing="16" Padding="16">
                <!-- Header -->
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                    <Border WidthRequest="46" HeightRequest="46"
                            Background="{DynamicResource FinoraCard}"
                            Stroke="{DynamicResource FinoraInk}" StrokeThickness="1.5"
                            VerticalOptions="Center">
                        <Border.StrokeShape>
                            <Ellipse />
                        </Border.StrokeShape>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnBackTapped" />
                        </Border.GestureRecognizers>
                        <Label Text="←"
                               FontSize="20"
                               FontAttributes="Bold"
                               TextColor="{DynamicResource FinoraInk}"
                               VerticalOptions="Center"
                               HorizontalOptions="Center" />
                    </Border>

                    <VerticalStackLayout Grid.Column="1" Spacing="0" VerticalOptions="Center">
                        <Label Text="AI Assistant" FontSize="18" FontAttributes="Bold" FontFamily="SpaceGroteskBold" TextColor="{DynamicResource FinoraInk}" />
                        <Label Text="Connect a model for open answers" FontSize="12" TextColor="{DynamicResource FinoraMuted}" />
                    </VerticalStackLayout>

                    <controls:FinoraIconView Grid.Column="2" IconKey="bot" Size="46" VerticalOptions="Center" />
                </Grid>

                <!-- Status -->
                <Border Style="{StaticResource HeroCardStyle}">
                    <VerticalStackLayout Spacing="6">
                        <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                            <Label Text="Status" FontSize="12" TextColor="White" Opacity="0.7" VerticalOptions="Center" />
                            <Border Background="{DynamicResource FinoraLime}" StrokeThickness="0" Padding="10,4" VerticalOptions="Center">
                                <Border.StrokeShape><RoundRectangle CornerRadius="100" /></Border.StrokeShape>
                                <Label Text="{Binding IsConfigured, Converter={StaticResource AiStatusConverter}}"
                                       FontSize="11" FontAttributes="Bold" TextColor="{DynamicResource FinoraInk}" />
                            </Border>
                        </HorizontalStackLayout>
                        <HorizontalStackLayout Spacing="4">
                            <Label Text="Model" FontSize="12" TextColor="White" Opacity="0.7" />
                            <Label Text="{Binding Model}" FontSize="12" FontAttributes="Bold" TextColor="White" />
                        </HorizontalStackLayout>
                        <Label Text="Most questions are answered on-device from your local database. Open-ended ones send a rounded summary - amounts, percentages and category names, but no transaction history, account names, or budget and goal names - to your provider."
                               FontSize="12" TextColor="White" Opacity="0.7"
                               LineBreakMode="WordWrap" />
                    </VerticalStackLayout>
                </Border>

                <!-- Provider -->
                <Border Style="{StaticResource CardFrameStyle}" Padding="16">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Provider" Style="{StaticResource SectionHeaderStyle}" />
                        <Label Text="Free API keys work: pick a provider, paste its key below, then test the connection. Adding a key is what allows anything to be sent off-device."
                               Style="{StaticResource MutedLabelStyle}"
                               LineBreakMode="WordWrap" />
                        <Button Text="Choose a provider&#x2026;"
                                Command="{Binding ChooseProviderCommand}"
                                Style="{StaticResource OutlineButtonStyle}" />
                        <Label Text="Base URL" Style="{StaticResource MutedLabelStyle}" />
                        <Border Style="{StaticResource FieldBorderStyle}">
                            <Entry Text="{Binding BaseUrl}"
                                   Placeholder="https://api.openai.com/v1"
                                   BackgroundColor="Transparent"
                                   HeightRequest="46"
                                   FontSize="15" />
                        </Border>
                        <Label Text="Model" Style="{StaticResource MutedLabelStyle}" />
                        <Border Style="{StaticResource FieldBorderStyle}">
                            <Entry Text="{Binding Model}"
                                   Placeholder="gpt-4o-mini"
                                   BackgroundColor="Transparent"
                                   HeightRequest="46"
                                   FontSize="15" />
                        </Border>
                    </VerticalStackLayout>
                </Border>

                <!-- API key -->
                <Border Style="{StaticResource CardFrameStyle}" Padding="16">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="API key" Style="{StaticResource SectionHeaderStyle}" />
                        <Label Text="Paste an OpenAI-compatible API key. It stays on this device and is never synced."
                               Style="{StaticResource MutedLabelStyle}"
                               LineBreakMode="WordWrap" />
                        <Border Style="{StaticResource FieldBorderStyle}">
                            <Entry Text="{Binding ApiKey}"
                                   Placeholder="sk-..."
                                   IsPassword="True"
                                   BackgroundColor="Transparent"
                                   HeightRequest="46"
                                   FontSize="15" />
                        </Border>
                        <Button Text="Save key"
                                Command="{Binding SaveCommand}"
                                Style="{StaticResource PrimaryButtonStyle}"
                                TextColor="White" />
                        <Button Text="Test connection"
                                Command="{Binding TestConnectionCommand}"
                                IsEnabled="{Binding IsTesting, Converter={StaticResource InverseBoolConverter}}"
                                Style="{StaticResource OutlineButtonStyle}" />
                        <Button Text="Remove key"
                                Command="{Binding ClearCommand}"
                                IsVisible="{Binding IsConfigured}"
                                Style="{StaticResource DangerButtonStyle}" />
                    </VerticalStackLayout>
                </Border>

                <!-- What you get -->
                <Border Style="{StaticResource CardFrameStyle}" Padding="16">
                    <VerticalStackLayout Spacing="6">
                        <Label Text="What you get" Style="{StaticResource SectionHeaderStyle}" />
                        <Label Text="&#x2705; Budget, spending, balance and savings answers work offline"
                               Style="{StaticResource MutedLabelStyle}"
                               LineBreakMode="WordWrap" />
                        <Label Text="&#x2705; General finance topics answered from built-in guidance"
                               Style="{StaticResource MutedLabelStyle}"
                               LineBreakMode="WordWrap" />
                        <Label Text="&#x1F4A1; With a key: open-ended questions answered by a large language model with your financial snapshot for context"
                               Style="{StaticResource MutedLabelStyle}"
                               LineBreakMode="WordWrap" />
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </ScrollView>

        <!-- Toasts -->
        <controls:ToastHost />

        <!-- Custom confirmation modal -->
        <controls:ConfirmModalHost />

        <!-- Success / failure animation -->
        <controls:SuccessOverlayHost />
    </Grid>
</ContentPage>
