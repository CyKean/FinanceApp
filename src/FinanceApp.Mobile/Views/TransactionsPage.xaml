<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:FinanceApp.Mobile.ViewModels"
             xmlns:dtos="clr-namespace:FinanceApp.Application.DTOs;assembly=FinanceApp.Application"
             xmlns:converters="clr-namespace:FinanceApp.Mobile.Converters"
             xmlns:controls="clr-namespace:FinanceApp.Mobile.Views.Controls"
             x:Class="FinanceApp.Mobile.Views.TransactionsPage"
             Title="{Binding Title}"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{DynamicResource FinoraCream}"
             x:Name="TransactionsPageView">

    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:MoneyToStringConverter x:Key="MoneyConverter" />
            <converters:TransactionTypeToColorConverter x:Key="TransactionTypeColorConverter" />
            <converters:SyncStatusToIconConverter x:Key="SyncStatusIconConverter" />
            <converters:SyncStatusToColorConverter x:Key="SyncStatusColorConverter" />
            <converters:NullToBoolConverter x:Key="NullToBoolConverter" />
            <converters:InverseBoolConverter x:Key="InverseBoolConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid>
        <!-- Rows carry a trailing amount column, matching the transaction row template. -->
        <controls:SkeletonTransactions IsVisible="{Binding IsInitialLoading}" />

        <RefreshView Command="{Binding RefreshCommand}" IsRefreshing="{Binding IsBusy}"
                      IsVisible="{Binding IsInitialLoading, Converter={StaticResource InverseBoolConverter}}">
            <CollectionView ItemsSource="{Binding Transactions}"
                            SelectionMode="None"
                            RemainingItemsThreshold="5"
                            RemainingItemsThresholdReachedCommand="{Binding LoadMoreCommand}">
                <CollectionView.Header>
                    <VerticalStackLayout Spacing="12" Padding="18,14,18,0">
                        <Grid ColumnDefinitions="Auto,*,Auto" VerticalOptions="Center">
                            <Border Grid.Column="0" WidthRequest="46" HeightRequest="46" Background="{DynamicResource FinoraCard}" Stroke="{DynamicResource FinoraInk}" StrokeThickness="1.5">
                                <Border.StrokeShape><Ellipse /></Border.StrokeShape>
                                <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnHomeTapped" /></Border.GestureRecognizers>
                                <Label Text="←" FontSize="20" FontAttributes="Bold" TextColor="{DynamicResource FinoraInk}" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="0" VerticalOptions="Center" Margin="10,0">
                                <Label Text="Transactions" FontSize="18" FontAttributes="Bold" TextColor="{DynamicResource FinoraInk}" />
                                <Label Text="History of money in and out" FontSize="12" TextColor="{DynamicResource FinoraMuted}" />
                            </VerticalStackLayout>
                            <Border Grid.Column="2" WidthRequest="46" HeightRequest="46" Background="{DynamicResource FinoraInk}" Stroke="{DynamicResource FinoraInk}" StrokeThickness="1.5">
                                <Border.StrokeShape><Ellipse /></Border.StrokeShape>
                                <Label Text="+" FontSize="24" FontAttributes="Bold" TextColor="{DynamicResource FinoraLime}" HorizontalOptions="Center" VerticalOptions="Center">
                                    <Label.GestureRecognizers><TapGestureRecognizer Command="{Binding AddTransactionCommand}" /></Label.GestureRecognizers>
                                </Label>
                            </Border>
                        </Grid>

                        <controls:FilterBar StartDate="{Binding Filter.StartDate, Mode=TwoWay}"
                                            EndDate="{Binding Filter.EndDate, Mode=TwoWay}"
                                            SelectedType="{Binding Filter.Type, Mode=TwoWay}"
                                            IsExpanded="{Binding IsFilterExpanded, Mode=TwoWay}"
                                            ApplyCommand="{Binding ApplyFilterCommand}"
                                            ClearCommand="{Binding ClearFilterCommand}" />

                        <Grid ColumnDefinitions="*,*" ColumnSpacing="12" IsVisible="{Binding Summary, Converter={StaticResource NullToBoolConverter}}">
                            <Border Grid.Column="0" Style="{StaticResource FinoraLimeCardStyle}" Padding="14">
                                <VerticalStackLayout Spacing="2">
                                    <Label Text="↗ Income" FontSize="11" FontAttributes="Bold" TextColor="{DynamicResource FinoraInk}" />
                                    <Label Text="{Binding Summary.TotalIncome.Amount, StringFormat='{0:N2}'}" FontSize="17" FontAttributes="Bold" TextColor="{DynamicResource FinoraInk}" />
                                </VerticalStackLayout>
                            </Border>
                            <Border Grid.Column="1" Style="{StaticResource FinoraDarkCardStyle}" Padding="14">
                                <VerticalStackLayout Spacing="2">
                                    <Label Text="↘ Expenses" FontSize="11" FontAttributes="Bold" TextColor="{DynamicResource FinoraLime}" />
                                    <Label Text="{Binding Summary.TotalExpense.Amount, StringFormat='{0:N2}'}" FontSize="17" FontAttributes="Bold" TextColor="White" />
                                </VerticalStackLayout>
                            </Border>
                        </Grid>
                        <Border Background="{DynamicResource FinoraCard}" Stroke="{DynamicResource FinoraInk}" StrokeThickness="1.5" Padding="14,10" IsVisible="{Binding Summary, Converter={StaticResource NullToBoolConverter}}">
                            <Border.StrokeShape><RoundRectangle CornerRadius="100" /></Border.StrokeShape>
                            <HorizontalStackLayout Spacing="8" HorizontalOptions="Center">
                                <Label Text="Net" FontSize="12" FontAttributes="Bold" TextColor="{DynamicResource FinoraMuted}" VerticalOptions="Center" />
                                <Label Text="{Binding Summary.NetAmount.Amount, StringFormat='{0:N2}'}" FontSize="14" FontAttributes="Bold" TextColor="{DynamicResource FinoraInk}" VerticalOptions="Center" />
                                <Label Text="•" TextColor="{DynamicResource FinoraMuted}" VerticalOptions="Center" />
                                <Label Text="{Binding Summary.TransactionCount, StringFormat='{0} txns'}" FontSize="12" TextColor="{DynamicResource FinoraMuted}" VerticalOptions="Center" />
                            </HorizontalStackLayout>
                        </Border>
                    </VerticalStackLayout>
                </CollectionView.Header>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="dtos:TransactionDto">
                        <SwipeView>
                            <SwipeView.RightItems>
                                <SwipeItems>
                                    <SwipeItem Text="Edit" BackgroundColor="{DynamicResource FinoraInk}"
                                               Command="{Binding Source={x:Reference TransactionsPageView}, Path=BindingContext.EditTransactionCommand}"
                                               CommandParameter="{Binding .}" />
                                    <SwipeItem Text="Delete" BackgroundColor="{DynamicResource Error}"
                                               Command="{Binding Source={x:Reference TransactionsPageView}, Path=BindingContext.DeleteTransactionCommand}"
                                               CommandParameter="{Binding .}" />
                                </SwipeItems>
                            </SwipeView.RightItems>
                            <Border Background="{DynamicResource FinoraCard}" Stroke="{DynamicResource OutlineVariant}" StrokeThickness="1" Padding="12" Margin="18,4">
                                <Border.StrokeShape><RoundRectangle CornerRadius="22" /></Border.StrokeShape>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding Source={x:Reference TransactionsPageView}, Path=BindingContext.EditTransactionCommand}"
                                        CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>
                                <HorizontalStackLayout Spacing="12">
                                    <controls:FinoraIconView Icon="{Binding CategoryIcon}" Name="{Binding CategoryName}" Size="48" VerticalOptions="Center" />
                                    <VerticalStackLayout Spacing="2" VerticalOptions="Center" HorizontalOptions="Fill">
                                        <Label Text="{Binding CategoryName}" FontSize="14" FontAttributes="Bold" TextColor="{DynamicResource FinoraInk}" />
                                        <Label Text="{Binding Notes}" FontSize="12" TextColor="{DynamicResource FinoraMuted}"
                                               IsVisible="{Binding Notes, Converter={StaticResource NullToBoolConverter}}" />
                                        <HorizontalStackLayout Spacing="6">
                                            <Label Text="{Binding AccountName}" FontSize="11" TextColor="{DynamicResource FinoraMuted}" />
                                            <Label Text="•" FontSize="11" TextColor="{DynamicResource OutlineVariant}" />
                                            <Label Text="{Binding Date, StringFormat='{0:MMM dd, yyyy}'}" FontSize="11" TextColor="{DynamicResource FinoraMuted}" />
                                        </HorizontalStackLayout>
                                    </VerticalStackLayout>
                                    <VerticalStackLayout Spacing="2" VerticalOptions="Center" HorizontalOptions="End">
                                        <Label Text="{Binding Amount, Converter={StaticResource MoneyConverter}}"
                                               FontSize="14" FontAttributes="Bold" TextColor="{DynamicResource FinoraInk}" HorizontalTextAlignment="End" />
                                        <Label Text="{Binding SyncStatus, Converter={StaticResource SyncStatusIconConverter}}"
                                               FontSize="11" FontAttributes="Bold"
                                               TextColor="{Binding SyncStatus, Converter={StaticResource SyncStatusColorConverter}}" HorizontalTextAlignment="End" />
                                    </VerticalStackLayout>
                                </HorizontalStackLayout>
                            </Border>
                        </SwipeView>
                    </DataTemplate>
                </CollectionView.ItemTemplate>

                <CollectionView.Footer>
                    <ActivityIndicator IsRunning="{Binding IsLoadingMore}" IsVisible="{Binding IsLoadingMore}"
                                       HorizontalOptions="Center" VerticalOptions="Center" Margin="0,8,0,96" />
                </CollectionView.Footer>

                <CollectionView.EmptyView>
                    <controls:FinoraEmptyState Title="No transactions found"
                                             Subtitle="Tap + to add your first transaction"
                                             IconKey="receipt" />
                </CollectionView.EmptyView>
            </CollectionView>
        </RefreshView>

        <controls:FinoraTabBar VerticalOptions="End" ActiveTab="Transactions" />

        <controls:TransactionSheetHost />

        <controls:ToastHost />
        <controls:ChoiceSheetHost />
        <controls:ConfirmModalHost />
        <controls:SuccessOverlayHost />
    </Grid>
</ContentPage>
