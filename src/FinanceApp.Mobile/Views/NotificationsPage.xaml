<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:FinanceApp.Mobile.ViewModels"
             xmlns:converters="clr-namespace:FinanceApp.Mobile.Converters"
             xmlns:controls="clr-namespace:FinanceApp.Mobile.Views.Controls"
             xmlns:notifications="clr-namespace:FinanceApp.Application.Notifications;assembly=FinanceApp.Application"
             x:Class="FinanceApp.Mobile.Views.NotificationsPage"
             x:DataType="viewmodels:NotificationsViewModel"
             x:Name="NotificationsPageView"
             Title="{Binding Title}"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{DynamicResource FinoraCream}">

    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:InverseBoolConverter x:Key="InverseBoolConverter" />
            <converters:CountToBoolConverter x:Key="CountToBoolConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*,Auto">
        <VerticalStackLayout Grid.Row="0" Padding="18,14,18,6" Spacing="12">
            <!-- Header -->
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" VerticalOptions="Center">
                <Border Grid.Column="0" WidthRequest="46" HeightRequest="46"
                        Background="{DynamicResource FinoraCard}"
                        Stroke="{DynamicResource FinoraInk}" StrokeThickness="1.5"
                        VerticalOptions="Center">
                    <Border.StrokeShape><Ellipse /></Border.StrokeShape>
                    <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnBackTapped" /></Border.GestureRecognizers>
                    <Label Text="←" FontSize="20" FontAttributes="Bold" TextColor="{DynamicResource FinoraInk}"
                           HorizontalOptions="Center" VerticalOptions="Center" />
                </Border>
                <VerticalStackLayout Grid.Column="1" Spacing="0" VerticalOptions="Center">
                    <Label Text="Notifications" FontSize="18" FontAttributes="Bold" FontFamily="SpaceGroteskBold" TextColor="{DynamicResource FinoraInk}" />
                    <Label Text="{Binding UnreadCount, StringFormat='{0} unread'}" FontSize="12" TextColor="{DynamicResource FinoraMuted}" />
                </VerticalStackLayout>
                <Border Grid.Column="2" Background="{DynamicResource FinoraLime}" Stroke="{DynamicResource FinoraInk}" StrokeThickness="1.5"
                        Padding="12,8" VerticalOptions="Center"
                        IsVisible="{Binding UnreadCount, Converter={StaticResource CountToBoolConverter}}">
                    <Border.StrokeShape><RoundRectangle CornerRadius="100" /></Border.StrokeShape>
                    <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding MarkAllReadCommand}" /></Border.GestureRecognizers>
                    <Label Text="Mark read" FontSize="12" FontAttributes="Bold" TextColor="{DynamicResource FinoraInk}" />
                </Border>
            </Grid>

            <!-- Summary -->
            <Border Style="{StaticResource HeroCardStyle}" IsVisible="{Binding UnreadCount, Converter={StaticResource CountToBoolConverter}}">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" VerticalOptions="Center">
                    <controls:FinoraIconView IconKey="bell" Size="52" VerticalOptions="Center" />
                    <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center" HorizontalOptions="Fill">
                        <Label Text="{Binding UnreadCount, StringFormat='{0} thing(s) need your attention'}" FontSize="15" FontAttributes="Bold" TextColor="White" />
                        <Label Text="Budgets, bills, goals and sync status" FontSize="12" TextColor="White" Opacity="0.7" />
                    </VerticalStackLayout>
                </Grid>
            </Border>
        </VerticalStackLayout>

        <!-- Row 1 so the header stays put and only the feed is replaced. Alerts are
             text-forward, so no leading avatar on those rows. -->
        <controls:SkeletonView Grid.Row="1" IsVisible="{Binding IsInitialLoading}" RowCount="6"
                               RowHeight="84" HasLeadingCircle="False" HasTrailingValue="True" Margin="18,12,18,0" />

        <RefreshView Grid.Row="1" Command="{Binding RefreshCommand}" IsRefreshing="{Binding IsRefreshing, Mode=OneWay}"
                     IsVisible="{Binding IsInitialLoading, Converter={StaticResource InverseBoolConverter}}">
            <ScrollView>
                <VerticalStackLayout Spacing="10" Padding="18,4,18,20">

                    <VerticalStackLayout Spacing="8" IsVisible="{Binding Today.Count, Converter={StaticResource CountToBoolConverter}}">
                        <Label Text="Today" Style="{StaticResource SectionHeaderStyle}" />
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding Today}" Spacing="0">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="notifications:AppNotification">
                                    <Border Background="{DynamicResource FinoraCard}" Stroke="{DynamicResource FinoraInk}" StrokeThickness="1.5" Padding="14" Margin="0,4">
                                        <Border.StrokeShape><RoundRectangle CornerRadius="22" /></Border.StrokeShape>
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding Source={x:Reference NotificationsPageView}, Path=BindingContext.OpenCommand}"
                                                                  CommandParameter="{Binding .}" />
                                        </Border.GestureRecognizers>
                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                            <controls:FinoraIconView Grid.Column="0" IconKey="{Binding IconKey}" Size="44"
                                                                    Accent="{Binding Severity, Converter={StaticResource SeverityToAccentConverter}}"
                                                                    VerticalOptions="Center" />
                                            <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center" HorizontalOptions="Fill">
                                                <HorizontalStackLayout Spacing="6">
                                                    <Label Text="{Binding Title}" FontSize="14" FontAttributes="Bold" TextColor="{DynamicResource FinoraInk}" />
                                                    <Label Text="●" FontSize="9" TextColor="{DynamicResource FinoraLimeDark}" VerticalOptions="Center"
                                                           IsVisible="{Binding IsUnread}" />
                                                </HorizontalStackLayout>
                                                <Label Text="{Binding Body}" FontSize="12" TextColor="{DynamicResource FinoraMuted}" LineBreakMode="WordWrap" />
                                                <Label Text="{Binding TimeLabel}" FontSize="11" TextColor="{DynamicResource MutedSoft}" />
                                            </VerticalStackLayout>
                                            <Border Grid.Column="2" WidthRequest="32" HeightRequest="32" Background="{DynamicResource FinoraCream}" Stroke="{DynamicResource FinoraInk}" StrokeThickness="1.2"
                                                    VerticalOptions="Center">
                                                <Border.StrokeShape><Ellipse /></Border.StrokeShape>
                                                <Border.GestureRecognizers>
                                                    <TapGestureRecognizer Command="{Binding Source={x:Reference NotificationsPageView}, Path=BindingContext.DismissCommand}"
                                                                          CommandParameter="{Binding .}" />
                                                </Border.GestureRecognizers>
                                                <Label Text="×" FontSize="16" FontAttributes="Bold" TextColor="{DynamicResource FinoraInk}"
                                                       HorizontalOptions="Center" VerticalOptions="Center" />
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="8" IsVisible="{Binding Earlier.Count, Converter={StaticResource CountToBoolConverter}}">
                        <Label Text="Earlier" Style="{StaticResource SectionHeaderStyle}" />
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding Earlier}" Spacing="0">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="notifications:AppNotification">
                                    <Border Background="{DynamicResource FinoraCard}" Stroke="{DynamicResource OutlineVariant}" StrokeThickness="1" Padding="14" Margin="0,4">
                                        <Border.StrokeShape><RoundRectangle CornerRadius="22" /></Border.StrokeShape>
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding Source={x:Reference NotificationsPageView}, Path=BindingContext.OpenCommand}"
                                                                  CommandParameter="{Binding .}" />
                                        </Border.GestureRecognizers>
                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                            <controls:FinoraIconView Grid.Column="0" IconKey="{Binding IconKey}" Size="44"
                                                                    Accent="{Binding Severity, Converter={StaticResource SeverityToAccentConverter}}"
                                                                    VerticalOptions="Center" />
                                            <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center" HorizontalOptions="Fill">
                                                <Label Text="{Binding Title}" FontSize="14" FontAttributes="Bold" TextColor="{DynamicResource FinoraInk}" />
                                                <Label Text="{Binding Body}" FontSize="12" TextColor="{DynamicResource FinoraMuted}" LineBreakMode="WordWrap" />
                                                <Label Text="{Binding TimeLabel}" FontSize="11" TextColor="{DynamicResource MutedSoft}" />
                                            </VerticalStackLayout>
                                            <Border Grid.Column="2" WidthRequest="32" HeightRequest="32" Background="{DynamicResource FinoraCream}" Stroke="{DynamicResource FinoraInk}" StrokeThickness="1.2"
                                                    VerticalOptions="Center">
                                                <Border.StrokeShape><Ellipse /></Border.StrokeShape>
                                                <Border.GestureRecognizers>
                                                    <TapGestureRecognizer Command="{Binding Source={x:Reference NotificationsPageView}, Path=BindingContext.DismissCommand}"
                                                                          CommandParameter="{Binding .}" />
                                                </Border.GestureRecognizers>
                                                <Label Text="×" FontSize="16" FontAttributes="Bold" TextColor="{DynamicResource FinoraInk}"
                                                       HorizontalOptions="Center" VerticalOptions="Center" />
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>

                    <controls:FinoraEmptyState Title="All clear"
                                             Subtitle="Budget warnings, upcoming bills and goal milestones will show up here"
                                             IconKey="bell"
                                             IsVisible="{Binding IsEmpty}" />
                </VerticalStackLayout>
            </ScrollView>
        </RefreshView>

        <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Padding="18,0,18,20" ColumnSpacing="10"
              IsVisible="{Binding IsEmpty, Converter={StaticResource InverseBoolConverter}}">
            <Border Grid.Column="0" Background="{DynamicResource FinoraCard}" Stroke="{DynamicResource FinoraInk}" StrokeThickness="1.5" Padding="14,10"
                    IsVisible="{Binding UnreadCount, Converter={StaticResource CountToBoolConverter}}">
                <Border.StrokeShape><RoundRectangle CornerRadius="100" /></Border.StrokeShape>
                <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding ClearAllCommand}" /></Border.GestureRecognizers>
                <Label Text="Clear all" FontSize="13" FontAttributes="Bold" TextColor="{DynamicResource FinoraInk}" HorizontalOptions="Center" />
            </Border>
            <Button Grid.Column="1" Text="Refresh" Command="{Binding RefreshCommand}" Style="{StaticResource PrimaryButtonStyle}" />
        </Grid>

        <controls:ToastHost Grid.Row="0" Grid.RowSpan="3" />
    </Grid>
</ContentPage>