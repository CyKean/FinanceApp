<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:FinanceApp.Mobile.ViewModels"
             xmlns:converters="clr-namespace:FinanceApp.Mobile.Converters"
             xmlns:dtos="clr-namespace:FinanceApp.Application.DTOs;assembly=FinanceApp.Application"
             xmlns:controls="clr-namespace:FinanceApp.Mobile.Views.Controls"
             x:Class="FinanceApp.Mobile.Views.DashboardPage"
             x:DataType="viewmodels:DashboardViewModel"
             Title="{Binding Title}"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource PayCream}">

    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:MoneyToStringConverter x:Key="MoneyConverter" />
            <converters:PercentageToColorConverter x:Key="PercentageColorConverter" />
            <converters:TransactionTypeToColorConverter x:Key="TransactionTypeColorConverter" />
            <converters:CategoryInitialConverter x:Key="InitialConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid>
        <RefreshView Command="{Binding RefreshCommand}" IsRefreshing="{Binding IsBusy}">
            <ScrollView>
                <VerticalStackLayout Spacing="14" Padding="18,14,18,100">
                    <!-- Header -->
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" VerticalOptions="Center">
                        <Border Grid.Column="0" WidthRequest="48" HeightRequest="48" Stroke="{StaticResource PayInk}" StrokeThickness="1.5" Background="#D9C6A5" VerticalOptions="Center">
                            <Border.StrokeShape><Ellipse /></Border.StrokeShape>
                            <Label Text="W" FontSize="20" FontAttributes="Bold" TextColor="{StaticResource PayInk}" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Spacing="0" VerticalOptions="Center">
                            <Label Text="William Current" FontSize="12" TextColor="#6F7668" />
                            <Label Text="Welcome Back" FontSize="18" FontAttributes="Bold" FontFamily="SpaceGroteskBold" TextColor="{StaticResource PayInk}" />
                        </VerticalStackLayout>
                        <Border Grid.Column="2" WidthRequest="46" HeightRequest="46" Background="{StaticResource PayCard}" Stroke="{StaticResource PayInk}" StrokeThickness="1.5" VerticalOptions="Center">
                            <Border.StrokeShape><Ellipse /></Border.StrokeShape>
                            <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding NavigateToSettingsCommand}" /></Border.GestureRecognizers>
                            <Grid>
                                <controls:PaytinIconView IconKey="bell" ShowBadge="False" Light="True" Size="24" HorizontalOptions="Center" VerticalOptions="Center" />
                                <Label Text="●" FontSize="10" TextColor="#E5484D" HorizontalOptions="End" VerticalOptions="Start" Margin="0,9,9,0" />
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- VISA card (Paytin mock copy) -->
                    <Grid>
                        <Border Style="{StaticResource HeroCardStyle}" Padding="0" Margin="0,15,0,0">
                            <Border.StrokeShape><RoundRectangle CornerRadius="34" /></Border.StrokeShape>
                            <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding NavigateToAccountsCommand}" /></Border.GestureRecognizers>
                            <Grid ColumnDefinitions="*,60" Padding="20,16,10,16">
                                <!-- diagonal line texture: absolute so it never drives card height -->
                                <AbsoluteLayout Grid.ColumnSpan="2" HorizontalOptions="Fill" VerticalOptions="Fill" IsClippedToBounds="True" InputTransparent="True">
                                    <BoxView Color="White" Opacity="0.055" Rotation="60" AbsoluteLayout.LayoutBounds="0.5,0.04,1.7,0.008" AbsoluteLayout.LayoutFlags="All" />
                                    <BoxView Color="White" Opacity="0.055" Rotation="60" AbsoluteLayout.LayoutBounds="0.5,0.16,1.7,0.008" AbsoluteLayout.LayoutFlags="All" />
                                    <BoxView Color="White" Opacity="0.055" Rotation="60" AbsoluteLayout.LayoutBounds="0.5,0.28,1.7,0.008" AbsoluteLayout.LayoutFlags="All" />
                                    <BoxView Color="White" Opacity="0.055" Rotation="60" AbsoluteLayout.LayoutBounds="0.5,0.40,1.7,0.008" AbsoluteLayout.LayoutFlags="All" />
                                    <BoxView Color="White" Opacity="0.055" Rotation="60" AbsoluteLayout.LayoutBounds="0.5,0.52,1.7,0.008" AbsoluteLayout.LayoutFlags="All" />
                                    <BoxView Color="White" Opacity="0.055" Rotation="60" AbsoluteLayout.LayoutBounds="0.5,0.64,1.7,0.008" AbsoluteLayout.LayoutFlags="All" />
                                    <BoxView Color="White" Opacity="0.055" Rotation="60" AbsoluteLayout.LayoutBounds="0.5,0.76,1.7,0.008" AbsoluteLayout.LayoutFlags="All" />
                                    <BoxView Color="White" Opacity="0.055" Rotation="60" AbsoluteLayout.LayoutBounds="0.5,0.88,1.7,0.008" AbsoluteLayout.LayoutFlags="All" />
                                </AbsoluteLayout>
                                <!-- card content -->
                                <Grid Grid.Column="0">
                                    <VerticalStackLayout Spacing="4">
                                        <Label Text="VISA" FontSize="13" FontAttributes="Bold" TextColor="White" Opacity="0.85" CharacterSpacing="3" VerticalOptions="Center" />
                                        <Label Text="Balance" FontSize="12" TextColor="White" Opacity="0.65" Margin="0,10,0,0" />
                                        <HorizontalStackLayout Spacing="4" VerticalOptions="Center">
                                            <Label Text="$" FontSize="20" FontAttributes="Bold" FontFamily="SpaceGroteskBold" TextColor="White" VerticalOptions="End" Margin="0,0,0,4" />
                                            <Label Text="{Binding TotalBalance.Amount, StringFormat='{0:N2}'}" FontSize="30" FontAttributes="Bold" FontFamily="SpaceGroteskBold" TextColor="White" VerticalOptions="End" />
                                        </HorizontalStackLayout>
                                        <Label Text="•••• •••• ••••  7281" FontSize="13" TextColor="White" Opacity="0.65" Margin="0,6,0,0" />
                                        <Grid ColumnDefinitions="*,Auto" Margin="0,6,0,0">
                                            <Label Grid.Column="0" Text="William Current" FontSize="11" TextColor="White" Opacity="0.65" VerticalOptions="Center" />
                                            <Label Grid.Column="1" Text="Exp 07/26" FontSize="11" TextColor="White" Opacity="0.65" VerticalOptions="Center" />
                                        </Grid>
                                    </VerticalStackLayout>
                                    <!-- lime sparkle accents -->
                                    <Polygon Points="10,0 12,8 20,10 12,12 10,20 8,12 0,10 8,8"
                                             Fill="{StaticResource PayLime}"
                                             WidthRequest="20" HeightRequest="20"
                                             HorizontalOptions="End" VerticalOptions="Start" Margin="0,16,54,0" />
                                    <Border WidthRequest="6" HeightRequest="6" Background="{StaticResource PayLime}" StrokeThickness="0" Opacity="0.7"
                                            HorizontalOptions="End" VerticalOptions="Start" Margin="0,54,30,0">
                                        <Border.StrokeShape><Ellipse /></Border.StrokeShape>
                                    </Border>
                                </Grid>
                                <!-- lime contactless bar -->
                                <Border Grid.Column="1" Background="{StaticResource PayLime}" Stroke="{StaticResource PayLime}" StrokeThickness="0" WidthRequest="42" VerticalOptions="Fill" Margin="10,14,4,14">
                                    <Border.StrokeShape><RoundRectangle CornerRadius="100" /></Border.StrokeShape>
                                    <Label Text=")))" FontSize="16" FontAttributes="Bold" TextColor="{StaticResource PayInk}" HorizontalOptions="Center" VerticalOptions="Center" />
                                </Border>
                            </Grid>
                        </Border>
                        <!-- Set Budget pill straddling the top edge -->
                        <Border VerticalOptions="Start" HorizontalOptions="End" Margin="0,0,16,0"
                                Background="{StaticResource PayLime}" Stroke="{StaticResource PayInk}" StrokeThickness="1.5" Padding="8,6">
                            <Border.StrokeShape><RoundRectangle CornerRadius="100" /></Border.StrokeShape>
                            <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding NavigateToBudgetsCommand}" /></Border.GestureRecognizers>
                            <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                                <Border WidthRequest="20" HeightRequest="20" Background="{StaticResource PayInk}" StrokeThickness="0" VerticalOptions="Center">
                                    <Border.StrokeShape><Ellipse /></Border.StrokeShape>
                                    <Label Text="+" FontSize="13" FontAttributes="Bold" TextColor="{StaticResource PayLime}" HorizontalOptions="Center" VerticalOptions="Center" Margin="0,-2,0,0" />
                                </Border>
                                <Label Text="Set Budget" FontSize="11" FontAttributes="Bold" TextColor="{StaticResource PayInk}" VerticalOptions="Center" />
                            </HorizontalStackLayout>
                        </Border>
                    </Grid>

                    <!-- Quick actions -->
                    <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="10">
                        <VerticalStackLayout Grid.Column="0" Spacing="6" HorizontalOptions="Center">
                            <Border Style="{StaticResource PayCircleActionStyle}">
                                <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding NavigateToAiSuggestionsCommand}" /></Border.GestureRecognizers>
                                <Path x:Name="QuickAIIcon" Aspect="Uniform" WidthRequest="26" HeightRequest="26" StrokeThickness="2" Stroke="{StaticResource PayInk}" StrokeLineCap="Round" StrokeLineJoin="Round" Fill="Transparent" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <Label Text="AI Ideas" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource PayInk}" HorizontalOptions="Center" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1" Spacing="6" HorizontalOptions="Center">
                            <Border Style="{StaticResource PayCircleActionStyle}">
                                <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding NavigateToAnalyticsCommand}" /></Border.GestureRecognizers>
                                <Path x:Name="QuickStatsIcon" Aspect="Uniform" WidthRequest="26" HeightRequest="26" StrokeThickness="2" Stroke="{StaticResource PayInk}" StrokeLineCap="Round" StrokeLineJoin="Round" Fill="Transparent" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <Label Text="Stats" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource PayInk}" HorizontalOptions="Center" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="2" Spacing="6" HorizontalOptions="Center">
                            <Border Style="{StaticResource PayCircleActionStyle}">
                                <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding NavigateToForecastsCommand}" /></Border.GestureRecognizers>
                                <Path x:Name="QuickForecastIcon" Aspect="Uniform" WidthRequest="26" HeightRequest="26" StrokeThickness="2" Stroke="{StaticResource PayInk}" StrokeLineCap="Round" StrokeLineJoin="Round" Fill="Transparent" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <Label Text="Forecast" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource PayInk}" HorizontalOptions="Center" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="3" Spacing="6" HorizontalOptions="Center">
                            <Border Style="{StaticResource PayCircleActionStyle}">
                                <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding NavigateToMoreCommand}" /></Border.GestureRecognizers>
                                <Path x:Name="QuickMoreIcon" Aspect="Uniform" WidthRequest="24" HeightRequest="24" StrokeThickness="2.5" Stroke="{StaticResource PayInk}" StrokeLineCap="Round" StrokeLineJoin="Round" Fill="Transparent" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <Label Text="More" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource PayInk}" HorizontalOptions="Center" />
                        </VerticalStackLayout>
                    </Grid>

                    <!-- Add money row -->
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                        <Button Grid.Column="0" Text="− Expense" Command="{Binding NavigateToAddExpenseCommand}" Style="{StaticResource PrimaryButtonStyle}" />
                        <Button Grid.Column="1" Text="+ Income" Command="{Binding NavigateToAddIncomeCommand}" Style="{StaticResource SecondaryButtonStyle}" />
                    </Grid>

                    <!-- Recent Activity -->
                    <VerticalStackLayout Spacing="10">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Grid.Column="0" Text="Recent Activity" FontSize="16" FontAttributes="Bold" TextColor="{StaticResource PayInk}" VerticalOptions="Center" />
                            <Label Grid.Column="1" Text="See all ›" FontSize="13" FontAttributes="Bold" TextColor="{StaticResource PayInk}" VerticalOptions="Center">
                                <Label.GestureRecognizers><TapGestureRecognizer Command="{Binding NavigateToTransactionsCommand}" /></Label.GestureRecognizers>
                            </Label>
                        </Grid>
                        <Border Background="{StaticResource PayCard}" Stroke="{StaticResource PayInk}" StrokeThickness="1.5" Padding="8">
                            <Border.StrokeShape><RoundRectangle CornerRadius="28" /></Border.StrokeShape>
                            <CollectionView ItemsSource="{Binding RecentTransactions}" SelectionMode="None" HeightRequest="268">
                                <CollectionView.ItemTemplate>
                                    <DataTemplate x:DataType="dtos:TransactionDto">
                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" Padding="10,10">
                                            <controls:PaytinIconView Grid.Column="0" Icon="{Binding CategoryIcon}" Name="{Binding CategoryName}" Size="46" VerticalOptions="Center" />
                                            <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                                                <Label Text="{Binding CategoryName}" FontSize="14" FontAttributes="Bold" TextColor="{StaticResource PayInk}" />
                                                <Label Text="{Binding Date, StringFormat='{0:dddd, dd MMMM}'}" FontSize="11" TextColor="#6F7668" />
                                            </VerticalStackLayout>
                                            <Label Grid.Column="2" Text="{Binding Amount, Converter={StaticResource MoneyConverter}}" FontSize="14" FontAttributes="Bold" TextColor="{StaticResource PayInk}" VerticalOptions="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                                <CollectionView.EmptyView>
                                    <controls:PaytinEmptyState Title="No transactions yet"
                                                             Subtitle="Tap − Expense or + Income to add one"
                                                             IconKey="receipt" />
                                </CollectionView.EmptyView>
                            </CollectionView>
                        </Border>
                    </VerticalStackLayout>

                    <!-- Savings / budgets / goals (kept, Paytin style) -->
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                        <Border Grid.Column="0" Style="{StaticResource PayLimeCardStyle}">
                            <VerticalStackLayout Spacing="4">
                                <Label Text="◉ Savings" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource PayInk}" />
                                <Label Text="{Binding SavingsRate, StringFormat='{0:F1}%'}" FontSize="26" FontAttributes="Bold" TextColor="{StaticResource PayInk}" />
                                <Label Text="of income saved" FontSize="11" TextColor="{StaticResource PayInk}" Opacity="0.7" />
                            </VerticalStackLayout>
                        </Border>
                        <Border Grid.Column="1" Style="{StaticResource PayDarkCardStyle}">
                            <VerticalStackLayout Spacing="4">
                                <Label Text="◎ Budgets" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource PayLime}" />
                                <Label Text="{Binding ActiveBudgets.Count, StringFormat='{0} active'}" FontSize="20" FontAttributes="Bold" TextColor="White" />
                                <Label Text="Keep it inside the lines" FontSize="11" TextColor="White" Opacity="0.7">
                                    <Label.GestureRecognizers><TapGestureRecognizer Command="{Binding NavigateToBudgetsCommand}" /></Label.GestureRecognizers>
                                </Label>
                            </VerticalStackLayout>
                        </Border>
                    </Grid>

                    <Border Style="{StaticResource CardFrameStyle}">
                        <VerticalStackLayout Spacing="10">
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Grid.Column="0" Text="Spending by Category" FontSize="15" FontAttributes="Bold" TextColor="{StaticResource PayInk}" />
                                <Label Grid.Column="1" Text="›" FontSize="18" FontAttributes="Bold" TextColor="{StaticResource PayInk}">
                                    <Label.GestureRecognizers><TapGestureRecognizer Command="{Binding NavigateToAnalyticsCommand}" /></Label.GestureRecognizers>
                                </Label>
                            </Grid>
                            <CollectionView ItemsSource="{Binding SpendingByCategory}" HeightRequest="170" SelectionMode="None">
                                <CollectionView.ItemTemplate>
                                    <DataTemplate x:DataType="dtos:CategorySpendingDto">
                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" Padding="4,8">
                                            <controls:PaytinIconView Grid.Column="0" Icon="{Binding CategoryIcon}" Name="{Binding CategoryName}" Size="40" VerticalOptions="Center" />
                                            <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                                                <Label Text="{Binding CategoryName}" FontSize="13" FontAttributes="Bold" TextColor="{StaticResource PayInk}" />
                                                <ProgressBar Progress="{Binding Percentage, Converter={StaticResource PercentageConverter}}" ProgressColor="{StaticResource PayInk}" HeightRequest="6" />
                                            </VerticalStackLayout>
                                            <Label Grid.Column="2" Text="{Binding Amount, Converter={StaticResource MoneyConverter}}" FontSize="13" FontAttributes="Bold" TextColor="{StaticResource PayInk}" VerticalOptions="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                                <CollectionView.EmptyView>
                                    <controls:PaytinEmptyState Title="No spending data yet"
                                                             Subtitle="Add expenses to see your breakdown"
                                                             IconKey="chart" />
                                </CollectionView.EmptyView>
                            </CollectionView>
                        </VerticalStackLayout>
                    </Border>

                    <Border Style="{StaticResource CardFrameStyle}">
                        <VerticalStackLayout Spacing="10">
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Grid.Column="0" Text="Goals" FontSize="15" FontAttributes="Bold" TextColor="{StaticResource PayInk}" />
                                <Label Grid.Column="1" Text="›" FontSize="18" FontAttributes="Bold" TextColor="{StaticResource PayInk}">
                                    <Label.GestureRecognizers><TapGestureRecognizer Command="{Binding NavigateToGoalsCommand}" /></Label.GestureRecognizers>
                                </Label>
                            </Grid>
                            <CollectionView ItemsSource="{Binding ActiveGoals}" HeightRequest="150" SelectionMode="None">
                                <CollectionView.ItemTemplate>
                                    <DataTemplate x:DataType="dtos:FinancialGoalDto">
                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" Padding="4,8">
                                            <controls:PaytinIconView Grid.Column="0" Icon="{Binding Icon}" Name="{Binding Name}" Size="38" VerticalOptions="Center" />
                                            <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                                                <Label Text="{Binding Name}" FontSize="13" FontAttributes="Bold" TextColor="{StaticResource PayInk}" />
                                                <ProgressBar Progress="{Binding ProgressPercentage, Converter={StaticResource PercentageConverter}}" ProgressColor="{StaticResource PayLimeDark}" HeightRequest="6" />
                                            </VerticalStackLayout>
                                            <Label Grid.Column="2" Text="{Binding ProgressPercentage, StringFormat='{0:F0}%'}" FontSize="13" FontAttributes="Bold" TextColor="{StaticResource PayInk}" VerticalOptions="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                                <CollectionView.EmptyView>
                                    <controls:PaytinEmptyState Title="No goals yet"
                                                             Subtitle="Set a savings goal to get started"
                                                             IconKey="target" />
                                </CollectionView.EmptyView>
                            </CollectionView>
                        </VerticalStackLayout>
                    </Border>

                </VerticalStackLayout>
            </ScrollView>
        </RefreshView>

        <!-- Paytin tab bar (floating) -->
        <controls:PaytinTabBar VerticalOptions="End" ActiveTab="Dashboard" />

        <controls:ToastHost />
    </Grid>
</ContentPage>
