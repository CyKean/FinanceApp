<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:FinanceApp.Mobile.ViewModels"
             xmlns:converters="clr-namespace:FinanceApp.Mobile.Converters"
             xmlns:dtos="clr-namespace:FinanceApp.Application.DTOs;assembly=FinanceApp.Application"
             xmlns:controls="clr-namespace:FinanceApp.Mobile.Views.Controls"
             x:Class="FinanceApp.Mobile.Views.DashboardPage"
             x:DataType="viewmodels:DashboardViewModel"
             Title="{Binding Title}"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource FinoraCream}">

    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:MoneyToStringConverter x:Key="MoneyConverter" />
            <converters:PercentageToColorConverter x:Key="PercentageColorConverter" />
            <converters:TransactionTypeToColorConverter x:Key="TransactionTypeColorConverter" />
            <converters:CategoryInitialConverter x:Key="InitialConverter" />
            <converters:CountToBoolConverter x:Key="CountToBoolConverter" />
            <converters:InverseBoolConverter x:Key="InverseBoolConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid>
        <!-- Section-for-section mirror of this page: hero card, quick actions, recent
             activity rows, savings/budgets pair, category donut. A generic row
             skeleton still jumped, because the real dashboard is none of those
             things. -->
        <controls:SkeletonDashboard IsVisible="{Binding IsInitialLoading}" />

        <RefreshView Command="{Binding RefreshCommand}" IsRefreshing="{Binding IsBusy}"
                      IsVisible="{Binding IsInitialLoading, Converter={StaticResource InverseBoolConverter}}">
            <ScrollView>
                <VerticalStackLayout Spacing="14" Padding="18,14,18,100">
                    <!-- Header -->
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" VerticalOptions="Center">
                        <Border Grid.Column="0" WidthRequest="48" HeightRequest="48" Stroke="{StaticResource FinoraInk}" StrokeThickness="1.5" Background="#D9C6A5" VerticalOptions="Center">
                            <Border.StrokeShape><Ellipse /></Border.StrokeShape>
                            <Label Text="{Binding UserInitial}" FontSize="20" FontAttributes="Bold" TextColor="{StaticResource FinoraInk}" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Spacing="0" VerticalOptions="Center">
                            <Label Text="{Binding UserName}" FontSize="12" TextColor="#6F7668" LineBreakMode="TailTruncation" />
                            <Label Text="Welcome Back" FontSize="18" FontAttributes="Bold" FontFamily="SpaceGroteskBold" TextColor="{StaticResource FinoraInk}" />
                        </VerticalStackLayout>
                        <Border Grid.Column="2" WidthRequest="46" HeightRequest="46" Background="{StaticResource FinoraCard}" Stroke="{StaticResource FinoraInk}" StrokeThickness="1.5" VerticalOptions="Center">
                            <Border.StrokeShape><Ellipse /></Border.StrokeShape>
                            <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding NavigateToNotificationsCommand}" /></Border.GestureRecognizers>
                            <Grid>
                                <controls:FinoraIconView IconKey="bell" ShowBadge="False" Light="True" Size="24" HorizontalOptions="Center" VerticalOptions="Center" />
                                <Border WidthRequest="20" HeightRequest="20" Background="{StaticResource FinoraLime}" Stroke="{StaticResource FinoraInk}" StrokeThickness="1.2"
                                        HorizontalOptions="End" VerticalOptions="Start" Margin="0,8,8,0"
                                        IsVisible="{Binding UnreadNotifications, Converter={StaticResource CountToBoolConverter}}">
                                    <Border.StrokeShape><Ellipse /></Border.StrokeShape>
                                    <Label Text="{Binding UnreadNotifications}" FontSize="10" FontAttributes="Bold" TextColor="{StaticResource FinoraInk}"
                                           HorizontalOptions="Center" VerticalOptions="Center" />
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- VISA card (Finora mock copy) -->
                    <Grid>
                        <Border Style="{StaticResource HeroCardStyle}" Padding="0" Margin="0,15,0,0">
                            <Border.StrokeShape><RoundRectangle CornerRadius="34" /></Border.StrokeShape>
                            <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding NavigateToAccountsCommand}" /></Border.GestureRecognizers>
                            <Grid ColumnDefinitions="*,54" Padding="20,20,8,20">
                                <!-- diagonal line texture: single scaled path, so the rotation is never layout-dependent -->
                                <Path Grid.ColumnSpan="2" Aspect="Fill" Fill="Transparent"
                                      Stroke="White" StrokeThickness="0.5" Opacity="0.06"
                                      HorizontalOptions="Fill" VerticalOptions="Fill"
                                      InputTransparent="True"
                                      Data="M -60,100 L -2.3,0 M -48.3,100 L 9.4,0 M -36.6,100 L 21.1,0 M -24.9,100 L 32.8,0 M -13.2,100 L 44.5,0 M -1.5,100 L 56.2,0 M 10.2,100 L 67.9,0 M 21.9,100 L 79.6,0 M 33.6,100 L 91.3,0 M 45.3,100 L 103,0 M 57,100 L 114.7,0 M 68.7,100 L 126.4,0 M 80.4,100 L 138.1,0 M 92.1,100 L 149.8,0 M 103.8,100 L 161.5,0" />
                                <!-- card content -->
                                <Grid Grid.Column="0">
                                    <VerticalStackLayout Spacing="2">
                                        <Label Text="VISA" FontSize="13" FontAttributes="Bold" TextColor="White" Opacity="0.85" CharacterSpacing="3" VerticalOptions="Center" />
                                        <Label Text="Balance" FontSize="12" TextColor="White" Opacity="0.65" Margin="0,10,0,0" />
                                        <HorizontalStackLayout Spacing="5" VerticalOptions="Center">
                                            <Label Text="$" FontSize="16" FontAttributes="Bold" FontFamily="SpaceGroteskBold" TextColor="White" Opacity="0.9" VerticalOptions="End" Margin="0,0,0,3" />
                                            <Label Text="{Binding TotalBalance.Amount, StringFormat='{0:N2}'}" FontSize="26" FontAttributes="Bold" FontFamily="SpaceGroteskBold" TextColor="White" LineBreakMode="NoWrap" VerticalOptions="End" />
                                        </HorizontalStackLayout>
                                        <Label Text="**** **** ****  7281" FontSize="13" FontAttributes="Bold" TextColor="White" Opacity="0.9" CharacterSpacing="1" Margin="0,10,0,0" />
                                        <Grid ColumnDefinitions="*,Auto" Margin="0,10,0,0">
                                            <Label Grid.Column="0" Text="{Binding UserName}" FontSize="11" TextColor="White" Opacity="0.65" LineBreakMode="TailTruncation" VerticalOptions="Center" />
                                            <Label Grid.Column="1" Text="Exp 07/26" FontSize="11" TextColor="{StaticResource FinoraLime}" Opacity="0.9" VerticalOptions="Center" />
                                        </Grid>
                                    </VerticalStackLayout>
                                    <!-- lime sparkle accents -->
                                    <Polygon Points="10,0 12,8 20,10 12,12 10,20 8,12 0,10 8,8"
                                             Fill="{StaticResource FinoraLime}"
                                             WidthRequest="26" HeightRequest="26"
                                             HorizontalOptions="End" VerticalOptions="Start" Margin="0,26,96,0" />
                                    <Border WidthRequest="7" HeightRequest="7" Background="{StaticResource FinoraLime}" StrokeThickness="0" Opacity="0.8"
                                            HorizontalOptions="End" VerticalOptions="Start" Margin="0,74,62,0">
                                        <Border.StrokeShape><Ellipse /></Border.StrokeShape>
                                    </Border>
                                </Grid>
                                <!-- lime contactless bar -->
                                <Border Grid.Column="1" Background="{StaticResource FinoraLime}" Stroke="{StaticResource FinoraLime}" StrokeThickness="0" WidthRequest="38" VerticalOptions="Fill" Margin="10,20,4,20">
                                    <Border.StrokeShape><RoundRectangle CornerRadius="100" /></Border.StrokeShape>
                                    <Path Aspect="Uniform" WidthRequest="20" HeightRequest="20" Data="M 3,4 A 6,6 0 0 1 3,16 M 8,2 A 11,11 0 0 1 8,18 M 13,0 A 16,16 0 0 1 13,20"
                                          Stroke="{StaticResource FinoraInk}" StrokeThickness="1.6" StrokeLineCap="Round" Fill="Transparent"
                                          HorizontalOptions="Center" VerticalOptions="Center" />
                                </Border>
                            </Grid>
                        </Border>
                        <!-- Set Budget pill straddling the top edge -->
                        <Border VerticalOptions="Start" HorizontalOptions="End" Margin="0,0,18,0"
                                Background="{StaticResource FinoraLime}" Stroke="{StaticResource FinoraInk}" StrokeThickness="1.5" Padding="12,7">
                            <Border.StrokeShape><RoundRectangle CornerRadius="100" /></Border.StrokeShape>
                            <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding NavigateToBudgetsCommand}" /></Border.GestureRecognizers>
                            <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                                <Border WidthRequest="20" HeightRequest="20" Background="{StaticResource FinoraInk}" StrokeThickness="0" VerticalOptions="Center">
                                    <Border.StrokeShape><Ellipse /></Border.StrokeShape>
                                    <Label Text="+" FontSize="13" FontAttributes="Bold" TextColor="{StaticResource FinoraLime}" HorizontalOptions="Center" VerticalOptions="Center" Margin="0,-2,0,0" />
                                </Border>
                                <Label Text="Set Budget" FontSize="11" FontAttributes="Bold" TextColor="{StaticResource FinoraInk}" VerticalOptions="Center" />
                            </HorizontalStackLayout>
                        </Border>
                    </Grid>

                    <!-- Quick actions -->
                    <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="10">
                        <VerticalStackLayout Grid.Column="0" Spacing="6" HorizontalOptions="Center">
                            <Border Style="{StaticResource FinoraCircleActionStyle}">
                                <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding NavigateToAiSuggestionsCommand}" /></Border.GestureRecognizers>
                                <Path x:Name="QuickAIIcon" Aspect="Uniform" WidthRequest="26" HeightRequest="26" StrokeThickness="2" Stroke="{StaticResource FinoraInk}" StrokeLineCap="Round" StrokeLineJoin="Round" Fill="Transparent" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <Label Text="AI Ideas" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource FinoraInk}" HorizontalOptions="Center" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1" Spacing="6" HorizontalOptions="Center">
                            <Border Style="{StaticResource FinoraCircleActionStyle}">
                                <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding NavigateToAnalyticsCommand}" /></Border.GestureRecognizers>
                                <Path x:Name="QuickStatsIcon" Aspect="Uniform" WidthRequest="26" HeightRequest="26" StrokeThickness="2" Stroke="{StaticResource FinoraInk}" StrokeLineCap="Round" StrokeLineJoin="Round" Fill="Transparent" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <Label Text="Stats" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource FinoraInk}" HorizontalOptions="Center" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="2" Spacing="6" HorizontalOptions="Center">
                            <Border Style="{StaticResource FinoraCircleActionStyle}">
                                <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding NavigateToForecastsCommand}" /></Border.GestureRecognizers>
                                <Path x:Name="QuickForecastIcon" Aspect="Uniform" WidthRequest="26" HeightRequest="26" StrokeThickness="2" Stroke="{StaticResource FinoraInk}" StrokeLineCap="Round" StrokeLineJoin="Round" Fill="Transparent" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <Label Text="Forecast" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource FinoraInk}" HorizontalOptions="Center" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="3" Spacing="6" HorizontalOptions="Center">
                            <Border Style="{StaticResource FinoraCircleActionStyle}">
                                <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding NavigateToMoreCommand}" /></Border.GestureRecognizers>
                                <Path x:Name="QuickMoreIcon" Aspect="Uniform" WidthRequest="24" HeightRequest="24" StrokeThickness="2.5" Stroke="{StaticResource FinoraInk}" StrokeLineCap="Round" StrokeLineJoin="Round" Fill="Transparent" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <Label Text="More" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource FinoraInk}" HorizontalOptions="Center" />
                        </VerticalStackLayout>
                    </Grid>

                    <!-- Add money row -->
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                        <Button Grid.Column="0" Text="− Expense" Command="{Binding NavigateToAddExpenseCommand}" Style="{StaticResource PrimaryButtonStyle}" />
                        <Button Grid.Column="1" Text="+ Income" Command="{Binding NavigateToAddIncomeCommand}" Style="{StaticResource SecondaryButtonStyle}" />
                    </Grid>

                    <!-- Recent Activity -->
                    <VerticalStackLayout Spacing="10">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Grid.Column="0" Text="Recent Activity" FontSize="16" FontAttributes="Bold" TextColor="{StaticResource FinoraInk}" VerticalOptions="Center" />
                            <Label Grid.Column="1" Text="See all ›" FontSize="13" FontAttributes="Bold" TextColor="{StaticResource FinoraInk}" VerticalOptions="Center">
                                <Label.GestureRecognizers><TapGestureRecognizer Command="{Binding NavigateToTransactionsCommand}" /></Label.GestureRecognizers>
                            </Label>
                        </Grid>
                        <Border Background="{StaticResource FinoraCard}" Stroke="{StaticResource FinoraInk}" StrokeThickness="1.5" Padding="8">
                            <Border.StrokeShape><RoundRectangle CornerRadius="28" /></Border.StrokeShape>
                            <CollectionView ItemsSource="{Binding RecentTransactions}" SelectionMode="None" HeightRequest="268">
                                <CollectionView.ItemTemplate>
                                    <DataTemplate x:DataType="dtos:TransactionDto">
                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" Padding="10,10">
                                            <controls:FinoraIconView Grid.Column="0" Icon="{Binding CategoryIcon}" Name="{Binding CategoryName}" Size="46" VerticalOptions="Center" />
                                            <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                                                <Label Text="{Binding CategoryName}" FontSize="14" FontAttributes="Bold" TextColor="{StaticResource FinoraInk}" />
                                                <Label Text="{Binding Date, StringFormat='{0:dddd, dd MMMM}'}" FontSize="11" TextColor="#6F7668" />
                                            </VerticalStackLayout>
                                            <Label Grid.Column="2" Text="{Binding Amount, Converter={StaticResource MoneyConverter}}" FontSize="14" FontAttributes="Bold" TextColor="{StaticResource FinoraInk}" VerticalOptions="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                                <CollectionView.EmptyView>
                                    <controls:FinoraEmptyState Title="No transactions yet"
                                                             Subtitle="Tap − Expense or + Income to add one"
                                                             IconKey="receipt" />
                                </CollectionView.EmptyView>
                            </CollectionView>
                        </Border>
                    </VerticalStackLayout>

                    <!-- Savings / budgets / goals (kept, Finora style) -->
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                        <Border Grid.Column="0" Style="{StaticResource FinoraLimeCardStyle}">
                            <VerticalStackLayout Spacing="4">
                                <Label Text="◉ Savings" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource FinoraInk}" />
                                <Label Text="{Binding SavingsRate, StringFormat='{0:F1}%'}" FontSize="26" FontAttributes="Bold" TextColor="{StaticResource FinoraInk}" />
                                <Label Text="of income saved" FontSize="11" TextColor="{StaticResource FinoraInk}" Opacity="0.7" />
                            </VerticalStackLayout>
                        </Border>
                        <Border Grid.Column="1" Style="{StaticResource FinoraDarkCardStyle}">
                            <VerticalStackLayout Spacing="4">
                                <Label Text="◎ Budgets" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource FinoraLime}" />
                                <Label Text="{Binding ActiveBudgets.Count, StringFormat='{0} active'}" FontSize="20" FontAttributes="Bold" TextColor="White" />
                                <Label Text="Keep it inside the lines" FontSize="11" TextColor="White" Opacity="0.7">
                                    <Label.GestureRecognizers><TapGestureRecognizer Command="{Binding NavigateToBudgetsCommand}" /></Label.GestureRecognizers>
                                </Label>
                            </VerticalStackLayout>
                        </Border>
                    </Grid>

                    <Border Style="{StaticResource CardFrameStyle}">
                        <VerticalStackLayout Spacing="10">
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Grid.Column="0" Text="Spending by Category" FontSize="15" FontAttributes="Bold" TextColor="{StaticResource FinoraInk}" />
                                <Label Grid.Column="1" Text="›" FontSize="18" FontAttributes="Bold" TextColor="{StaticResource FinoraInk}">
                                    <Label.GestureRecognizers><TapGestureRecognizer Command="{Binding NavigateToAnalyticsCommand}" /></Label.GestureRecognizers>
                                </Label>
                            </Grid>
                            <CollectionView ItemsSource="{Binding SpendingByCategory}" HeightRequest="170" SelectionMode="None">
                                <CollectionView.ItemTemplate>
                                    <DataTemplate x:DataType="dtos:CategorySpendingDto">
                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" Padding="4,8">
                                            <controls:FinoraIconView Grid.Column="0" Icon="{Binding CategoryIcon}" Name="{Binding CategoryName}" Size="40" VerticalOptions="Center" />
                                            <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                                                <Label Text="{Binding CategoryName}" FontSize="13" FontAttributes="Bold" TextColor="{StaticResource FinoraInk}" />
                                                <ProgressBar Progress="{Binding Percentage, Converter={StaticResource PercentageConverter}}" ProgressColor="{StaticResource FinoraInk}" HeightRequest="6" />
                                            </VerticalStackLayout>
                                            <Label Grid.Column="2" Text="{Binding Amount, Converter={StaticResource MoneyConverter}}" FontSize="13" FontAttributes="Bold" TextColor="{StaticResource FinoraInk}" VerticalOptions="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                                <CollectionView.EmptyView>
                                    <controls:FinoraEmptyState Title="No spending data yet"
                                                             Subtitle="Add expenses to see your breakdown"
                                                             IconKey="chart" />
                                </CollectionView.EmptyView>
                            </CollectionView>
                        </VerticalStackLayout>
                    </Border>

                    <Border Style="{StaticResource CardFrameStyle}">
                        <VerticalStackLayout Spacing="10">
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Grid.Column="0" Text="Goals" FontSize="15" FontAttributes="Bold" TextColor="{StaticResource FinoraInk}" />
                                <Label Grid.Column="1" Text="›" FontSize="18" FontAttributes="Bold" TextColor="{StaticResource FinoraInk}">
                                    <Label.GestureRecognizers><TapGestureRecognizer Command="{Binding NavigateToGoalsCommand}" /></Label.GestureRecognizers>
                                </Label>
                            </Grid>
                            <CollectionView ItemsSource="{Binding ActiveGoals}" HeightRequest="150" SelectionMode="None">
                                <CollectionView.ItemTemplate>
                                    <DataTemplate x:DataType="dtos:FinancialGoalDto">
                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" Padding="4,8">
                                            <controls:FinoraIconView Grid.Column="0" Icon="{Binding Icon}" Name="{Binding Name}" Size="38" VerticalOptions="Center" />
                                            <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                                                <Label Text="{Binding Name}" FontSize="13" FontAttributes="Bold" TextColor="{StaticResource FinoraInk}" />
                                                <ProgressBar Progress="{Binding ProgressPercentage, Converter={StaticResource PercentageConverter}}" ProgressColor="{StaticResource FinoraLimeDark}" HeightRequest="6" />
                                            </VerticalStackLayout>
                                            <Label Grid.Column="2" Text="{Binding ProgressPercentage, StringFormat='{0:F0}%'}" FontSize="13" FontAttributes="Bold" TextColor="{StaticResource FinoraInk}" VerticalOptions="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                                <CollectionView.EmptyView>
                                    <controls:FinoraEmptyState Title="No goals yet"
                                                             Subtitle="Set a savings goal to get started"
                                                             IconKey="target" />
                                </CollectionView.EmptyView>
                            </CollectionView>
                        </VerticalStackLayout>
                    </Border>

                </VerticalStackLayout>
            </ScrollView>
        </RefreshView>

        <!-- Finora tab bar (floating) -->
        <controls:FinoraTabBar VerticalOptions="End" ActiveTab="Dashboard" />

        <controls:TransactionSheetHost />

        <controls:ToastHost />
    </Grid>
</ContentPage>
