<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:FinanceApp.Mobile.ViewModels"
             xmlns:converters="clr-namespace:FinanceApp.Mobile.Converters"
             x:Class="FinanceApp.Mobile.Views.BudgetsPage"
             Title="{Binding Title}"
             x:Name="BudgetsPageView">

    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:MoneyToStringConverter x:Key="MoneyConverter" />
            <converters:PercentageToColorConverter x:Key="PercentageColorConverter" />
            <converters:PercentageConverter x:Key="PercentageConverter" />
            <converters:ColorConverter x:Key="ColorConverter" />
            <converters:InverseBoolConverter x:Key="InverseBoolConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <RefreshView Command="{Binding RefreshCommand}" IsRefreshing="{Binding IsBusy}">
        <VerticalStackLayout Spacing="16" Padding="16">
            <!-- Month Navigation -->
            <Frame Style="{StaticResource CardFrameStyle}" Padding="16">
                <HorizontalStackLayout Spacing="12">
                    <Button Text="←" Command="{Binding PreviousMonthCommand}" Style="{StaticResource IconButtonStyle}" WidthRequest="44" HeightRequest="44" />
                    <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="FillAndExpand">
                        <Label Text="{Binding CurrentMonth, StringFormat='{0:MMMM yyyy}'}" Style="{StaticResource MonthLabelStyle}" HorizontalOptions="Center" />
                    </VerticalStackLayout>
                    <Button Text="Today" Command="{Binding CurrentMonthCommand}" Style="{StaticResource OutlineButtonStyle}" WidthRequest="80" HeightRequest="44" />
                    <Button Text="→" Command="{Binding NextMonthCommand}" Style="{StaticResource IconButtonStyle}" WidthRequest="44" HeightRequest="44" />
                </HorizontalStackLayout>
            </Frame>

            <!-- Budgets List -->
            <CollectionView ItemsSource="{Binding Budgets}" SelectionMode="None">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <SwipeView>
                            <SwipeView.RightItems>
                                <SwipeItems>
                                    <SwipeItem Text="Edit" 
                                               BackgroundColor="#512BD4"
                                               Command="{Binding Source={x:Reference BudgetsPageView}, Path=BindingContext.EditBudgetCommand}"
                                               CommandParameter="{Binding .}" />
                                    <SwipeItem Text="Delete" 
                                               BackgroundColor="Red"
                                               Command="{Binding Source={x:Reference BudgetsPageView}, Path=BindingContext.DeleteBudgetCommand}"
                                               CommandParameter="{Binding .}" />
                                </SwipeItems>
                            </SwipeView.RightItems>
                            <Frame Style="{StaticResource BudgetCardFrameStyle}" Margin="0,8">
                                <VerticalStackLayout Spacing="12">
                                    <HorizontalStackLayout Spacing="12">
                                        <Frame WidthRequest="48" HeightRequest="48" CornerRadius="24" 
                                               BackgroundColor="{Binding CategoryColor, Converter={StaticResource ColorConverter}}" 
                                               HasShadow="False" BorderColor="Transparent">
                                            <Label Text="{Binding CategoryIcon}" VerticalOptions="Center" HorizontalOptions="Center" FontSize="20" />
                                        </Frame>
                                        <VerticalStackLayout Spacing="4" VerticalOptions="Center" HorizontalOptions="FillAndExpand">
                                            <Label Text="{Binding CategoryName}" Style="{StaticResource BudgetCategoryNameLabelStyle}" />
                                            <ProgressBar Progress="{Binding PercentageUsed, Converter={StaticResource PercentageConverter}}" 
                                                         ProgressColor="{Binding PercentageUsed, Converter={StaticResource PercentageColorConverter}}" HeightRequest="8" />
                                        </VerticalStackLayout>
                                        <Label Text="{Binding PercentageUsed, StringFormat='{0:F1}%'}" 
                                               Style="{StaticResource BudgetPercentageLabelStyle}"
                                               TextColor="{Binding PercentageUsed, Converter={StaticResource PercentageColorConverter}}" />
                                    </HorizontalStackLayout>
                                    <HorizontalStackLayout Spacing="16">
                                        <VerticalStackLayout Spacing="2">
                                            <Label Text="Spent" Style="{StaticResource BudgetDetailCaptionStyle}" />
                                            <Label Text="{Binding SpentAmount, Converter={StaticResource MoneyConverter}}" Style="{StaticResource BudgetDetailValueStyle}" TextColor="Red" />
                                        </VerticalStackLayout>
                                        <VerticalStackLayout Spacing="2">
                                            <Label Text="Remaining" Style="{StaticResource BudgetDetailCaptionStyle}" />
                                            <Label Text="{Binding RemainingAmount, Converter={StaticResource MoneyConverter}}" Style="{StaticResource BudgetDetailValueStyle}" 
                                                   TextColor="{Binding RemainingAmount.Amount, Converter={StaticResource MoneyToStringConverter}, ConverterParameter=color}" />
                                        </VerticalStackLayout>
                                        <VerticalStackLayout Spacing="2">
                                            <Label Text="Budget" Style="{StaticResource BudgetDetailCaptionStyle}" />
                                            <Label Text="{Binding Amount, Converter={StaticResource MoneyConverter}}" Style="{StaticResource BudgetDetailValueStyle}" />
                                        </VerticalStackLayout>
                                    </HorizontalStackLayout>
                                    <Label Text="{Binding IsOverBudget, Converter={StaticResource BoolToStringConverter}, ConverterParameter='⚠ Over Budget|'}" 
                                           Style="{StaticResource OverBudgetLabelStyle}"
                                           IsVisible="{Binding IsOverBudget}"
                                           TextColor="Red" />
                                </VerticalStackLayout>
                            </Frame>
                        </SwipeView>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
                <CollectionView.EmptyView>
                    <VerticalStackLayout Spacing="8" HorizontalOptions="Center" VerticalOptions="Center" Padding="20">
                        <Label Text="📊" FontSize="48" />
                        <Label Text="No budgets for this month" Style="{StaticResource EmptyStateLabelStyle}" />
                        <Label Text="Create a budget to track your spending" Style="{StaticResource EmptyStateSubLabelStyle}" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>
            </CollectionView>

            <!-- Add Budget Button -->
            <Button Text="Add Budget" Command="{Binding AddBudgetCommand}" Style="{StaticResource PrimaryButtonStyle}" Margin="16,0,16,16" />
        </VerticalStackLayout>
    </RefreshView>

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Add" Command="{Binding AddBudgetCommand}" IconImageSource="plus.png" Priority="0" />
    </ContentPage.ToolbarItems>
</ContentPage>