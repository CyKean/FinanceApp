<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:FinanceApp.Mobile.ViewModels"
             xmlns:converters="clr-namespace:FinanceApp.Mobile.Converters"
             x:Class="FinanceApp.Mobile.Views.AddBudgetPage"
             x:DataType="viewmodels:AddBudgetViewModel"
             Title="{Binding Title}">

    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:MoneyToStringConverter x:Key="MoneyConverter" />
            <converters:InverseBoolConverter x:Key="InverseBoolConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Spacing="16" Padding="16">
            <!-- Name -->
            <Border Style="{StaticResource CardFrameStyle}" Padding="16">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Budget Name" Style="{StaticResource FormLabelStyle}" />
                    <Entry Text="{Binding Name}" Placeholder="e.g., Monthly Food Budget" Style="{StaticResource EntryStyle}" />
                </VerticalStackLayout>
            </Border>

            <!-- Amount -->
            <Border Style="{StaticResource CardFrameStyle}" Padding="16">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Budget Amount" Style="{StaticResource FormLabelStyle}" />
                    <Entry Text="{Binding Amount.Amount, StringFormat='{0:N2}'}" 
                           Keyboard="Numeric" 
                           Placeholder="0.00"
                           Style="{StaticResource AmountEntryStyle}"
                           HorizontalTextAlignment="End" />
                </VerticalStackLayout>
            </Border>

            <!-- Category -->
            <Border Style="{StaticResource CardFrameStyle}" Padding="16">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Category" Style="{StaticResource FormLabelStyle}" />
                    <Picker Title="Select Category" 
                            ItemsSource="{Binding Categories}" 
                            ItemDisplayBinding="{Binding Name}"
                            SelectedItem="{Binding SelectedCategory}"
                            Style="{StaticResource PickerStyle}" />
                </VerticalStackLayout>
            </Border>

            <!-- Start Date -->
            <Border Style="{StaticResource CardFrameStyle}" Padding="16">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Start Date" Style="{StaticResource FormLabelStyle}" />
                    <DatePicker Date="{Binding StartDate}" 
                                Format="MMM dd, yyyy"
                                Style="{StaticResource DatePickerStyle}" />
                </VerticalStackLayout>
            </Border>

            <!-- End Date -->
            <Border Style="{StaticResource CardFrameStyle}" Padding="16">
                <VerticalStackLayout Spacing="8">
                    <Label Text="End Date" Style="{StaticResource FormLabelStyle}" />
                    <DatePicker Date="{Binding EndDate}" 
                                Format="MMM dd, yyyy"
                                Style="{StaticResource DatePickerStyle}" />
                </VerticalStackLayout>
            </Border>

            <!-- Save Button -->
            <Button Text="{Binding IsEditing, Converter={StaticResource BoolToStringConverter}, ConverterParameter='Update|Create'}" 
                    Command="{Binding SaveCommand}"
                    IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Margin="16,24,16,16" />
        </VerticalStackLayout>
    </ScrollView>

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Cancel" Command="{Binding CancelCommand}" Priority="0" />
    </ContentPage.ToolbarItems>
</ContentPage>