<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:FinanceApp.Mobile.ViewModels"
             xmlns:converters="clr-namespace:FinanceApp.Mobile.Converters"
             xmlns:controls="clr-namespace:FinanceApp.Mobile.Views.Controls"
             x:Class="FinanceApp.Mobile.Views.AddBudgetPage"
             x:DataType="viewmodels:AddBudgetViewModel"
             Shell.NavBarIsVisible="False"
             Title="{Binding Title}">

    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:InverseBoolConverter x:Key="InverseBoolConverter" />
            <converters:TransactionTypeToButtonStyleConverter x:Key="TransactionTypeToButtonStyleConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid>
    <ScrollView>
        <VerticalStackLayout Spacing="14" Padding="18,14,18,28">
            <!-- Header -->
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" VerticalOptions="Center">
                <Border WidthRequest="46" HeightRequest="46"
                        Background="{DynamicResource FinoraCard}"
                        Stroke="{DynamicResource FinoraInk}" StrokeThickness="1.5"
                        VerticalOptions="Center">
                    <Border.StrokeShape><Ellipse /></Border.StrokeShape>
                    <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding CancelCommand}" /></Border.GestureRecognizers>
                    <controls:FinoraIconView IconKey="arrowleft" Size="20" ShowBadge="False" Light="True" HorizontalOptions="Center" VerticalOptions="Center" />
                </Border>
                <VerticalStackLayout Grid.Column="1" Spacing="0" VerticalOptions="Center">
                    <Label Text="{Binding Title}" FontSize="18" FontAttributes="Bold" FontFamily="SpaceGroteskBold" TextColor="{DynamicResource FinoraInk}" />
                    <Label Text="Set a spending limit" FontSize="12" TextColor="{DynamicResource FinoraMuted}" />
                </VerticalStackLayout>
                <Border Grid.Column="2" WidthRequest="46" HeightRequest="46"
                        Background="{DynamicResource FinoraLime}"
                        Stroke="{DynamicResource FinoraInk}" StrokeThickness="1.5"
                        VerticalOptions="Center">
                    <Border.StrokeShape><Ellipse /></Border.StrokeShape>
<controls:FinoraIconView IconKey="wallet" Size="20" ShowBadge="False" Light="True" HorizontalOptions="Center" VerticalOptions="Center" />
                </Border>
            </Grid>

            <Label Text="{Binding ErrorMessage}"
                   Style="{StaticResource ErrorLabelStyle}"
                   IsVisible="{Binding HasError}" />

            <!-- Name -->
            <VerticalStackLayout Spacing="6">
                <Label Text="Budget Name" Style="{StaticResource FormLabelStyle}" />
                <Border Style="{StaticResource FieldBorderStyle}">
                    <Entry Text="{Binding Name}"
                           Placeholder="e.g., Monthly Food Budget"
                           BackgroundColor="Transparent"
                           TextColor="{AppThemeBinding Light={DynamicResource OnSurface}, Dark={DynamicResource OnSurfaceDark}}"
                           HeightRequest="48" />
                </Border>
            </VerticalStackLayout>

            <!-- Amount -->
            <VerticalStackLayout Spacing="6">
                <Label Text="Budget Amount" Style="{StaticResource FormLabelStyle}" />
                <Border Style="{StaticResource FieldBorderStyle}">
                    <Entry Text="{Binding AmountText}"
                           Keyboard="Numeric"
                           Placeholder="0.00"
                           BackgroundColor="Transparent"
                           TextColor="{AppThemeBinding Light={DynamicResource OnSurface}, Dark={DynamicResource OnSurfaceDark}}"
                           HeightRequest="48"
                           HorizontalTextAlignment="End" />
                </Border>
            </VerticalStackLayout>

            <!-- Budget Type -->
            <HorizontalStackLayout Spacing="12">
                <Button Text="Expense"
                        Command="{Binding SetExpenseTypeCommand}"
                        Style="{Binding TransactionType, Converter={StaticResource TransactionTypeToButtonStyleConverter}, ConverterParameter=Expense}"
                        HorizontalOptions="Fill" />
                <Button Text="Income"
                        Command="{Binding SetIncomeTypeCommand}"
                        Style="{Binding TransactionType, Converter={StaticResource TransactionTypeToButtonStyleConverter}, ConverterParameter=Income}"
                        HorizontalOptions="Fill" />
            </HorizontalStackLayout>

            <!-- Category -->
            <VerticalStackLayout Spacing="6">
                <Label Text="Category" Style="{StaticResource FormLabelStyle}" />
                <controls:ModernSelect ItemsSource="{Binding Categories}"
                                       SelectedItem="{Binding SelectedCategory}"
                                       Placeholder="Select Category"
                                       DisplayMemberPath="Name"
                                       IconMemberPath="Icon"
                                       ColorMemberPath="Color" />
                <Button Text="+ New category"
                        Command="{Binding ShowAddCategoryCommand}"
                        IsVisible="{Binding IsAddingCategory, Converter={StaticResource InverseBoolConverter}}"
                        Style="{StaticResource TextButtonStyle}"
                        HorizontalOptions="Start"
                        Padding="0" />
                <Border Style="{StaticResource FieldBorderStyle}"
                        IsVisible="{Binding IsAddingCategory}"
                        Padding="12">
                    <VerticalStackLayout Spacing="8">
                        <Entry Text="{Binding NewCategoryName}"
                               Placeholder="Category name"
                               BackgroundColor="Transparent"
                               TextColor="{AppThemeBinding Light={DynamicResource OnSurface}, Dark={DynamicResource OnSurfaceDark}}"
                               HeightRequest="48" />
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                            <Button Text="Add"
                                    Command="{Binding SaveNewCategoryCommand}"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    TextColor="White"
                                    HorizontalOptions="Fill" />
                            <Button Grid.Column="1" Text="Cancel"
                                    Command="{Binding CancelAddCategoryCommand}"
                                    Style="{StaticResource OutlineButtonStyle}"
                                    HorizontalOptions="Fill" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>

            <!-- Linked Account (Optional) -->
            <VerticalStackLayout Spacing="6">
                <Label Text="Account (Optional)" Style="{StaticResource FormLabelStyle}" />
                <controls:ModernSelect ItemsSource="{Binding Accounts}"
                                       SelectedItem="{Binding SelectedAccount}"
                                       Placeholder="All accounts"
                                       DisplayMemberPath="Name"
                                       IconMemberPath="Icon"
                                       ColorMemberPath="Color" />
            </VerticalStackLayout>

            <!-- Icon picker -->
            <VerticalStackLayout Spacing="6">
                <Label Text="Icon" Style="{StaticResource FormLabelStyle}" />
                <Border Style="{StaticResource CardFrameStyle}" Padding="16">
                    <VerticalStackLayout Spacing="10">
                        <HorizontalStackLayout Spacing="12" VerticalOptions="Center">
                            <controls:FinoraIconView Icon="{Binding Icon}" Name="{Binding Name}" Size="52" VerticalOptions="Center" />
                            <Label Text="Tap an icon below"
                                   Style="{StaticResource MutedLabelStyle}"
                                   VerticalOptions="Center"
                                   HorizontalOptions="Fill" />
                        </HorizontalStackLayout>
                        <FlexLayout x:Name="EmojiContainer"
                                    Direction="Row"
                                    Wrap="Wrap"
                                    JustifyContent="Start" />
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>

            <!-- Dates -->
            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                <VerticalStackLayout Spacing="6">
                    <Label Text="Start Date" Style="{StaticResource FormLabelStyle}" />
                    <Border Style="{StaticResource FieldBorderStyle}" Padding="12,0">
                        <DatePicker Date="{Binding StartDate}"
                                    Format="MMM dd, yyyy"
                                    HeightRequest="48" />
                    </Border>
                </VerticalStackLayout>
                <VerticalStackLayout Grid.Column="1" Spacing="6">
                    <Label Text="End Date" Style="{StaticResource FormLabelStyle}" />
                    <Border Style="{StaticResource FieldBorderStyle}" Padding="12,0">
                        <DatePicker Date="{Binding EndDate}"
                                    Format="MMM dd, yyyy"
                                    HeightRequest="48" />
                    </Border>
                </VerticalStackLayout>
            </Grid>

            <!-- Save Button -->
            <Button Text="{Binding IsEditing, Converter={StaticResource BoolToStringConverter}, ConverterParameter='Update|Create'}"
                    Command="{Binding SaveCommand}"
                    IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}"
                    Style="{StaticResource PrimaryButtonStyle}"
                    TextColor="White"
                    Margin="0,8,0,0" />

            <!-- Cancel Button -->
            <Button Text="Cancel"
                    Command="{Binding CancelCommand}"
                    Style="{StaticResource OutlineButtonStyle}" />
        </VerticalStackLayout>
    </ScrollView>

        <!-- Toasts -->
        <controls:ToastHost />

        <!-- Create / edit animation -->
        <controls:SuccessOverlayHost />
    </Grid>
</ContentPage>
