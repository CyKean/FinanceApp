<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:FinanceApp.Mobile.ViewModels"
             xmlns:converters="clr-namespace:FinanceApp.Mobile.Converters"
             xmlns:controls="clr-namespace:FinanceApp.Mobile.Views.Controls"
             xmlns:dtos="clr-namespace:FinanceApp.Application.DTOs;assembly=FinanceApp.Application"
             xmlns:services="clr-namespace:FinanceApp.Mobile.Services"
             x:Class="FinanceApp.Mobile.Views.GoalsPage"
             x:DataType="viewmodels:GoalsViewModel"
             Title="{Binding Title}"
             Shell.NavBarIsVisible="False"
             x:Name="GoalsPageView">

    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:MoneyToStringConverter x:Key="MoneyConverter" />
            <converters:PercentageConverter x:Key="PercentageConverter" />
            <converters:PercentageToColorConverter x:Key="PercentageColorConverter" />
            <converters:InverseBoolConverter x:Key="InverseBoolConverter" />
            <converters:ColorConverter x:Key="ColorConverter" />
            <converters:GoalStatusToStringConverter x:Key="GoalStatusToStringConverter" />
            <converters:GoalStatusVisibilityConverter x:Key="GoalStatusVisibilityConverter" />
            <converters:NullToBoolConverter x:Key="NullToBoolConverter" />
            <converters:BoolToStyleConverter x:Key="BoolToStyleConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid>
        <RefreshView Command="{Binding RefreshCommand}" IsRefreshing="{Binding IsBusy}">
            <VerticalStackLayout Spacing="16" Padding="16,16,16,24">

                <!-- Header -->
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                    <Border Grid.Column="0"
                            Padding="14,9"
                            BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceContainerLow}, Dark={StaticResource SurfaceContainerLowDark}}"
                            StrokeThickness="0"
                            VerticalOptions="Center">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="14" />
                        </Border.StrokeShape>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnBackTapped" />
                        </Border.GestureRecognizers>
                        <HorizontalStackLayout Spacing="5" VerticalOptions="Center">
                            <Label Text="&#x2039;"
                                   FontSize="22"
                                   FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryLight}}"
                                   VerticalOptions="Center" />
                            <Label Text="Back"
                                   FontSize="14"
                                   FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryLight}}"
                                   VerticalOptions="Center" />
                        </HorizontalStackLayout>
                    </Border>

                    <Label Grid.Column="1"
                           Text="Goals"
                           Style="{StaticResource TitleLabelStyle}"
                           HorizontalOptions="Center"
                           VerticalOptions="Center" />

                    <Border Grid.Column="2"
                            Padding="13,9"
                            BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceContainerHigh}, Dark={StaticResource SurfaceContainerHighDark}}"
                            StrokeThickness="0"
                            VerticalOptions="Center">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="14" />
                        </Border.StrokeShape>
                        <Label Text="{Binding Goals.Count}"
                               FontSize="13"
                               FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryLight}}"
                               VerticalOptions="Center" />
                    </Border>
                </Grid>

                <!-- Tabs -->
                <Border Style="{StaticResource CardFrameStyle}" Padding="8">
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                        <Button Grid.Column="0" Text="Goals" HeightRequest="46"
                                Command="{Binding ShowGoalsTabCommand}"
                                Style="{Binding IsGoalsTab, Converter={StaticResource BoolToStyleConverter}}" />
                        <Button Grid.Column="1" Text="History" HeightRequest="46"
                                Command="{Binding ShowHistoryTabCommand}"
                                Style="{Binding ShowHistory, Converter={StaticResource BoolToStyleConverter}}" />
                    </Grid>
                </Border>

                <!-- Goals Tab -->
                <VerticalStackLayout Spacing="16" IsVisible="{Binding IsGoalsTab}">
                    <CollectionView ItemsSource="{Binding Goals}" SelectionMode="None">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="dtos:FinancialGoalDto">
                                <SwipeView>
                                    <SwipeView.RightItems>
                                        <SwipeItems>
                                            <SwipeItem Text="Edit"
                                                       BackgroundColor="#0E6B4F"
                                                       Command="{Binding Source={x:Reference GoalsPageView}, Path=BindingContext.EditGoalCommand}"
                                                       CommandParameter="{Binding .}" />
                                            <SwipeItem Text="Add Progress"
                                                       BackgroundColor="#D97706"
                                                       Command="{Binding Source={x:Reference GoalsPageView}, Path=BindingContext.AddProgressCommand}"
                                                       CommandParameter="{Binding .}" />
                                            <SwipeItem Text="Complete"
                                                       BackgroundColor="#2563EB"
                                                       Command="{Binding Source={x:Reference GoalsPageView}, Path=BindingContext.CompleteGoalCommand}"
                                                       CommandParameter="{Binding .}"
                                                       IsVisible="{Binding Status, Converter={StaticResource GoalStatusVisibilityConverter}, ConverterParameter=Active}" />
                                            <SwipeItem Text="Delete"
                                                       BackgroundColor="#DC2626"
                                                       Command="{Binding Source={x:Reference GoalsPageView}, Path=BindingContext.DeleteGoalCommand}"
                                                       CommandParameter="{Binding .}" />
                                        </SwipeItems>
                                    </SwipeView.RightItems>
                                    <Border Style="{StaticResource GoalCardFrameStyle}" Margin="0,8">
                                        <VerticalStackLayout Spacing="14">

                                            <!-- Icon, name, progress, percent -->
                                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                                <Border Grid.Column="0"
                                                        WidthRequest="50"
                                                        HeightRequest="50"
                                                        BackgroundColor="{Binding Color, Converter={StaticResource ColorConverter}}"
                                                        StrokeThickness="0"
                                                        VerticalOptions="Center">
                                                    <Border.StrokeShape>
                                                        <RoundRectangle CornerRadius="16" />
                                                    </Border.StrokeShape>
                                                    <Label Text="{Binding Icon}"
                                                           FontSize="22"
                                                           HorizontalOptions="Center"
                                                           VerticalOptions="Center" />
                                                </Border>

                                                <VerticalStackLayout Grid.Column="1" Spacing="7" VerticalOptions="Center">
                                                    <Label Text="{Binding Name}" Style="{StaticResource GoalNameLabelStyle}" />
                                                    <ProgressBar Progress="{Binding ProgressPercentage, Converter={StaticResource PercentageConverter}}"
                                                                 ProgressColor="{Binding ProgressPercentage, Converter={StaticResource PercentageColorConverter}}"
                                                                 HeightRequest="7" />
                                                </VerticalStackLayout>

                                                <Border Grid.Column="2"
                                                        Padding="11,6"
                                                        BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceContainerHigh}, Dark={StaticResource SurfaceContainerHighDark}}"
                                                        StrokeThickness="0"
                                                        VerticalOptions="Center">
                                                    <Border.StrokeShape>
                                                        <RoundRectangle CornerRadius="12" />
                                                    </Border.StrokeShape>
                                                    <Label Text="{Binding ProgressPercentage, StringFormat='{0:F1}%'}"
                                                           FontSize="13"
                                                           FontAttributes="Bold"
                                                           TextColor="{Binding ProgressPercentage, Converter={StaticResource PercentageColorConverter}}" />
                                                </Border>
                                            </Grid>

                                            <!-- Amounts -->
                                            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                                                <Border Grid.Column="0"
                                                        Padding="10,9"
                                                        BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceContainerLow}, Dark={StaticResource SurfaceContainerLowDark}}"
                                                        StrokeThickness="0">
                                                    <Border.StrokeShape>
                                                        <RoundRectangle CornerRadius="14" />
                                                    </Border.StrokeShape>
                                                    <VerticalStackLayout Spacing="3">
                                                        <Label Text="Current" FontSize="11"
                                                               TextColor="{AppThemeBinding Light={StaticResource OnSurfaceVariant}, Dark={StaticResource OnSurfaceVariantDark}}" />
                                                        <Label Text="{Binding CurrentAmount, Converter={StaticResource MoneyConverter}}"
                                                               FontSize="13" FontAttributes="Bold" TextColor="#16A34A" />
                                                    </VerticalStackLayout>
                                                </Border>

                                                <Border Grid.Column="1"
                                                        Padding="10,9"
                                                        BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceContainerLow}, Dark={StaticResource SurfaceContainerLowDark}}"
                                                        StrokeThickness="0">
                                                    <Border.StrokeShape>
                                                        <RoundRectangle CornerRadius="14" />
                                                    </Border.StrokeShape>
                                                    <VerticalStackLayout Spacing="3">
                                                        <Label Text="Target" FontSize="11"
                                                               TextColor="{AppThemeBinding Light={StaticResource OnSurfaceVariant}, Dark={StaticResource OnSurfaceVariantDark}}" />
                                                        <Label Text="{Binding TargetAmount, Converter={StaticResource MoneyConverter}}"
                                                               FontSize="13" FontAttributes="Bold"
                                                               TextColor="{AppThemeBinding Light={StaticResource OnSurface}, Dark={StaticResource OnSurfaceDark}}" />
                                                    </VerticalStackLayout>
                                                </Border>

                                                <Border Grid.Column="2"
                                                        Padding="10,9"
                                                        BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceContainerLow}, Dark={StaticResource SurfaceContainerLowDark}}"
                                                        StrokeThickness="0">
                                                    <Border.StrokeShape>
                                                        <RoundRectangle CornerRadius="14" />
                                                    </Border.StrokeShape>
                                                    <VerticalStackLayout Spacing="3">
                                                        <Label Text="Remaining" FontSize="11"
                                                               TextColor="{AppThemeBinding Light={StaticResource OnSurfaceVariant}, Dark={StaticResource OnSurfaceVariantDark}}" />
                                                        <Label Text="{Binding RemainingAmount, Converter={StaticResource MoneyConverter}}"
                                                               FontSize="13" FontAttributes="Bold" TextColor="#DC2626" />
                                                    </VerticalStackLayout>
                                                </Border>
                                            </Grid>

                                            <!-- Pace -->
                                            <HorizontalStackLayout Spacing="8">
                                                <Border Padding="11,6"
                                                        BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceContainerHigh}, Dark={StaticResource SurfaceContainerHighDark}}"
                                                        StrokeThickness="0"
                                                        VerticalOptions="Center">
                                                    <Border.StrokeShape>
                                                        <RoundRectangle CornerRadius="12" />
                                                    </Border.StrokeShape>
                                                    <Label Text="{Binding DaysRemaining, StringFormat='{0} days left'}"
                                                           Style="{StaticResource GoalDaysLabelStyle}" />
                                                </Border>
                                                <Border Padding="11,6"
                                                        BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceContainerHigh}, Dark={StaticResource SurfaceContainerHighDark}}"
                                                        StrokeThickness="0"
                                                        VerticalOptions="Center">
                                                    <Border.StrokeShape>
                                                        <RoundRectangle CornerRadius="12" />
                                                    </Border.StrokeShape>
                                                    <Label Text="{Binding RequiredMonthlySavings, StringFormat='Need {0}/month', Converter={StaticResource MoneyConverter}}"
                                                           Style="{StaticResource GoalMonthlyLabelStyle}" />
                                                </Border>
                                            </HorizontalStackLayout>

                                            <!-- Status and actions -->
                                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                                <Border Grid.Column="0"
                                                        Padding="11,7"
                                                        BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceContainerHigh}, Dark={StaticResource SurfaceContainerHighDark}}"
                                                        StrokeThickness="0"
                                                        HorizontalOptions="Start"
                                                        VerticalOptions="Center">
                                                    <Border.StrokeShape>
                                                        <RoundRectangle CornerRadius="12" />
                                                    </Border.StrokeShape>
                                                    <Label Text="{Binding Status, Converter={StaticResource GoalStatusToStringConverter}}"
                                                           Style="{StaticResource GoalStatusLabelStyle}" />
                                                </Border>
                                                <Button Grid.Column="1"
                                                        Text="Edit"
                                                        HeightRequest="40"
                                                        FontSize="13"
                                                        Padding="20,0"
                                                        Style="{StaticResource OutlineButtonStyle}"
                                                        Command="{Binding Source={x:Reference GoalsPageView}, Path=BindingContext.EditGoalCommand}"
                                                        CommandParameter="{Binding .}" />
                                                <Button Grid.Column="2"
                                                        Text="Delete"
                                                        HeightRequest="40"
                                                        FontSize="13"
                                                        Padding="20,0"
                                                        Style="{StaticResource DangerButtonStyle}"
                                                        Command="{Binding Source={x:Reference GoalsPageView}, Path=BindingContext.DeleteGoalCommand}"
                                                        CommandParameter="{Binding .}" />
                                            </Grid>

                                        </VerticalStackLayout>
                                    </Border>
                                </SwipeView>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                        <CollectionView.EmptyView>
                            <VerticalStackLayout Spacing="8" HorizontalOptions="Center" VerticalOptions="Center" Padding="20">
                                <Label Text="&#x1F3AF;" FontSize="48" />
                                <Label Text="No goals yet" Style="{StaticResource EmptyStateLabelStyle}" />
                                <Label Text="Create a financial goal to start saving" Style="{StaticResource EmptyStateSubLabelStyle}" />
                            </VerticalStackLayout>
                        </CollectionView.EmptyView>
                    </CollectionView>

                    <!-- Add Goal Button -->
                    <Button Text="Add Goal"
                            Command="{Binding AddGoalCommand}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            TextColor="White"
                            Margin="0,4,0,8" />
                </VerticalStackLayout>

                <!-- History Tab -->
                <VerticalStackLayout Spacing="8" IsVisible="{Binding ShowHistory}">
                    <CollectionView ItemsSource="{Binding History}">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="services:GoalHistoryEntryDto">
                                <Border Style="{StaticResource GoalCardFrameStyle}" Margin="0,4">
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                        <Border Grid.Column="0"
                                                WidthRequest="42"
                                                HeightRequest="42"
                                                BackgroundColor="{Binding ActionColor, Converter={StaticResource ColorConverter}}"
                                                StrokeThickness="0"
                                                VerticalOptions="Center">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="14" />
                                            </Border.StrokeShape>
                                            <Label Text="{Binding ActionIcon}" FontSize="17" HorizontalOptions="Center" VerticalOptions="Center" />
                                        </Border>
                                        <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
                                            <Label Text="{Binding GoalName}" FontSize="15" FontAttributes="Bold"
                                                   TextColor="{AppThemeBinding Light={StaticResource OnSurface}, Dark={StaticResource OnSurfaceDark}}" />
                                            <Label Text="{Binding Action}" FontSize="12" FontAttributes="Bold"
                                                   TextColor="{Binding ActionColor, Converter={StaticResource ColorConverter}}" />
                                            <Label Text="{Binding Details}" FontSize="12" LineBreakMode="WordWrap"
                                                   TextColor="{AppThemeBinding Light={StaticResource OnSurfaceVariant}, Dark={StaticResource OnSurfaceVariantDark}}" />
                                        </VerticalStackLayout>
                                        <Label Grid.Column="2" Text="{Binding TimeLabel}" FontSize="11"
                                               TextColor="{AppThemeBinding Light={StaticResource OnSurfaceVariant}, Dark={StaticResource OnSurfaceVariantDark}}"
                                               VerticalOptions="Center" HorizontalTextAlignment="End" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                        <CollectionView.EmptyView>
                            <VerticalStackLayout Spacing="8" HorizontalOptions="Center" VerticalOptions="Center" Padding="20">
                                <Label Text="&#x1F5C2;&#xFE0F;" FontSize="48" HorizontalOptions="Center" />
                                <Label Text="No history yet" Style="{StaticResource EmptyStateLabelStyle}" />
                                <Label Text="Edits and deletions will show up here" Style="{StaticResource EmptyStateSubLabelStyle}" />
                            </VerticalStackLayout>
                        </CollectionView.EmptyView>
                    </CollectionView>
                </VerticalStackLayout>

            </VerticalStackLayout>
        </RefreshView>

        <!-- Toasts -->
        <controls:ToastHost />

        <!-- Custom confirmation modal -->
        <controls:ConfirmModalHost />

        <!-- Success animation -->
        <controls:SuccessOverlayHost />
    </Grid>
</ContentPage>
