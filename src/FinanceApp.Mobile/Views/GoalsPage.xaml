<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:FinanceApp.Mobile.ViewModels"
             xmlns:converters="clr-namespace:FinanceApp.Mobile.Converters"
             xmlns:controls="clr-namespace:FinanceApp.Mobile.Views.Controls"
             xmlns:dtos="clr-namespace:FinanceApp.Application.DTOs;assembly=FinanceApp.Application"
             xmlns:services="clr-namespace:FinanceApp.Mobile.Services"
             x:Class="FinanceApp.Mobile.Views.GoalsPage"
             x:DataType="viewmodels:GoalsViewModel"
             Title="{Binding Title}"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource FinoraCream}"
             x:Name="GoalsPageView">

    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:MoneyToStringConverter x:Key="MoneyConverter" />
            <converters:PercentageConverter x:Key="PercentageConverter" />
            <converters:PercentageToColorConverter x:Key="PercentageColorConverter" />
            <converters:InverseBoolConverter x:Key="InverseBoolConverter" />
            <converters:ColorConverter x:Key="ColorConverter" />
            <converters:GoalStatusToStringConverter x:Key="GoalStatusToStringConverter" />
            <converters:GoalStatusVisibilityConverter x:Key="GoalStatusVisibilityConverter" />
            <converters:NullToBoolConverter x:Key="NullToBoolConverter" />
            <converters:BoolToStyleConverter x:Key="BoolToStyleConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid>
        <RefreshView Command="{Binding RefreshCommand}" IsRefreshing="{Binding IsBusy}">
            <ScrollView>
            <VerticalStackLayout Spacing="14" Padding="18,14,18,24">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                    <Border Grid.Column="0" WidthRequest="46" HeightRequest="46" Background="{StaticResource FinoraCard}" Stroke="{StaticResource FinoraInk}" StrokeThickness="1.5" VerticalOptions="Center">
                        <Border.StrokeShape><Ellipse /></Border.StrokeShape>
                        <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnBackTapped" /></Border.GestureRecognizers>
                        <Label Text="←" FontSize="20" FontAttributes="Bold" TextColor="{StaticResource FinoraInk}" HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>
                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                        <Label Text="Goals" FontSize="18" FontAttributes="Bold" TextColor="{StaticResource FinoraInk}" HorizontalOptions="Center" />
                        <Label Text="Track your savings targets" FontSize="12" TextColor="#6F7668" HorizontalOptions="Center" />
                    </VerticalStackLayout>
                    <Border Grid.Column="2" Background="{StaticResource FinoraLime}" Stroke="{StaticResource FinoraInk}" StrokeThickness="1.5" Padding="12,8" VerticalOptions="Center">
                        <Border.StrokeShape><RoundRectangle CornerRadius="100" /></Border.StrokeShape>
                        <Label Text="{Binding Goals.Count, StringFormat='{0}'}" FontSize="13" FontAttributes="Bold" TextColor="{StaticResource FinoraInk}" />
                    </Border>
                </Grid>

                <!-- Goal hero (earning style) -->
                <Border Style="{StaticResource FinoraLimeCardStyle}">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="↗ Total saved" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource FinoraInk}" />
                        <Label Text="{Binding Goals.Count, StringFormat='{0} goals in progress'}" FontSize="20" FontAttributes="Bold" TextColor="{StaticResource FinoraInk}" />
                        <Label Text="Small steps every month get you there." FontSize="11" TextColor="{StaticResource FinoraInk}" Opacity="0.75" />
                    </VerticalStackLayout>
                </Border>

                <VerticalStackLayout Spacing="10" IsVisible="{Binding IsGoalsTab}">
                    <CollectionView ItemsSource="{Binding Goals}" SelectionMode="None">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="dtos:FinancialGoalDto">
                                <SwipeView>
                                    <SwipeView.RightItems>
                                        <SwipeItems>
                                            <SwipeItem Text="Edit" BackgroundColor="#161B16"
                                                       Command="{Binding Source={x:Reference GoalsPageView}, Path=BindingContext.EditGoalCommand}"
                                                       CommandParameter="{Binding .}" />
                                            <SwipeItem Text="Delete" BackgroundColor="#DC2626"
                                                       Command="{Binding Source={x:Reference GoalsPageView}, Path=BindingContext.DeleteGoalCommand}"
                                                       CommandParameter="{Binding .}" />
                                        </SwipeItems>
                                    </SwipeView.RightItems>
                                    <Border Background="{StaticResource FinoraCard}" Stroke="{StaticResource FinoraInk}" StrokeThickness="1.5" Padding="16" Margin="0,5">
                                        <Border.StrokeShape><RoundRectangle CornerRadius="24" /></Border.StrokeShape>
                                        <VerticalStackLayout Spacing="10">
                                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                                <controls:FinoraIconView Grid.Column="0" Icon="{Binding Icon}" Name="{Binding Name}" Size="50" VerticalOptions="Center" />
                                                <VerticalStackLayout Grid.Column="1" Spacing="6" VerticalOptions="Center">
                                                    <Label Text="{Binding Name}" FontSize="15" FontAttributes="Bold" TextColor="{StaticResource FinoraInk}" />
                                                    <ProgressBar Progress="{Binding ProgressPercentage, Converter={StaticResource PercentageConverter}}"
                                                                 ProgressColor="{StaticResource FinoraInk}" HeightRequest="8" BackgroundColor="#E4EACB" />
                                                </VerticalStackLayout>
                                                <Border Grid.Column="2" Background="{StaticResource FinoraLime}" Stroke="{StaticResource FinoraInk}" StrokeThickness="1.2" Padding="10,6" VerticalOptions="Center">
                                                    <Border.StrokeShape><RoundRectangle CornerRadius="100" /></Border.StrokeShape>
                                                    <Label Text="{Binding ProgressPercentage, StringFormat='{0:F0}%'}" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource FinoraInk}" />
                                                </Border>
                                            </Grid>
                                            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                                                <Border Padding="10,8" Background="{StaticResource FinoraCream}" StrokeThickness="0">
                                                    <Border.StrokeShape><RoundRectangle CornerRadius="16" /></Border.StrokeShape>
                                                    <VerticalStackLayout Spacing="2">
                                                        <Label Text="Current" FontSize="10" TextColor="#6F7668" />
                                                        <Label Text="{Binding CurrentAmount, Converter={StaticResource MoneyConverter}}" FontSize="12" FontAttributes="Bold" TextColor="#3E7C2B" />
                                                    </VerticalStackLayout>
                                                </Border>
                                                <Border Grid.Column="1" Padding="10,8" Background="{StaticResource FinoraCream}" StrokeThickness="0">
                                                    <Border.StrokeShape><RoundRectangle CornerRadius="16" /></Border.StrokeShape>
                                                    <VerticalStackLayout Spacing="2">
                                                        <Label Text="Target" FontSize="10" TextColor="#6F7668" />
                                                        <Label Text="{Binding TargetAmount, Converter={StaticResource MoneyConverter}}" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource FinoraInk}" />
                                                    </VerticalStackLayout>
                                                </Border>
                                                <Border Grid.Column="2" Padding="10,8" Background="{StaticResource FinoraInk}" StrokeThickness="0">
                                                    <Border.StrokeShape><RoundRectangle CornerRadius="16" /></Border.StrokeShape>
                                                    <VerticalStackLayout Spacing="2">
                                                        <Label Text="Left" FontSize="10" TextColor="{StaticResource FinoraLime}" />
                                                        <Label Text="{Binding DaysRemaining, StringFormat='{0}d'}" FontSize="12" FontAttributes="Bold" TextColor="White" />
                                                    </VerticalStackLayout>
                                                </Border>
                                            </Grid>
                                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                                <Label Grid.Column="0" Text="{Binding Status, Converter={StaticResource GoalStatusToStringConverter}}" FontSize="12" FontAttributes="Bold" TextColor="#6F7668" VerticalOptions="Center" />
                                                <Button Grid.Column="1" Text="Edit" HeightRequest="40" FontSize="13" Padding="20,0" Style="{StaticResource OutlineButtonStyle}"
                                                        Command="{Binding Source={x:Reference GoalsPageView}, Path=BindingContext.EditGoalCommand}" CommandParameter="{Binding .}" />
                                                <Border Grid.Column="2" WidthRequest="48" HeightRequest="40" Background="{StaticResource FinoraLime}" Stroke="{StaticResource FinoraInk}" StrokeThickness="1.5" VerticalOptions="Center">
                                                    <Border.StrokeShape><RoundRectangle CornerRadius="100" /></Border.StrokeShape>
                                                    <controls:FinoraIconView IconKey="plus" Size="22" ShowBadge="False" Light="True" HorizontalOptions="Center" VerticalOptions="Center">
                                                        <controls:FinoraIconView.GestureRecognizers>
                                                            <TapGestureRecognizer Command="{Binding Source={x:Reference GoalsPageView}, Path=BindingContext.AddProgressCommand}" CommandParameter="{Binding .}" />
                                                        </controls:FinoraIconView.GestureRecognizers>
                                                    </controls:FinoraIconView>
                                                </Border>
                                            </Grid>
                                        </VerticalStackLayout>
                                    </Border>
                                </SwipeView>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                        <CollectionView.EmptyView>
                            <controls:FinoraEmptyState Title="No goals yet"
                                                     Subtitle="Create a financial goal to start saving"
                                                     IconKey="target" />
                        </CollectionView.EmptyView>
                    </CollectionView>
                    <Button Text="+ Add Goal" Command="{Binding AddGoalCommand}" Style="{StaticResource PrimaryButtonStyle}" Margin="0,4,0,8" />
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="8" IsVisible="{Binding ShowHistory}">
                    <CollectionView ItemsSource="{Binding History}">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="services:GoalHistoryEntryDto">
                                <Border Background="{StaticResource FinoraCard}" Stroke="#D3D9BE" StrokeThickness="1" Padding="12" Margin="0,4">
                                    <Border.StrokeShape><RoundRectangle CornerRadius="20" /></Border.StrokeShape>
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                        <Border Grid.Column="0" WidthRequest="42" HeightRequest="42" BackgroundColor="{Binding ActionColor, Converter={StaticResource ColorConverter}}" Stroke="{StaticResource FinoraInk}" StrokeThickness="1" VerticalOptions="Center">
                                            <Border.StrokeShape><RoundRectangle CornerRadius="14" /></Border.StrokeShape>
                                            <Label Text="{Binding ActionIcon}" FontSize="17" HorizontalOptions="Center" VerticalOptions="Center" />
                                        </Border>
                                        <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                            <Label Text="{Binding GoalName}" FontSize="14" FontAttributes="Bold" TextColor="{StaticResource FinoraInk}" />
                                            <Label Text="{Binding Details}" FontSize="12" TextColor="#6F7668" LineBreakMode="WordWrap" />
                                        </VerticalStackLayout>
                                        <Label Grid.Column="2" Text="{Binding TimeLabel}" FontSize="11" TextColor="#6F7668" VerticalOptions="Center" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                        <CollectionView.EmptyView>
                            <controls:FinoraEmptyState Title="No history yet"
                                                     Subtitle="Edits and deletions will show up here"
                                                     IconKey="sync" />
                        </CollectionView.EmptyView>
                    </CollectionView>
                </VerticalStackLayout>
            </VerticalStackLayout>
            </ScrollView>
        </RefreshView>

        <controls:ToastHost />
        <controls:ConfirmModalHost />
        <controls:SuccessOverlayHost />
    </Grid>
</ContentPage>
