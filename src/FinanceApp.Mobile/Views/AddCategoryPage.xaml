<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:FinanceApp.Mobile.ViewModels"
             xmlns:converters="clr-namespace:FinanceApp.Mobile.Converters"
             xmlns:controls="clr-namespace:FinanceApp.Mobile.Views.Controls"
             x:Class="FinanceApp.Mobile.Views.AddCategoryPage"
             Title="{Binding Title}"
             x:Name="AddCategoryPageView">

    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:MoneyToStringConverter x:Key="MoneyConverter" />
            <converters:ColorConverter x:Key="ColorConverter" />
            <converters:InverseBoolConverter x:Key="InverseBoolConverter" />
            <converters:CategoryTabStyleConverter x:Key="CategoryTabStyleConverter" />
            <converters:CategoryTabVisibilityConverter x:Key="CategoryTabVisibilityConverter" />
            <converters:BoolToStringConverter x:Key="BoolToStringConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid>
    <ScrollView>
        <VerticalStackLayout Spacing="16" Padding="16">
            <!-- Name -->
            <Border Style="{StaticResource CardFrameStyle}" Padding="16">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Category Name" Style="{StaticResource FormLabelStyle}" />
                    <Entry Text="{Binding Name}" Placeholder="e.g., Food" Style="{StaticResource EntryStyle}" />
                </VerticalStackLayout>
            </Border>

            <!-- Type (only for new categories) -->
            <Border Style="{StaticResource CardFrameStyle}" Padding="16" IsVisible="{Binding IsEditing, Converter={StaticResource InverseBoolConverter}}">
                <HorizontalStackLayout Spacing="12">
                    <Button Text="Expense" 
                            Command="{Binding SetExpenseTypeCommand}"
                            Style="{Binding CategoryType, Converter={StaticResource CategoryTabStyleConverter}, ConverterParameter=Expense}"
                            HorizontalOptions="Fill" />
                    <Button Text="Income" 
                            Command="{Binding SetIncomeTypeCommand}"
                            Style="{Binding CategoryType, Converter={StaticResource CategoryTabStyleConverter}, ConverterParameter=Income}"
                            HorizontalOptions="Fill" />
                </HorizontalStackLayout>
            </Border>

            <!-- Icon picker -->
            <Border Style="{StaticResource CardFrameStyle}" Padding="16">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Icon" Style="{StaticResource FormLabelStyle}" />
                    <HorizontalStackLayout Spacing="12" VerticalOptions="Center">
                        <Border WidthRequest="52" HeightRequest="52"
                                Background="{Binding Color, Converter={StaticResource ColorConverter}}"
                                StrokeThickness="0"
                                VerticalOptions="Center">
                            <Border.StrokeShape>
                                <Ellipse />
                            </Border.StrokeShape>
                            <Label Text="{Binding Icon}" TargetNullValue="🏷️" FontSize="26" VerticalOptions="Center" HorizontalOptions="Center" />
                        </Border>
                        <Label Text="Tap an icon below"
                               Style="{StaticResource MutedLabelStyle}"
                               VerticalOptions="Center"
                               HorizontalOptions="Fill" />
                    </HorizontalStackLayout>
                    <FlexLayout x:Name="EmojiContainer"
                                Direction="Row"
                                Wrap="Wrap"
                                Justify="Start" />
                </VerticalStackLayout>
            </Border>

            <!-- Color picker -->
            <Border Style="{StaticResource CardFrameStyle}" Padding="16">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Color" Style="{StaticResource FormLabelStyle}" />
                    <HorizontalStackLayout Spacing="12" VerticalOptions="Center">
                        <Border WidthRequest="40" HeightRequest="40"
                                Background="{Binding Color, Converter={StaticResource ColorConverter}}"
                                StrokeThickness="0"
                                VerticalOptions="Center">
                            <Border.StrokeShape>
                                <Ellipse />
                            </Border.StrokeShape>
                        </Border>
                        <Label Text="{Binding Color}"
                               Style="{StaticResource MutedLabelStyle}"
                               VerticalOptions="Center"
                               HorizontalOptions="Fill" />
                    </HorizontalStackLayout>
                    <FlexLayout x:Name="ColorContainer"
                                Direction="Row"
                                Wrap="Wrap"
                                Justify="Start" />
                </VerticalStackLayout>
            </Border>

            <!-- Save Button -->
            <Button Text="{Binding IsEditing, Converter={StaticResource BoolToStringConverter}, ConverterParameter='Update|Save'}" 
                    Command="{Binding SaveCommand}"
                    IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Margin="16,24,16,16" />
        </VerticalStackLayout>
    </ScrollView>

        <!-- Toasts -->
        <controls:ToastHost />
    </Grid>

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Cancel" Command="{Binding CancelCommand}" Priority="0" />
    </ContentPage.ToolbarItems>
</ContentPage>