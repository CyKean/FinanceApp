<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:FinanceApp.Mobile.ViewModels"
             xmlns:converters="clr-namespace:FinanceApp.Mobile.Converters"
             x:Class="FinanceApp.Mobile.Views.AddCategoryPage"
             Title="{Binding Title}"
             x:Name="AddCategoryPageView">

    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:MoneyToStringConverter x:Key="MoneyConverter" />
            <converters:ColorConverter x:Key="ColorConverter" />
            <converters:InverseBoolConverter x:Key="InverseBoolConverter" />
            <converters:CategoryTabStyleConverter x:Key="CategoryTabStyleConverter" />
            <converters:CategoryTabVisibilityConverter x:Key="CategoryTabVisibilityConverter" />
            <converters:BoolToStringConverter x:Key="BoolToStringConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Spacing="16" Padding="16">
            <!-- Name -->
            <Border Style="{StaticResource CardFrameStyle}" Padding="16">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Category Name" Style="{StaticResource FormLabelStyle}" />
                    <Entry Text="{Binding Name}" Placeholder="e.g., Food" Style="{StaticResource EntryStyle}" />
                </VerticalStackLayout>
            </Border>

            <!-- Type (only for new categories) -->
            <Border Style="{StaticResource CardFrameStyle}" Padding="16" IsVisible="{Binding IsEditing, Converter={StaticResource InverseBoolConverter}}">
                <HorizontalStackLayout Spacing="12">
                    <Button Text="Expense" 
                            Command="{Binding SetExpenseTypeCommand}"
                            Style="{Binding CategoryType, Converter={StaticResource CategoryTabStyleConverter}, ConverterParameter=Expense}"
                            HorizontalOptions="Fill" />
                    <Button Text="Income" 
                            Command="{Binding SetIncomeTypeCommand}"
                            Style="{Binding CategoryType, Converter={StaticResource CategoryTabStyleConverter}, ConverterParameter=Income}"
                            HorizontalOptions="Fill" />
                </HorizontalStackLayout>
            </Border>

            <!-- Icon -->
            <Border Style="{StaticResource CardFrameStyle}" Padding="16">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Icon (Emoji)" Style="{StaticResource FormLabelStyle}" />
                    <Entry Text="{Binding Icon}" Placeholder="🍔" Style="{StaticResource EntryStyle}" MaxLength="2" />
                </VerticalStackLayout>
            </Border>

            <!-- Color -->
            <Border Style="{StaticResource CardFrameStyle}" Padding="16">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Color (Hex)" Style="{StaticResource FormLabelStyle}" />
                    <Entry Text="{Binding Color}" Placeholder="#512BD4" Style="{StaticResource EntryStyle}" MaxLength="7" />
                </VerticalStackLayout>
            </Border>

            <!-- Save Button -->
            <Button Text="{Binding IsEditing, Converter={StaticResource BoolToStringConverter}, ConverterParameter='Update|Save'}" 
                    Command="{Binding SaveCommand}"
                    IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Margin="16,24,16,16" />
        </VerticalStackLayout>
    </ScrollView>

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Cancel" Command="{Binding CancelCommand}" Priority="0" />
    </ContentPage.ToolbarItems>
</ContentPage>