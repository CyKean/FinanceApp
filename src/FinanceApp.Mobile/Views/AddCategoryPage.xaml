<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:FinanceApp.Mobile.ViewModels"
             xmlns:converters="clr-namespace:FinanceApp.Mobile.Converters"
             xmlns:controls="clr-namespace:FinanceApp.Mobile.Views.Controls"
             x:Class="FinanceApp.Mobile.Views.AddCategoryPage"
             x:DataType="viewmodels:AddCategoryViewModel"
             Title="{Binding Title}"
             Shell.NavBarIsVisible="False"
             x:Name="AddCategoryPageView">

    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:MoneyToStringConverter x:Key="MoneyConverter" />
            <converters:ColorConverter x:Key="ColorConverter" />
            <converters:InverseBoolConverter x:Key="InverseBoolConverter" />
            <converters:CategoryTabStyleConverter x:Key="CategoryTabStyleConverter" />
            <converters:CategoryTabVisibilityConverter x:Key="CategoryTabVisibilityConverter" />
            <converters:BoolToStringConverter x:Key="BoolToStringConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid>
        <ScrollView>
            <VerticalStackLayout Spacing="14" Padding="18,14,18,24">
                <!-- Header -->
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" VerticalOptions="Center">
                    <Border WidthRequest="46" HeightRequest="46"
                            Background="{DynamicResource FinoraCard}"
                            Stroke="{DynamicResource FinoraInk}" StrokeThickness="1.5"
                            VerticalOptions="Center">
                        <Border.StrokeShape><Ellipse /></Border.StrokeShape>
                        <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding CancelCommand}" /></Border.GestureRecognizers>
                        <controls:FinoraIconView IconKey="arrowleft" Size="20" ShowBadge="False" Light="True" HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>
                    <VerticalStackLayout Grid.Column="1" Spacing="0" VerticalOptions="Center">
                        <Label Text="{Binding Title}" FontSize="18" FontAttributes="Bold" FontFamily="SpaceGroteskBold" TextColor="{DynamicResource FinoraInk}" />
                        <Label Text="Name, icon and color" FontSize="12" TextColor="{DynamicResource FinoraMuted}" />
                    </VerticalStackLayout>
                    <Border Grid.Column="2" WidthRequest="46" HeightRequest="46"
                            Background="{DynamicResource FinoraLime}"
                            Stroke="{DynamicResource FinoraInk}" StrokeThickness="1.5"
                            VerticalOptions="Center">
                        <Border.StrokeShape><Ellipse /></Border.StrokeShape>
                        <controls:FinoraIconView IconKey="tag" Size="18" ShowBadge="False" Light="True" HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>
                </Grid>

                <!-- Name -->
                <Border Style="{StaticResource CardFrameStyle}" Padding="16">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Category Name" Style="{StaticResource FormLabelStyle}" />
                        <Entry Text="{Binding Name}" Placeholder="e.g., Food" Style="{StaticResource EntryStyle}" />
                    </VerticalStackLayout>
                </Border>

                <!-- Type (only for new categories) -->
                <Border Style="{StaticResource CardFrameStyle}" Padding="8" IsVisible="{Binding IsEditing, Converter={StaticResource InverseBoolConverter}}">
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                        <Button Grid.Column="0"
                                Text="Expense"
                                HeightRequest="46"
                                Command="{Binding SetExpenseTypeCommand}"
                                Style="{Binding Type, Converter={StaticResource CategoryTabStyleConverter}, ConverterParameter=Expense}" />
                        <Button Grid.Column="1"
                                Text="Income"
                                HeightRequest="46"
                                Command="{Binding SetIncomeTypeCommand}"
                                Style="{Binding Type, Converter={StaticResource CategoryTabStyleConverter}, ConverterParameter=Income}" />
                    </Grid>
                </Border>

                <!-- Icon picker -->
                <Border Style="{StaticResource CardFrameStyle}" Padding="16">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Icon" Style="{StaticResource FormLabelStyle}" />
                        <HorizontalStackLayout Spacing="12" VerticalOptions="Center">
                            <controls:FinoraIconView Icon="{Binding Icon}" Name="{Binding Name}" Size="52" VerticalOptions="Center" />
                            <Label Text="Tap an icon below"
                                   Style="{StaticResource MutedLabelStyle}"
                                   VerticalOptions="Center"
                                   HorizontalOptions="Fill" />
                        </HorizontalStackLayout>
                        <FlexLayout x:Name="EmojiContainer"
                                    Direction="Row"
                                    Wrap="Wrap" />
                    </VerticalStackLayout>
                </Border>

                <!-- Actions -->
                <VerticalStackLayout Spacing="12" Margin="0,8,0,0">
                    <Button Text="{Binding IsEditing, Converter={StaticResource BoolToStringConverter}, ConverterParameter='Update|Save'}"
                            Command="{Binding SaveCommand}"
                            IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}"
                            Style="{StaticResource PrimaryButtonStyle}" />
                    <Button Text="Cancel"
                            Command="{Binding CancelCommand}"
                            IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}"
                            Style="{StaticResource OutlineButtonStyle}" />
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>

        <!-- Toasts -->
        <controls:ToastHost />

        <!-- Create / edit animation -->
        <controls:SuccessOverlayHost />
    </Grid>
</ContentPage>
