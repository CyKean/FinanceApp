        <Setter Property="FontSize" Value="12" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource OutlineVariant}, Dark={StaticResource OutlineVariantDark}}" />
    </Style>

    <Style TargetType="Label" x:Key="SyncStatusLabelStyle" BasedOn="{StaticResource BaseLabelStyle}">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontAttributes" Value="Bold"/>
    </Style>

    <!-- ============================================ -->
    <!-- LABEL STYLES - CATEGORY RELATED -->
    <!-- ============================================ -->

    <Style TargetType="Label" x:Key="CategoryNameLabelStyle" BasedOn="{StaticResource BaseLabelStyle}">
