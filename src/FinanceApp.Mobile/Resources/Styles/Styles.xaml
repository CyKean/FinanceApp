        <Setter Property="FontAttributes" Value="Bold"/>
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource OnSurface}, Dark={StaticResource OnSurfaceDark}}" />
    </Style>

    <Style TargetType="Label" x:Key="TransactionAccountLabelStyle" BasedOn="{StaticResource Label}">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource OnSurfaceVariant}, Dark={StaticResource OnSurfaceVariantDark}}" />
    </Style>

    <Style TargetType="Label" x:Key="TransactionSeparatorLabelStyle" BasedOn="{StaticResource Label}">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource OutlineVariant}, Dark={StaticResource OutlineVariantDark}}" />
    </Style>

    <Style TargetType="Label" x:Key="SyncStatusLabelStyle" BasedOn="{StaticResource Label}">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontAttributes" Value="Bold"/>
    </Style>

    <!-- ============================================ -->
    <!-- LABEL STYLES - CATEGORY RELATED -->
    <!-- ============================================ -->

    <Style TargetType="Label" x:Key="CategoryNameLabelStyle" BasedOn="{StaticResource Label}">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontAttributes" Value="Bold"/>
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource OnSurface}, Dark={StaticResource OnSurfaceDark}}" />
    </Style>

    <Style TargetType="Label" x:Key="CategoryAmountLabelStyle" BasedOn="{StaticResource Label}">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontAttributes" Value="Bold"/>
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource OnSurface}, Dark={StaticResource OnSurfaceDark}}" />
    </Style>

    <Style TargetType="Label" x:Key="CategoryPercentLabelStyle" BasedOn="{StaticResource Label}">
