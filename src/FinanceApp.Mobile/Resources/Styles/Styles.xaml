    <Style TargetType="Label" x:Key="BudgetSpentLabelStyle" BasedOn="{StaticResource BudgetDetailValueStyle}"/>
    <Style TargetType="Label" x:Key="BudgetOfLabelStyle" BasedOn="{StaticResource Label}">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource OnSurfaceVariant}, Dark={StaticResource OnSurfaceVariantDark}}" />
        <Setter Property="VerticalOptions" Value="Center"/>
    </Style>
    <Style TargetType="Label" x:Key="BudgetTotalLabelStyle" BasedOn="{StaticResource BudgetDetailValueStyle}"/>
    <Style TargetType="Label" x:Key="BudgetPercentLabelStyle" BasedOn="{StaticResource BudgetPercentageLabelStyle}"/>
    <Style TargetType="Label" x:Key="OverBudgetLabelStyle" BasedOn="{StaticResource Label}">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontAttributes" Value="Bold"/>
    </Style>

    <!-- ============================================ -->
    <!-- LABEL STYLES - GOAL RELATED -->
    <!-- ============================================ -->

    <Style TargetType="Label" x:Key="GoalNameLabelStyle" BasedOn="{StaticResource CategoryNameLabelStyle}"/>

    <Style TargetType="Label" x:Key="GoalPercentageLabelStyle" BasedOn="{StaticResource Label}">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontAttributes" Value="Bold"/>
    </Style>

    <Style TargetType="Label" x:Key="GoalCurrentLabelStyle" BasedOn="{StaticResource BudgetDetailValueStyle}"/>
    <Style TargetType="Label" x:Key="GoalOfLabelStyle" BasedOn="{StaticResource Label}">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource OnSurfaceVariant}, Dark={StaticResource OnSurfaceVariantDark}}" />
        <Setter Property="VerticalOptions" Value="Center"/>
    </Style>
    <Style TargetType="Label" x:Key="GoalTargetLabelStyle" BasedOn="{StaticResource BudgetDetailValueStyle}"/>
    <Style TargetType="Label" x:Key="GoalDaysLabelStyle" BasedOn="{StaticResource Label}">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="TextColor" Value="{StaticResource Warning}" />
        <Setter Property="FontAttributes" Value="Bold"/>
    </Style>
