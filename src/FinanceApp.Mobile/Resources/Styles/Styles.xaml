        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource OnSurfaceVariant}, Dark={StaticResource OnSurfaceVariantDark}}" />
    </Style>

    <Style TargetType="Label" x:Key="InactiveLabelStyle" BasedOn="{StaticResource Label}">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="TextColor" Value="{StaticResource Warning}" />
        <Setter Property="FontAttributes" Value="Bold"/>
    </Style>

    <!-- ============================================ -->
    <!-- LABEL STYLES - BUDGET RELATED -->
