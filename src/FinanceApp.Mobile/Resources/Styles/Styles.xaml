    <Style TargetType="Label" x:Key="BudgetCategoryNameLabelStyle" BasedOn="{StaticResource CategoryNameLabelStyle}"/>

    <Style TargetType="Label" x:Key="BudgetPercentageLabelStyle" BasedOn="{StaticResource Label}">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontAttributes" Value="Bold"/>
    </Style>

    <Style TargetType="Label" x:Key="BudgetDetailCaptionStyle" BasedOn="{StaticResource Label}">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource OnSurfaceVariant}, Dark={StaticResource OnSurfaceVariantDark}}" />
