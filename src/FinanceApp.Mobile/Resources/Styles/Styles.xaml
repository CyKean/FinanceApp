        <Setter Property="FontFamily" Value="OpenSansRegular" />
        <Setter Property="FontSize" Value="14" />
    </Style>

    <Style TargetType="Label" BasedOn="{StaticResource BaseLabelStyle}" />

    <Style TargetType="Label" x:Key="Headline" BasedOn="{StaticResource BaseLabelStyle}">
        <Setter Property="FontFamily" Value="SpaceGroteskBold" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource PayInk}, Dark={StaticResource PayCream}}" />
        <Setter Property="FontSize" Value="32" />
        <Setter Property="FontAttributes" Value="Bold"/>
        <Setter Property="HorizontalOptions" Value="Center" />
        <Setter Property="HorizontalTextAlignment" Value="Center" />
    </Style>

    <Style TargetType="Label" x:Key="SubHeadline" BasedOn="{StaticResource BaseLabelStyle}">
        <Setter Property="FontFamily" Value="SpaceGrotesk" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource OnSurface}, Dark={StaticResource OnSurfaceDark}}" />
        <Setter Property="FontSize" Value="24" />
        <Setter Property="FontAttributes" Value="Bold"/>
        <Setter Property="HorizontalOptions" Value="Center" />
        <Setter Property="HorizontalTextAlignment" Value="Center" />
    </Style>

    <Style TargetType="Label" x:Key="AppTitleStyle" BasedOn="{StaticResource BaseLabelStyle}">
        <Setter Property="FontFamily" Value="SpaceGroteskBold" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource PayInk}, Dark={StaticResource PayLime}}" />
        <Setter Property="FontSize" Value="36" />
        <Setter Property="FontAttributes" Value="Bold"/>
        <Setter Property="HorizontalTextAlignment" Value="Center" />
    </Style>

    <Style TargetType="Label" x:Key="AppSubtitleStyle" BasedOn="{StaticResource BaseLabelStyle}">
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource OnSurfaceVariant}, Dark={StaticResource OnSurfaceVariantDark}}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="HorizontalTextAlignment" Value="Center" />
    </Style>

    <Style TargetType="Label" x:Key="CaptionLabelStyle" BasedOn="{StaticResource BaseLabelStyle}">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontAttributes" Value="Bold"/>
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource OnSurfaceVariant}, Dark={StaticResource OnSurfaceVariantDark}}" />
    </Style>

    <Style TargetType="Label" x:Key="FormLabelStyle" BasedOn="{StaticResource BaseLabelStyle}">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontAttributes" Value="Bold"/>
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource OnSurface}, Dark={StaticResource OnSurfaceDark}}" />
        <Setter Property="Margin" Value="0,0,0,4" />
    </Style>

    <Style TargetType="Label" x:Key="SectionHeaderStyle" BasedOn="{StaticResource BaseLabelStyle}">
        <Setter Property="FontFamily" Value="SpaceGrotesk" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontAttributes" Value="Bold"/>
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource OnSurface}, Dark={StaticResource OnSurfaceDark}}" />
        <Setter Property="Margin" Value="0,0,0,4" />
    </Style>

    <Style TargetType="Label" x:Key="BalanceLabelStyle" BasedOn="{StaticResource BaseLabelStyle}">
        <Setter Property="FontFamily" Value="SpaceGroteskBold" />
        <Setter Property="FontSize" Value="28" />
        <Setter Property="FontAttributes" Value="Bold"/>
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource OnSurface}, Dark={StaticResource OnSurfaceDark}}" />
    </Style>

    <Style TargetType="Label" x:Key="AmountLabelStyle" BasedOn="{StaticResource BaseLabelStyle}">
        <Setter Property="FontFamily" Value="SpaceGrotesk" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontAttributes" Value="Bold"/>
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource OnSurface}, Dark={StaticResource OnSurfaceDark}}" />
    </Style>

    <Style TargetType="Label" x:Key="UserEmailLabelStyle" BasedOn="{StaticResource BaseLabelStyle}">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontAttributes" Value="Bold"/>
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource OnSurface}, Dark={StaticResource OnSurfaceDark}}" />
    </Style>

    <!-- ============================================ -->
    <!-- BORDER / CARD STYLES — PAYTIN chunky rounded -->
    <!-- ============================================ -->

    <Style TargetType="Border" x:Key="CardFrameStyle">
        <Setter Property="Background" Value="{AppThemeBinding Light={StaticResource PayCard}, Dark={StaticResource CardSurfaceDark}}" />
        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource PayInk}, Dark={StaticResource CardStrokeDark}}" />
        <Setter Property="StrokeThickness" Value="1.5" />
        <Setter Property="StrokeShape">
            <Setter.Value>
                <RoundRectangle CornerRadius="28" />
            </Setter.Value>
        </Setter>
        <Setter Property="Shadow">
            <Setter.Value>
                <Shadow Brush="#161B16" Opacity="0.08" Radius="18" Offset="0,8" />
            </Setter.Value>
        </Setter>
        <Setter Property="Padding" Value="20"/>
    </Style>

    <!-- Hero dark card (VISA balance card) -->
    <Style TargetType="Border" x:Key="HeroCardStyle">
        <Setter Property="Background">
            <Setter.Value>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#232923" Offset="0.0" />
                    <GradientStop Color="#161B16" Offset="0.6" />
                    <GradientStop Color="#0E120E" Offset="1.0" />
                </LinearGradientBrush>
            </Setter.Value>
        </Setter>
        <Setter Property="Stroke" Value="#161B16" />
        <Setter Property="StrokeThickness" Value="1.5" />
        <Setter Property="StrokeShape">
            <Setter.Value>
                <RoundRectangle CornerRadius="28" />
            </Setter.Value>
        </Setter>
        <Setter Property="Shadow">
            <Setter.Value>
                <Shadow Brush="#161B16" Opacity="0.30" Radius="26" Offset="0,12" />
            </Setter.Value>
        </Setter>
        <Setter Property="Padding" Value="22"/>
    </Style>

    <!-- Lime highlight card (Earning / CTA) -->
    <Style TargetType="Border" x:Key="PayLimeCardStyle">
        <Setter Property="Background" Value="{StaticResource PayLime}" />
        <Setter Property="Stroke" Value="{StaticResource PayInk}" />
        <Setter Property="StrokeThickness" Value="1.5" />
        <Setter Property="StrokeShape">
            <Setter.Value>
                <RoundRectangle CornerRadius="28" />
            </Setter.Value>
        </Setter>
        <Setter Property="Shadow">
            <Setter.Value>
                <Shadow Brush="#161B16" Opacity="0.12" Radius="18" Offset="0,8" />
            </Setter.Value>
        </Setter>
        <Setter Property="Padding" Value="18"/>
    </Style>

    <!-- Dark stat card (Spending) -->
    <Style TargetType="Border" x:Key="PayDarkCardStyle">
        <Setter Property="Background" Value="{StaticResource PayInk}" />
        <Setter Property="Stroke" Value="{StaticResource PayInk}" />
        <Setter Property="StrokeThickness" Value="1.5" />
        <Setter Property="StrokeShape">
            <Setter.Value>
                <RoundRectangle CornerRadius="28" />
            </Setter.Value>
        </Setter>
        <Setter Property="Shadow">
            <Setter.Value>
                <Shadow Brush="#161B16" Opacity="0.25" Radius="20" Offset="0,10" />
            </Setter.Value>
        </Setter>
        <Setter Property="Padding" Value="18"/>
    </Style>

    <!-- Small lime pill (Set Budget / period selected) -->
    <Style TargetType="Border" x:Key="PayPillStyle">
        <Setter Property="Background" Value="{StaticResource PayLime}" />
        <Setter Property="Stroke" Value="{StaticResource PayInk}" />
        <Setter Property="StrokeThickness" Value="1.5" />
        <Setter Property="StrokeShape">
            <Setter.Value>
                <RoundRectangle CornerRadius="100" />
            </Setter.Value>
        </Setter>
        <Setter Property="Padding" Value="14,8"/>
    </Style>

    <!-- Cream circle action button -->
    <Style TargetType="Border" x:Key="PayCircleActionStyle">
        <Setter Property="Background" Value="{AppThemeBinding Light={StaticResource PayCard}, Dark={StaticResource SurfaceContainerDark}}" />
        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource PayInk}, Dark={StaticResource OutlineDark}}" />
        <Setter Property="StrokeThickness" Value="1.5" />
        <Setter Property="StrokeShape">
            <Setter.Value>
                <RoundRectangle CornerRadius="100" />
            </Setter.Value>
        </Setter>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="WidthRequest" Value="64"/>
        <Setter Property="HeightRequest" Value="64"/>
    </Style>

    <!-- Frosted pill used inside hero cards -->
    <Style TargetType="Border" x:Key="GlassPillStyle">
        <Setter Property="Background" Value="{StaticResource PayLime}" />
        <Setter Property="Stroke" Value="{StaticResource PayInk}" />
        <Setter Property="StrokeThickness" Value="1.5" />
        <Setter Property="StrokeShape">
            <Setter.Value>
                <RoundRectangle CornerRadius="100" />
            </Setter.Value>
        </Setter>
        <Setter Property="Padding" Value="14,8"/>
    </Style>

    <!-- Tappable list rows: soft press feedback -->
    <Style TargetType="Border" x:Key="PressableRowStyle">
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal">
                        <VisualState.Setters>
                            <Setter Property="Scale" Value="1" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Pressed">
                        <VisualState.Setters>
                            <Setter Property="Scale" Value="0.98" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <Style TargetType="Border" x:Key="FilterBarStyle">
        <Setter Property="Background" Value="{AppThemeBinding Light={StaticResource PayCard}, Dark={StaticResource SurfaceContainerLowDark}}" />
        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource PayInk}, Dark={StaticResource OutlineVariantDark}}" />
        <Setter Property="StrokeThickness" Value="1.5" />
        <Setter Property="StrokeShape">
            <Setter.Value>
                <RoundRectangle CornerRadius="100" />
            </Setter.Value>
        </Setter>
        <Setter Property="Padding" Value="12"/>
    </Style>

    <Style TargetType="Border" x:Key="BudgetCardFrameStyle">
        <Setter Property="Background" Value="{AppThemeBinding Light={StaticResource PayCard}, Dark={StaticResource SurfaceContainerLowDark}}" />
        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource PayInk}, Dark={StaticResource OutlineVariantDark}}" />
        <Setter Property="StrokeThickness" Value="1.5" />
        <Setter Property="StrokeShape">
            <Setter.Value>
                <RoundRectangle CornerRadius="24" />
            </Setter.Value>
        </Setter>
        <Setter Property="Padding" Value="16"/>
    </Style>

    <Style TargetType="Border" x:Key="GoalCardFrameStyle">
        <Setter Property="Background" Value="{AppThemeBinding Light={StaticResource PayCard}, Dark={StaticResource SurfaceContainerLowDark}}" />
        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource PayInk}, Dark={StaticResource OutlineVariantDark}}" />
        <Setter Property="StrokeThickness" Value="1.5" />
        <Setter Property="StrokeShape">
            <Setter.Value>
                <RoundRectangle CornerRadius="24" />
            </Setter.Value>
        </Setter>
        <Setter Property="Padding" Value="16"/>
    </Style>

    <Style TargetType="Border" x:Key="TransactionItemFrameStyle" BasedOn="{StaticResource PressableRowStyle}">
        <Setter Property="Background" Value="{AppThemeBinding Light={StaticResource PayCard}, Dark={StaticResource CardSurfaceDark}}" />
        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource PayCreamDeep}, Dark={StaticResource CardStrokeDark}}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="StrokeShape">
            <Setter.Value>
                <RoundRectangle CornerRadius="22" />
            </Setter.Value>
        </Setter>
        <Setter Property="Padding" Value="14,12"/>
    </Style>

    <Style TargetType="Border" x:Key="AccountItemFrameStyle" BasedOn="{StaticResource PressableRowStyle}">
        <Setter Property="Background" Value="{AppThemeBinding Light={StaticResource PayCard}, Dark={StaticResource CardSurfaceDark}}" />
        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource PayInk}, Dark={StaticResource CardStrokeDark}}" />
        <Setter Property="StrokeThickness" Value="1.5" />
        <Setter Property="StrokeShape">
            <Setter.Value>
                <RoundRectangle CornerRadius="24" />
            </Setter.Value>
        </Setter>
        <Setter Property="Padding" Value="16,14"/>
    </Style>

    <Style TargetType="Border" x:Key="CategoryItemFrameStyle" BasedOn="{StaticResource PressableRowStyle}">
        <Setter Property="Background" Value="{AppThemeBinding Light={StaticResource PayCard}, Dark={StaticResource CardSurfaceDark}}" />
        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource PayCreamDeep}, Dark={StaticResource CardStrokeDark}}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="StrokeShape">
            <Setter.Value>
                <RoundRectangle CornerRadius="22" />
            </Setter.Value>
        </Setter>
        <Setter Property="Padding" Value="14,12"/>
    </Style>

    <Style TargetType="Border" x:Key="TrendItemFrameStyle">
        <Setter Property="Background" Value="{AppThemeBinding Light={StaticResource PayCard}, Dark={StaticResource SurfaceContainerDark}}" />
        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource PayInk}, Dark={StaticResource OutlineVariantDark}}" />
        <Setter Property="StrokeThickness" Value="1.5" />
        <Setter Property="StrokeShape">
            <Setter.Value>
                <RoundRectangle CornerRadius="20" />
            </Setter.Value>
        </Setter>
        <Setter Property="Padding" Value="12"/>
    </Style>

    <Style TargetType="Border" x:Key="InsightCardFrameStyle">
        <Setter Property="Background" Value="{AppThemeBinding Light={StaticResource InfoContainer}, Dark={StaticResource InfoContainer}}" />
        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource PayInk}, Dark={StaticResource Info}}" />
        <Setter Property="StrokeThickness" Value="1.5" />
        <Setter Property="StrokeShape">
            <Setter.Value>
                <RoundRectangle CornerRadius="20" />
            </Setter.Value>
        </Setter>
        <Setter Property="Padding" Value="12"/>
    </Style>

    <Style TargetType="Border" x:Key="AnomalyCardFrameStyle">
        <Setter Property="Background" Value="{AppThemeBinding Light={StaticResource ErrorContainer}, Dark={StaticResource ErrorContainer}}" />
        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource Error}, Dark={StaticResource Error}}" />
        <Setter Property="StrokeThickness" Value="1.5" />
        <Setter Property="StrokeShape">
            <Setter.Value>
                <RoundRectangle CornerRadius="20" />
            </Setter.Value>
        </Setter>
        <Setter Property="Padding" Value="12"/>
    </Style>

    <Style TargetType="Border" x:Key="BudgetItemFrameStyle">
        <Setter Property="Background" Value="{AppThemeBinding Light={StaticResource PayCard}, Dark={StaticResource SurfaceContainerDark}}" />
        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource PayCreamDeep}, Dark={StaticResource OutlineVariantDark}}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="StrokeShape">
            <Setter.Value>
                <RoundRectangle CornerRadius="20" />
