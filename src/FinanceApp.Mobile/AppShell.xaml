<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="FinanceApp.Mobile.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:FinanceApp.Mobile"
    xmlns:views="clr-namespace:FinanceApp.Mobile.Views"
    Title="FinanceApp"
    FlyoutBehavior="Disabled">

    <!-- Login Page (shown when not authenticated) -->
    <ShellContent Route="Login" ContentTemplate="{DataTemplate views:LoginPage}" />

    <!-- Main App (icon + tiny-label tab navigation, no top headers) -->
    <TabBar Route="Main" Shell.NavBarIsVisible="False">
        <Tab Title="Dashboard" Route="Dashboard" Icon="tab_home">
            <ShellContent Route="Dashboard" ContentTemplate="{DataTemplate views:DashboardPage}" />
        </Tab>

        <Tab Title="Transactions" Route="Transactions" Icon="tab_transactions">
            <ShellContent Route="Transactions" ContentTemplate="{DataTemplate views:TransactionsPage}" />
        </Tab>

        <Tab Title="Accounts" Route="Accounts" Icon="tab_accounts">
            <ShellContent Route="Accounts" ContentTemplate="{DataTemplate views:AccountsPage}" />
        </Tab>

        <Tab Title="Budgets" Route="Budgets" Icon="tab_budgets">
            <ShellContent Route="Budgets" ContentTemplate="{DataTemplate views:BudgetsPage}" />
        </Tab>

        <Tab Title="More" Route="More" Icon="tab_more">
            <ShellContent Route="MorePage" ContentTemplate="{DataTemplate views:MorePage}" />
        </Tab>
    </TabBar>

    <!-- Goals + Settings live outside the tab bar so all 5 tabs fit.
         They are pushed from the More sheet with a Shell back button. -->
    <ShellContent Route="Goals" ContentTemplate="{DataTemplate views:GoalsPage}" />
    <ShellContent Route="Settings" ContentTemplate="{DataTemplate views:SettingsPage}" />

    <!-- Modal Pages (pushed with a Shell back button) -->
    <ShellContent Route="AddTransaction" ContentTemplate="{DataTemplate views:AddTransactionPage}" Shell.NavBarIsVisible="True" />
    <ShellContent Route="AddTransactionSheet" ContentTemplate="{DataTemplate views:AddTransactionSheetPage}" />
    <ShellContent Route="EditTransaction" ContentTemplate="{DataTemplate views:AddTransactionPage}" Shell.NavBarIsVisible="True" />
    <ShellContent Route="AddAccount" ContentTemplate="{DataTemplate views:AddAccountPage}" Shell.NavBarIsVisible="True" />
    <ShellContent Route="EditAccount" ContentTemplate="{DataTemplate views:AddAccountPage}" Shell.NavBarIsVisible="True" />
    <ShellContent Route="AddCategory" ContentTemplate="{DataTemplate views:AddCategoryPage}" Shell.NavBarIsVisible="True" />
    <ShellContent Route="EditCategory" ContentTemplate="{DataTemplate views:AddCategoryPage}" Shell.NavBarIsVisible="True" />
    <ShellContent Route="AddBudget" ContentTemplate="{DataTemplate views:AddBudgetPage}" Shell.NavBarIsVisible="True" />
    <ShellContent Route="EditBudget" ContentTemplate="{DataTemplate views:AddBudgetPage}" Shell.NavBarIsVisible="True" />
    <ShellContent Route="AddGoal" ContentTemplate="{DataTemplate views:AddGoalPage}" />
    <ShellContent Route="EditGoal" ContentTemplate="{DataTemplate views:AddGoalPage}" />

</Shell>