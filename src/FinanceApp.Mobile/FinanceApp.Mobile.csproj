<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net10.0-android</TargetFrameworks>
		<TargetFrameworks Condition="!$([MSBuild]::IsOSPlatform('linux'))">$(TargetFrameworks);net10.0-ios;net10.0-maccatalyst</TargetFrameworks>
		<TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);net10.0-windows10.0.19041.0</TargetFrameworks>

		<!-- Note for MacCatalyst:
		The default runtime is maccatalyst-x64, except in Release config, in which case the default is maccatalyst-x64;maccatalyst-arm64.
		When specifying both architectures, use the plural <RuntimeIdentifiers> instead of the singular <RuntimeIdentifier>.
		The Mac App Store will NOT accept apps with ONLY maccatalyst-arm64 indicated;
		either BOTH runtimes must be indicated or ONLY macatalyst-x64. -->
		<!-- For example: <RuntimeIdentifiers>maccatalyst-x64;maccatalyst-arm64</RuntimeIdentifiers> -->

		<OutputType>Exe</OutputType>
		<RootNamespace>FinanceApp.Mobile</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>

		<!-- Display name -->
		<ApplicationTitle>Finora</ApplicationTitle>

		<!-- App Identifier -->
		<ApplicationId>com.financeapp.mobile</ApplicationId>

		<!-- Versions -->
		<ApplicationDisplayVersion>1.0.0</ApplicationDisplayVersion>
		<ApplicationVersion>1</ApplicationVersion>

		<!-- To develop, package, and publish an app to the Microsoft Store, see: https://aka.ms/MauiTemplateUnpackaged -->
		<WindowsPackageType>MSIX</WindowsPackageType>

		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">15.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">21.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
		<TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)' == 'Release'">
		<!-- Enable trimming for smaller app size -->
		<PublishTrimmed>true</PublishTrimmed>
		<TrimMode>partial</TrimMode>
		<SuppressTrimAnalysisWarnings>true</SuppressTrimAnalysisWarnings>
		
		<!-- Full AOT disabled: prime suspect for release-only startup crashes
		     (EF Core expression compilation, JSON serializers and validators
		     do not survive aggressive ahead-of-time compilation on device).
		     Re-enable only after a clean Release test pass. -->
		<RunAOTCompilation Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">false</RunAOTCompilation>
		<RunAOTCompilation Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">false</RunAOTCompilation>
		
		<!-- Enable XAML compilation for Release -->
		<XamlCompilation>Compile</XamlCompilation>
		
		<!-- Disable debug symbols in Release -->
		<DebugType>none</DebugType>
		<DebugSymbols>false</DebugSymbols>
		
		<!-- Optimize for size -->
		<Optimize>true</Optimize>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)' == 'Debug'">
		<!-- Use runtime inflation for faster debug builds -->
		<XamlCompilation>Skip</XamlCompilation>
	</PropertyGroup>

	<!-- Android Debug defaults EmbedAssembliesIntoApk to False, which enables Fast
	     Deployment: assemblies are stripped out of the APK and pushed to the device
	     at launch. That loses their embedded resources, so every page fails at
	     runtime with "No embeddedresource found for FinanceApp.Mobile.App". Force the
	     assemblies (and their embedded XAML) into the APK instead. The cost is a
	     larger, slower-to-deploy APK, which is the right trade for Debug. -->
	<PropertyGroup Condition="'$(Configuration)' == 'Debug' And '$([MSBuild]::GetTargetPlatformIdentifier($(TargetFramework)))' == 'android'">
		<EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>
	</PropertyGroup>

	<!-- Android Release signing.

	     Credentials come from environment variables (FinoraKeyStorePath, FinoraKeyAlias,
	     FinoraKeyStorePassword, FinoraKeyPassword) so the keystore and its passwords
	     never enter the repository. If they are absent, the build fails below instead
	     of falling back to the shared debug key, which would produce an APK that can
	     never be updated by a properly signed release.

	     Losing this key means no later Finora APK can update an installed Finora, so
	     back the keystore up somewhere safe before the first release. -->
	<PropertyGroup Condition="'$(Configuration)' == 'Release' And '$([MSBuild]::GetTargetPlatformIdentifier($(TargetFramework)))' == 'android'">
		<AndroidKeyStore>true</AndroidKeyStore>
		<AndroidSigningKeyStore>$(FinoraKeyStorePath)</AndroidSigningKeyStore>
		<AndroidSigningStorePass>$(FinoraKeyStorePassword)</AndroidSigningStorePass>
		<AndroidSigningKeyAlias>$(FinoraKeyAlias)</AndroidSigningKeyAlias>
		<AndroidSigningKeyPass>$(FinoraKeyPassword)</AndroidSigningKeyPass>
	</PropertyGroup>

	<Target Name="RequireFinoraReleaseSigningCredentials"
					BeforeTargets="Build;Publish"
					Condition="'$(Configuration)' == 'Release' And '$([MSBuild]::GetTargetPlatformIdentifier($(TargetFramework)))' == 'android'">
		<Error Condition="'$(FinoraKeyStorePath)' == '' Or '$(FinoraKeyAlias)' == '' Or '$(FinoraKeyStorePassword)' == '' Or '$(FinoraKeyPassword)' == ''"
					   Text="Release Android builds must be signed with the production key. Set the environment variables FinoraKeyStorePath, FinoraKeyAlias, FinoraKeyStorePassword and FinoraKeyPassword (see README, 'Android release signing') and rebuild." />
		<Error Condition="!Exists('$(FinoraKeyStorePath)')"
					   Text="The keystore '$(FinoraKeyStorePath)' does not exist. Restore the production keystore for this repository." />
	</Target>

	<!-- The Android SDK falls back to the shared debug key unless AndroidKeyStore is
	     exactly 'True', and it does so without a warning. Catch that here rather than
	     shipping an APK signed by a key that no user will ever be able to update from. -->
	<Target Name="RejectDebugKeySignedAndroidRelease"
					AfterTargets="_ResolveAndroidSigningKey"
					Condition="'$(Configuration)' == 'Release' And '$([MSBuild]::GetTargetPlatformIdentifier($(TargetFramework)))' == 'android'">
		<Error Condition="'$(_ApkDebugKeyStore)' != '' And '$(_ApkKeyStore)' == '$(_ApkDebugKeyStore)'"
					   Text="This Release Android build resolved to the shared Android debug keystore instead of the Finora production key. Check the AndroidKeyStore/AndroidSigning* properties in FinanceApp.Mobile.csproj." />
	</Target>

	<ItemGroup>
		<!-- App Icon: lime tile with the growth curve cut out of it, on ink -->
		<MauiIcon Include="Resources\AppIcon\finora_fg.svg" Color="#161B16" />

		<!-- Splash Screen: same mark, ink background (was an off-palette green) -->
		<MauiSplashScreen Include="Resources\Splash\finora_splash.svg" Color="#161B16" BaseSize="128,128" />

		<!-- Images -->
		<MauiImage Include="Resources\Images\*" />
		<MauiImage Update="Resources\Images\dotnet_bot.png" Resize="True" BaseSize="300,185" />
		
		<!-- Custom Fonts -->
		<MauiFont Include="Resources\Fonts\*" />

		<!-- Raw Assets (also remove the "Resources\Raw" prefix) -->
		<MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.0" />
		<PackageReference Include="CommunityToolkit.Mvvm" Version="8.2.2" />
		<PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.0" />
		<PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.0" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\FinanceApp.Application\FinanceApp.Application.csproj" />
		<ProjectReference Include="..\FinanceApp.Domain\FinanceApp.Domain.csproj" />
		<ProjectReference Include="..\FinanceApp.Infrastructure\FinanceApp.Infrastructure.csproj" />
	</ItemGroup>

	<ItemGroup>
		<MauiAsset Include="appsettings.json" />
	</ItemGroup>

</Project>