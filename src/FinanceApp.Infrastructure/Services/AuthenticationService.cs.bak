namespace FinanceApp.Infrastructure.Services;

using FinanceApp.Application.Interfaces;
using FinanceApp.Infrastructure.Configuration;
using Microsoft.Extensions.Options;
using SupabaseClient = global::Supabase.Client;
using SupabaseOptions = global::Supabase.SupabaseOptions;
using Session = global::Supabase.Gotrue.Session;
using User = global::Supabase.Gotrue.User;
using AuthState = global::Supabase.Gotrue.Constants.AuthState;
using System.Text.Json;

public class AuthenticationService : IAuthenticationService
{
    private readonly SupabaseClient _supabaseClient;
    private readonly DatabaseOptions _options;
    private readonly JsonSerializerOptions _jsonOptions;
    private Session? _currentSession;

    public event Action<AuthStateChangedEventArgs>? AuthStateChanged;

    public AuthenticationService(IOptions<DatabaseOptions> options)
    {
        _options = options.Value;
        _jsonOptions = new JsonSerializerOptions { PropertyNamingPolicy = JsonNamingPolicy.CamelCase };

        var supabaseOptions = new SupabaseOptions
        {
            AutoConnectRealtime = false,
            AutoRefreshToken = true
        };

        _supabaseClient = new SupabaseClient(_options.SupabaseUrl, _options.SupabaseAnonKey, supabaseOptions);
    }

    public async Task InitializeAsync(CancellationToken cancellationToken = default)
    {
        await _supabaseClient.InitializeAsync(cancellationToken);
        _supabaseClient.Auth.OnAuthStateChange += OnAuthStateChanged;
    }

    private void OnAuthStateChanged(object? sender, AuthState state)
    {
        var isAuthenticated = _supabaseClient.Auth.CurrentUser != null;
        var userId = _supabaseClient.Auth.CurrentUser?.Id != null ? Guid.Parse(_supabaseClient.Auth.CurrentUser.Id) : null;
        var email = _supabaseClient.Auth.CurrentUser?.Email;

        AuthStateChanged?.Invoke(new AuthStateChangedEventArgs(isAuthenticated, userId, email));
    }

    public async Task<AuthResultDto> RegisterAsync(string email, string password, CancellationToken cancellationToken = default)
    {
        try
        {
            var response = await _supabaseClient.Auth.SignUp(email, password, cancellationToken: cancellationToken);

            if (response.User != null)
            {
                _currentSession = response.Session;
                return new AuthResultDto(
                    true,
                    null,
                    Guid.Parse(response.User.Id),
                    response.User.Email,
                    response.Session?.AccessToken,
                    response.Session?.RefreshToken);
            }

            return new AuthResultDto(false, "Registration failed", null, null, null, null);
        }
        catch (Exception ex)
        {
            return new AuthResultDto(false, ex.Message, null, null, null, null);
        }
    }

    public async Task<AuthResultDto> LoginAsync(string email, string password, CancellationToken cancellationToken = default)
    {
        try
        {
            var response = await _supabaseClient.Auth.SignInWithPassword(email, password, cancellationToken);

            if (response.User != null)
            {
                _currentSession = response.Session;
                return new AuthResultDto(
                    true,
                    null,
                    Guid.Parse(response.User.Id),
                    response.User.Email,
                    response.Session?.AccessToken,
                    response.Session?.RefreshToken);
            }

            return new AuthResultDto(false, "Invalid credentials", null, null, null, null);
        }
        catch (Exception ex)
        {
            return new AuthResultDto(false, ex.Message, null, null, null, null);
        }
    }

    public async Task LogoutAsync(CancellationToken cancellationToken = default)
    {
        await _supabaseClient.Auth.SignOut(cancellationToken);
        _currentSession = null;
    }

    public async Task<AuthResultDto> RefreshSessionAsync(CancellationToken cancellationToken = default)
    {
        try
        {
            if (_currentSession?.RefreshToken == null)
                return new AuthResultDto(false, "No refresh token available", null, null, null, null);

            var response = await _supabaseClient.Auth.RefreshSession(_currentSession.RefreshToken, cancellationToken);

            if (response.Session != null)
            {
                _currentSession = response.Session;
                return new AuthResultDto(
                    true,
                    null,
                    Guid.Parse(response.User!.Id),
                    response.User.Email,
                    response.Session.AccessToken,
                    response.Session.RefreshToken);
            }

            return new AuthResultDto(false, "Failed to refresh session", null, null, null, null);
        }
        catch (Exception ex)
        {
            return new AuthResultDto(false, ex.Message, null, null, null, null);
        }
    }

    public async Task<bool> IsAuthenticatedAsync(CancellationToken cancellationToken = default)
    {
        return _supabaseClient.Auth.CurrentUser != null;
    }

    public async Task<Guid?> GetCurrentUserIdAsync(CancellationToken cancellationToken = default)
    {
        var user = _supabaseClient.Auth.CurrentUser;
        return user?.Id != null ? Guid.Parse(user.Id) : null;
    }

    public async Task<string?> GetCurrentUserEmailAsync(CancellationToken cancellationToken = default)
    {
        return _supabaseClient.Auth.CurrentUser?.Email;
    }
}