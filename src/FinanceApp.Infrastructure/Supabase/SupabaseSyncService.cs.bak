namespace FinanceApp.Infrastructure.Supabase;

using FinanceApp.Application.Interfaces;
using FinanceApp.Domain.Entities;
using FinanceApp.Domain.Enums;
using FinanceApp.Infrastructure.Configuration;
using Microsoft.Extensions.Options;
using SupabaseClient = global::Supabase.Client;
using SupabaseOptions = global::Supabase.SupabaseOptions;
using SupabaseGotrue = global::Supabase.Gotrue;
using System.Text.Json;

public class SupabaseSyncService : ISupabaseSyncService
{
    private readonly SupabaseClient _supabaseClient;
    private readonly DatabaseOptions _options;
    private readonly JsonSerializerOptions _jsonOptions;

    public SupabaseSyncService(IOptions<DatabaseOptions> options)
    {
        _options = options.Value;
        _jsonOptions = new JsonSerializerOptions { PropertyNamingPolicy = JsonNamingPolicy.CamelCase };

        var supabaseOptions = new SupabaseOptions
        {
            AutoConnectRealtime = false,
            AutoRefreshToken = true
        };

        _supabaseClient = new SupabaseClient(_options.SupabaseUrl, _options.SupabaseAnonKey, supabaseOptions);
    }

    public async Task InitializeAsync(CancellationToken cancellationToken = default)
    {
        await _supabaseClient.InitializeAsync(cancellationToken);
    }

    public async Task SyncAccountAsync(Account entity, SyncOperationType operationType, CancellationToken cancellationToken = default)
    {
        var dto = new SupabaseAccountDto
        {
            Id = entity.Id,
            UserId = entity.UserId,
            Name = entity.Name,
            Type = (int)entity.Type,
            Balance = entity.Balance.Amount,
            Currency = entity.Balance.Currency,
            Description = entity.Description,
            Icon = entity.Icon,
            Color = entity.Color,
            IsDefault = entity.IsDefault,
            SortOrder = entity.SortOrder,
            CreatedAt = entity.CreatedAt,
            UpdatedAt = entity.UpdatedAt,
            IsDeleted = entity.IsDeleted,
            Version = entity.Version
        };

        switch (operationType)
        {
            case SyncOperationType.Create:
                await _supabaseClient.From<SupabaseAccountDto>().Insert(dto, cancellationToken);
                break;
            case SyncOperationType.Update:
                await _supabaseClient.From<SupabaseAccountDto>().Update(dto, cancellationToken);
                break;
            case SyncOperationType.Delete:
                await _supabaseClient.From<SupabaseAccountDto>().Delete(dto, cancellationToken);
                break;
        }
    }

    public async Task SyncCategoryAsync(Category entity, SyncOperationType operationType, CancellationToken cancellationToken = default)
    {
        var dto = new SupabaseCategoryDto
        {
            Id = entity.Id,
            UserId = entity.UserId,
            Name = entity.Name,
            Type = (int)entity.Type,
            Icon = entity.Icon,
            Color = entity.Color,
            ParentCategoryId = entity.ParentCategoryId,
            IsSystem = entity.IsSystem,
            SortOrder = entity.SortOrder,
            IsActive = entity.IsActive,
            CreatedAt = entity.CreatedAt,
            UpdatedAt = entity.UpdatedAt,
            IsDeleted = entity.IsDeleted,
            Version = entity.Version
        };

        switch (operationType)
        {
            case SyncOperationType.Create:
                await _supabaseClient.From<SupabaseCategoryDto>().Insert(dto, cancellationToken);
                break;
            case SyncOperationType.Update:
                await _supabaseClient.From<SupabaseCategoryDto>().Update(dto, cancellationToken);
                break;
            case SyncOperationType.Delete:
                await _supabaseClient.From<SupabaseCategoryDto>().Delete(dto, cancellationToken);
                break;
        }
    }

    public async Task SyncTransactionAsync(Transaction entity, SyncOperationType operationType, CancellationToken cancellationToken = default)
    {
        var dto = new SupabaseTransactionDto
        {
            Id = entity.Id,
            UserId = entity.UserId,
            Type = (int)entity.Type,
            Amount = entity.Amount.Amount,
            Currency = entity.Amount.Currency,
            Date = entity.Date,
            Notes = entity.Notes,
            AccountId = entity.AccountId.Value,
            CategoryId = entity.CategoryId.Value,
            RecurringTransactionId = entity.RecurringTransactionId,
            SyncStatus = (int)entity.SyncStatus,
            LastSyncedAt = entity.LastSyncedAt,
            CreatedAt = entity.CreatedAt,
            UpdatedAt = entity.UpdatedAt,
            IsDeleted = entity.IsDeleted,
            Version = entity.Version
        };

        switch (operationType)
        {
            case SyncOperationType.Create:
                await _supabaseClient.From<SupabaseTransactionDto>().Insert(dto, cancellationToken);
                break;
            case SyncOperationType.Update:
                await _supabaseClient.From<SupabaseTransactionDto>().Update(dto, cancellationToken);
                break;
            case SyncOperationType.Delete:
                await _supabaseClient.From<SupabaseTransactionDto>().Delete(dto, cancellationToken);
                break;
        }
    }

    public async Task SyncBudgetAsync(Budget entity, SyncOperationType operationType, CancellationToken cancellationToken = default)
    {
        var dto = new SupabaseBudgetDto
        {
            Id = entity.Id,
            UserId = entity.UserId,
            Name = entity.Name,
            Amount = entity.Amount.Amount,
            Currency = entity.Amount.Currency,
            SpentAmount = entity.SpentAmount.Amount,
            StartDate = entity.StartDate,
            EndDate = entity.EndDate,
            CategoryId = entity.CategoryId.Value,
            SyncStatus = (int)entity.SyncStatus,
            LastSyncedAt = entity.LastSyncedAt,
            CreatedAt = entity.CreatedAt,
            UpdatedAt = entity.UpdatedAt,
            IsDeleted = entity.IsDeleted,
            Version = entity.Version
        };

        switch (operationType)
        {
            case SyncOperationType.Create:
                await _supabaseClient.From<SupabaseBudgetDto>().Insert(dto, cancellationToken);
                break;
            case SyncOperationType.Update:
                await _supabaseClient.From<SupabaseBudgetDto>().Update(dto, cancellationToken);
                break;
            case SyncOperationType.Delete:
                await _supabaseClient.From<SupabaseBudgetDto>().Delete(dto, cancellationToken);
                break;
        }
    }

    public async Task SyncRecurringTransactionAsync(RecurringTransaction entity, SyncOperationType operationType, CancellationToken cancellationToken = default)
    {
        var dto = new SupabaseRecurringTransactionDto
        {
            Id = entity.Id,
            UserId = entity.UserId,
