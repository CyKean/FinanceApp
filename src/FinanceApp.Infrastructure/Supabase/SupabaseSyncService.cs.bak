        }
    }

    private record SupabaseAccountDto
    {
        public Guid Id { get; init; }
        public Guid UserId { get; init; }
        public string Name { get; init; } = "";
        public int Type { get; init; }
        public decimal Balance { get; init; }
        public string Currency { get; init; } = "PHP";
        public string? Description { get; init; }
        public string? Icon { get; init; }
        public string? Color { get; init; }
        public bool IsDefault { get; init; }
        public int SortOrder { get; init; }
        public DateTime CreatedAt { get; init; }
        public DateTime UpdatedAt { get; init; }
        public bool IsDeleted { get; init; }
        public int Version { get; init; }
    }

    private record SupabaseCategoryDto
    {
        public Guid Id { get; init; }
        public Guid UserId { get; init; }
        public string Name { get; init; } = "";
        public int Type { get; init; }
        public string? Icon { get; init; }
        public string? Color { get; init; }
        public Guid? ParentCategoryId { get; init; }
        public bool IsSystem { get; init; }
        public int SortOrder { get; init; }
        public bool IsActive { get; init; }
        public DateTime CreatedAt { get; init; }
        public DateTime UpdatedAt { get; init; }
        public bool IsDeleted { get; init; }
        public int Version { get; init; }
    }

    private record SupabaseTransactionDto
    {
        public Guid Id { get; init; }
        public Guid UserId { get; init; }
        public int Type { get; init; }
        public decimal Amount { get; init; }
        public string Currency { get; init; } = "PHP";
        public DateTime Date { get; init; }
        public string? Notes { get; init; }
        public Guid AccountId { get; init; }
        public Guid CategoryId { get; init; }
        public Guid? RecurringTransactionId { get; init; }
        public int SyncStatus { get; init; }
        public DateTime? LastSyncedAt { get; init; }
        public DateTime CreatedAt { get; init; }
        public DateTime UpdatedAt { get; init; }
        public bool IsDeleted { get; init; }
        public int Version { get; init; }
    }

    private record SupabaseBudgetDto
    {
        public Guid Id { get; init; }
        public Guid UserId { get; init; }
        public string Name { get; init; } = "";
        public decimal Amount { get; init; }
        public string Currency { get; init; } = "PHP";
        public decimal SpentAmount { get; init; }
        public DateTime StartDate { get; init; }
        public DateTime EndDate { get; init; }
        public Guid CategoryId { get; init; }
        public int SyncStatus { get; init; }
